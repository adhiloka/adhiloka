---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import Interlude from '../../components/Interlude.astro';
import { SUSTAINABILITY_INTRO, SUSTAINABILITY_HERO, SUSTAINABILITY_SLIDES } from '../../data/pages/sustainability';
---

{/* Tiga section: 1 hero foto penuh layar, 2 karusel pintu ke halaman anak +
    jeda penutup, 3 footer — susunan yang sama dengan halaman hub About.

    BaseLayout langsung, bukan PageLayout: yang disumbang PageLayout hanya kepala
    halaman dan bilah saudara, dan keduanya sudah digantikan hero dan karusel. */}
<BaseLayout
  title={SUSTAINABILITY_INTRO.metaTitle ?? SUSTAINABILITY_INTRO.title}
  description={SUSTAINABILITY_INTRO.description}
  headerVariant="over-dark"
>
  <Hero slides={SUSTAINABILITY_HERO} label="Sustainability" />

  <section class="hub-tour">
    <GetInTouch slides={SUSTAINABILITY_SLIDES} label="Sustainability" inset />

    <div class="hub-tour__note">
      <Interlude
        class="frame"
        line="A benzoin tree is tapped, not felled."
        href="/about/our-purpose/"
        italic
        tight
      />
    </div>
  </section>
</BaseLayout>
