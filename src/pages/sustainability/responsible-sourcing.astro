---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import Passages from '../../components/blocks/Passages.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { SOURCING_INTRO, SOURCING_CHAIN, SOURCING_PASSAGES } from '../../data/pages/sustainability';
---

<PageLayout intro={SOURCING_INTRO}>
  <Intro title="Deserunt, quo consequuntur" paragraphs={[SOURCING_INTRO.lede]} />
  <InfoGrid
    id="chain"
    title="From Garden to Drum"
    items={SOURCING_CHAIN.map((s) => ({ n: s.n, title: s.title, body: s.body }))}
    cols={3}
    grey
  />
  <Passages passages={SOURCING_PASSAGES} />
  <SiblingCards />
</PageLayout>
