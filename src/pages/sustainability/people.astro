---
import PageLayout from '../../layouts/PageLayout.astro';
import Passages from '../../components/blocks/Passages.astro';
import QuoteSplit from '../../components/QuoteSplit.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { PEOPLE_INTRO, PEOPLE_PASSAGES, PEOPLE_QUOTE } from '../../data/pages/sustainability';
---

<PageLayout intro={PEOPLE_INTRO}>
  <Passages passages={PEOPLE_PASSAGES} />
  <QuoteSplit text={PEOPLE_QUOTE.text} name={PEOPLE_QUOTE.attribution} role="Our Commitment" image="agroforest-canopy" alt="Tree canopy seen from below" />
  <SiblingCards />
</PageLayout>
