---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import Pullquote from '../../components/Pullquote.astro';
import Interlude from '../../components/Interlude.astro';
import { PEOPLE_INTRO, PEOPLE_PASSAGES, PEOPLE_QUOTE } from '../../data/pages/sustainability';
import { groundAt, bridgeAfter } from '../../data/ground';
---

<PageLayout intro={PEOPLE_INTRO} section="/sustainability/">
  {
    PEOPLE_PASSAGES.slice(0, 2).map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        reverse={i % 2 === 1}
        ground={groundAt(i)}
      />
    ))
  }

  <Pullquote quote={PEOPLE_QUOTE} />

  {
    PEOPLE_PASSAGES.slice(2).map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        ground={groundAt(i, 3)}
      />
    ))
  }

  <section class="bridge" style={`--bridge-bg:${bridgeAfter(groundAt(PEOPLE_PASSAGES.slice(2).length - 1, 3))}`}>
    <Interlude
      class="frame"
      line="How the same discipline shows up in the supply chain."
      href="/sustainability/responsible-sourcing/"
      cta="Responsible sourcing"
      italic
    />
  </section>
</PageLayout>

<style>
  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
