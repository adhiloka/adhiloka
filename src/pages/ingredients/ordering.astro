---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import {
  ORDERING_INTRO,
  ORDERING_STEPS,
  ORDERING_DOCUMENTS_LEAD,
  ORDERING_DOCUMENTS,
  ORDERING_LOGISTICS,
  ORDERING_FAQ,
  ORDERING_CLOSING,
} from '../../data/pages/ingredients';

/* Ordering & Documents (arah konten B2B, 2 Okt 2026): alur dari permintaan
 * sampai pengiriman, dokumen, logistik dan tanya-jawab. Langkah dan logistik
 * memakai InfoGrid seperti rantai Responsible Sourcing; daftar dokumen dan
 * FAQ ditulis di sini. Matriks dokumen per bahan (centang "tersedia") dilepas
 * 10 Nov 2026: status dokumen belum pasti, jadi halaman ini hanya menyebut
 * jenis dokumennya dan mengarahkan ke formulir kontak. */
---

<PageLayout intro={ORDERING_INTRO}>
  <Intro title="How to Order" paragraphs={[ORDERING_INTRO.lede]} />

  <InfoGrid id="steps" title="From Enquiry to Shipment" items={ORDERING_STEPS} cols={3} grey />

  <section class="sec" id="documents">
    <div class="wrap ord__docs">
      <div>
        <h2 class="h2" data-anim="title">Documents</h2>
        <p class="lead ord__docs-lead">{ORDERING_DOCUMENTS_LEAD}</p>
        <a class="btn" href="/contact/?kind=specification"><span class="btn__label">Request Documents</span></a>
      </div>
      <ul class="ord__doclist" data-anim="columns">
        {
          ORDERING_DOCUMENTS.map((d) => (
            <li data-anim-item>
              <svg viewBox="0 0 20 24" width="18" height="22" aria-hidden="true"><path d="M3 1.5h9.5L17 6v16.5H3zM12.5 1.5V6H17M6.5 12h7M6.5 16h7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
              {d}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <InfoGrid id="logistics" title="Logistics" items={ORDERING_LOGISTICS} grey />

  <section class="sec" id="faq">
    <div class="wrap">
      <h2 class="h2" data-anim="title">Frequently Asked Questions</h2>
      <div class="ord__faq">
        {
          ORDERING_FAQ.map((f) => (
            <details class="ord__q">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="ord__close">
        <p class="lead">{ORDERING_CLOSING}</p>
        <p class="ord__btns">
          <a class="btn" href="/contact/?kind=sample"><span class="btn__label">Request a Sample</span></a>
          <a class="btn" href="/ingredients/catalog/"><span class="btn__label">Ingredients Catalog</span></a>
        </p>
      </div>
    </div>
  </section>

  <SiblingCards />
</PageLayout>

<style>
  .ord__docs {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px 8%;
    align-items: start;
  }
  .ord__docs-lead { margin: 24px 0 36px; }
  .ord__doclist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 32px;
    border-top: 1px solid var(--line);
  }
  .ord__doclist li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-size: calc(17px * var(--fs));
    font-weight: 440;
    color: var(--ink);
  }
  .ord__doclist svg { flex: none; color: var(--brand-green); }
  @media (max-width: 1026px) {
    .ord__docs { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .ord__doclist { grid-template-columns: 1fr; }
  }

  .ord__faq {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .ord__q { border-bottom: 1px solid var(--line); }
  .ord__q summary {
    position: relative;
    padding: 22px 48px 22px 0;
    list-style: none;
    cursor: pointer;
    font-size: calc(clamp(18px, 1.39vw, 20px) * var(--fs));
    font-weight: 530;
    color: var(--ink);
  }
  .ord__q summary::-webkit-details-marker { display: none; }
  .ord__q summary::after {
    content: '+';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: calc(28px * var(--fs));
    font-weight: 300;
    line-height: 1;
  }
  .ord__q[open] summary::after { content: '\2212'; }
  .ord__q p {
    max-width: 900px;
    padding-bottom: 24px;
    font-size: calc(16px * var(--fs));
    line-height: 1.6;
    color: var(--ink);
  }

  .ord__close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    margin-top: 56px;
  }
  .ord__close .lead { max-width: 640px; }
  .ord__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
