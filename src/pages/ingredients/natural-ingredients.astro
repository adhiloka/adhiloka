---
import PageLayout from '../../layouts/PageLayout.astro';
import CardSlider from '../../components/blocks/CardSlider.astro';
import PromoBanner from '../../components/blocks/PromoBanner.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { MATERIALS, FAMILY_FILTERS } from '../../data/materials';
import {
  NATURAL_INTRO,
  NATURAL_CATALOG,
  INGREDIENTS_COLLECTIONS_BODY,
} from '../../data/pages/ingredients';

/* Natural Ingredients (13 Nov 2026), pola halaman "Natural ingredients"
 * Givaudan, tanpa blok pembuka (aturan halaman anak): Collections (satu kartu per keluarga, menuju
 * katalog tersaring lewat ?family=; dipindah dari hub), pita menuju katalog,
 * lalu Explore More. Nama produk tidak didaftar di sini: daftar lengkapnya
 * hanya di katalog. */
const collections = FAMILY_FILTERS.filter((f) => f.value !== 'All')
  .map((f) => {
    const items = MATERIALS.filter((m) => m.family === f.value);
    const lead = items.find((m) => m.image) ?? items[0];
    return {
      href: `/ingredients/catalog/?family=${f.value}`,
      title: f.label,
      body: INGREDIENTS_COLLECTIONS_BODY[f.value],
      image: lead?.image,
      shot: lead?.shot,
      tag: `${items.length} ${items.length === 1 ? 'ingredient' : 'ingredients'}`,
      n: items.length,
    };
  })
  .filter((c) => c.n > 0);
---

<PageLayout intro={NATURAL_INTRO}>
  <CardSlider title="Collections" viewAll="/ingredients/catalog/" items={collections} />
  <PromoBanner
    title={NATURAL_CATALOG.title}
    text={NATURAL_CATALOG.text}
    cta={NATURAL_CATALOG.cta}
    href="/ingredients/catalog/"
    image="spices-spoons"
    grey
  />
  <SiblingCards />
</PageLayout>
