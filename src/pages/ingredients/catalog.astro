---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { MATERIALS, FAMILY_FILTERS } from '../../data/materials';
import { getImageFor } from '../../data/images';
import { CATALOG_INTRO, CATALOG_NOTE } from '../../data/pages/ingredients';
---

<PageLayout intro={CATALOG_INTRO} section="/ingredients/" media={false}>
  <div class="frame catalogue__note">
    <p>{CATALOG_NOTE}</p>
  </div>

  <!-- Penyaring lengket -->
  <div class="filters" data-filters>
    <div class="frame filters__inner">
      <span class="filters__label" id="filter-label">Filter</span>
      <div class="filters__set" role="group" aria-labelledby="filter-label">
        {
          FAMILY_FILTERS.map((f, i) => (
            <button
              type="button"
              data-family={f.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))
        }
      </div>
      <span class="filters__count" role="status" aria-live="polite" data-count>
        {MATERIALS.length} materials
      </span>
    </div>
  </div>

  <!-- Katalog -->
  <section class="section catalogue">
    <ul class="frame catalogue__grid" data-grid>
      {
        MATERIALS.map((m) => {
          const img = getImageFor(m.image);
          return (
            <li id={m.slug} class="mcard" data-family={m.family}>
              <a href={`#${m.slug}`} data-open={m.slug}>
                <span class="mcard__plate plate">
                  {img ? (
                    <>
                      <Image
                        src={img}
                        alt=""
                        width={620}
                        widths={[280, 440, 620]}
                        sizes="(max-width: 599px) 46vw, (max-width: 1100px) 30vw, 15vw"
                        loading="lazy"
                        decoding="async"
                        quality={72}
                      />
                      <span class="mcard__veil" aria-hidden="true" />
                    </>
                  ) : (
                    <span class="plate__caption">{m.shot}</span>
                  )}
                  <span class:list={['mcard__family', img && 'mcard__family--on-photo']}>
                    {m.family}
                  </span>
                </span>

                <span class="mcard__meta">
                  <span class="mcard__name">{m.name}</span>
                  <span class="mcard__latin">{m.latin}</span>
                  <span class="mcard__origin">{m.origin}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="catalogue__empty" data-empty hidden>
      No material in that family yet. <button type="button" data-reset>Show all eighteen</button>
    </p>
  </section>

  <!-- Laci spesifikasi. Semua panel ada di HTML: dapat dibaca mesin telusur,
       dan tetap terbaca jika JavaScript gagal dimuat. -->
  <div class="mdrawer" data-drawer hidden>
    <div class="mdrawer__scrim" data-drawer-close></div>

    <aside class="mdrawer__panel" data-lenis-prevent role="dialog" aria-modal="true" aria-label="Material specification">
      <button type="button" class="mdrawer__close" data-drawer-close>
        <span aria-hidden="true">&#10005;</span>&nbsp;&nbsp;Close
      </button>

      {
        MATERIALS.map((m) => {
          const img = getImageFor(m.image);
          return (
            <article data-material={m.slug} hidden>
              <div class="mdrawer__plate plate">
                {img ? (
                  <Image
                    src={img}
                    alt={m.shot}
                    width={900}
                    widths={[480, 900]}
                    sizes="(max-width: 899px) 100vw, 560px"
                    loading="lazy"
                    decoding="async"
                    quality={74}
                  />
                ) : (
                  <span class="plate__caption">{m.shot}</span>
                )}
              </div>

              <span class="mdrawer__family">{m.family}</span>
              <h2 class="mdrawer__name">{m.name}</h2>
              <p class="mdrawer__latin">{m.latin}</p>
              <p class="mdrawer__note">{m.note}</p>

              <dl class="spec">
                <div><dt>Origin</dt><dd>{m.origin}</dd></div>
                <div><dt>Extraction</dt><dd>{m.method}</dd></div>
                <div><dt>Harvest</dt><dd>{m.harvest}</dd></div>
                <div><dt>Applications</dt><dd>{m.uses}</dd></div>
              </dl>

              <a class="btn-solid mdrawer__cta" href={`/contact/?material=${m.slug}`}>
                Request a sample <span aria-hidden="true">&#8594;</span>
              </a>
            </article>
          );
        })
      }
    </aside>
  </div>
</PageLayout>

<script>
  import { initMaterials } from '../../scripts/materials';
  document.addEventListener('astro:page-load', initMaterials);
</script>

<style>
  /* Catatan musim duduk di antara kepala halaman dan penyaring lengket. */
  .catalogue__note {
    padding: 0 var(--gutter) clamp(26px, 3vw, 40px);
  }
  /* Lebar baca dibatasi di anaknya, bukan di .frame: .frame memakai
     margin-inline auto, jadi mengecilkan max-width-nya membuat blok ini
     ter-center alih-alih rata kiri. */
  .catalogue__note p {
    max-width: var(--measure-body);
    font-size: var(--type-ui);
    line-height: var(--leading-body);
    color: var(--ink-muted);
  }

  /* ── Penyaring ─────────────────────────────────────────────────────── */
  .filters {
    position: sticky;
    top: calc(var(--header-h) + 1px);
    z-index: 100;
    background: rgb(255 255 255 / 0.94);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    padding-inline: var(--gutter);
  }
  .filters__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(13px, 2vw, 30px);
    padding-block: 15px;
  }
  .filters__label {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-label);
  }
  .filters__set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  /* Saringan sebagai pil ala Vale: garis teal, yang aktif terisi teal. Opacity
     lama dilepas: abu yang dipudarkan jatuh di bawah 4,5:1. */
  .filters__set button {
    font-size: 15px;
    font-weight: 500;
    padding: 6px 16px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-pill);
    color: var(--teal);
    transition: background 150ms ease-in-out, color 150ms ease-in-out, box-shadow 150ms ease-in-out;
  }
  .filters__set button:hover { box-shadow: 0 0 6px rgb(0 126 122 / 0.4); }
  .filters__set button[aria-pressed='true'] { background: var(--teal); color: var(--paper); }
  .filters__count {
    margin-left: auto;
    font-size: 13.5px;
    white-space: nowrap;
    color: var(--text-label);
  }

  /* ── Katalog ───────────────────────────────────────────────────────── */
  .catalogue { padding-block: clamp(32px, 5vw, 80px) var(--section-y-lg); }
  .catalogue__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: var(--grid-gap);
  }
  .mcard[hidden] { display: none; }
  .mcard > a {
    display: flex;
    flex-direction: column;
    gap: 15px;
    transition: transform var(--dur-slower) var(--ease-glide);
  }
  .mcard > a:hover,
  .mcard > a:focus-visible { transform: translateY(-9px); color: inherit; }

  .mcard__plate { display: block; aspect-ratio: 1 / 1; }
  .mcard__plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mcard__veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    background: linear-gradient(to bottom, rgb(var(--shade-rgb) / 0.42), transparent);
  }
  .mcard__family {
    position: absolute;
    right: 12px;
    top: 11px;
    font-size: 14px;
    font-weight: 400;
    color: var(--text-caption);
  }
  /* Label putih duduk di atas foto yang terangnya tak bisa ditebak, jadi
     bayangan tipis dipakai — perangkat yang sama seperti teks di hero. */
  .mcard__family--on-photo {
    font-weight: 500;
    color: oklch(1 0 0);
    text-shadow: 0 1px 8px rgb(var(--shade-rgb) / 0.75);
  }

  .mcard__meta { display: flex; flex-direction: column; gap: 6px; }
  .mcard__name {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.5vw, 25px);
    line-height: 1.16;
    color: var(--teal);
    font-weight: 500;
  }
  .mcard__latin { font-size: 14px; font-style: italic; color: var(--text-caption); }
  .mcard__origin {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 400;
    color: var(--text-label);
  }

  .catalogue__empty {
    max-width: var(--measure-max);
    margin: 40px auto 0;
    padding-inline: var(--gutter);
    font-size: 15px;
    color: var(--text-body);
  }
  .catalogue__empty button { border-bottom: 1px solid currentColor; }

  /* ── Laci ──────────────────────────────────────────────────────────── */
  .mdrawer { position: fixed; inset: 0; z-index: 160; }
  .mdrawer[hidden] { display: none; }

  .mdrawer__scrim {
    position: absolute;
    inset: 0;
    background: rgb(var(--shade-rgb) / 0.5);
    opacity: 0;
    transition: opacity 480ms ease;
  }
  .mdrawer.is-open .mdrawer__scrim { opacity: 1; }

  .mdrawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(600px, 100%);
    background: var(--ivory-1);
    overflow-y: auto;
    padding: clamp(22px, 4vw, 52px);
    box-shadow: var(--shadow-drawer);
    transform: translateX(100%);
    transition: transform 640ms var(--ease-glide);
  }
  .mdrawer.is-open .mdrawer__panel { transform: none; }

  .mdrawer__panel article[hidden] { display: none; }

  .mdrawer__close {
    margin-bottom: clamp(22px, 3vw, 40px);
    font-size: 14px;
    color: var(--text-caption);
    font-weight: 500;
  }

  .mdrawer__plate {
    aspect-ratio: 16 / 10;
    margin-bottom: clamp(22px, 3vw, 40px);
  }
  .mdrawer__plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mdrawer__family {
    display: block;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .mdrawer__name {
    font-size: clamp(26px, 4vw, 50px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
  }
  .mdrawer__latin {
    font-size: 15px;
    font-style: italic;
    color: var(--text-caption);
    margin-bottom: clamp(24px, 3vw, 38px);
  }
  .mdrawer__note {
    font-size: 15px;
    line-height: var(--leading-body);
    color: var(--text-body);
    margin-bottom: clamp(24px, 3vw, 38px);
  }

  .spec { margin: 0; border-top: 1px solid var(--border-hairline); }
  .spec > div {
    padding: 15px 0;
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    justify-content: space-between;
    gap: 22px;
  }
  .spec dt {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-label);
  }
  .spec dd { margin: 0; font-size: 14px; text-align: right; }

  .mdrawer__cta { margin-top: clamp(24px, 3vw, 40px); }

  @media (max-width: 899px) {
    .filters__count { margin-left: 0; width: 100%; }
  }

  /* Delapan belas kartu satu kolom membuat halaman ini sepanjang sembilan
     ribu piksel di ponsel. Dua kolom memangkasnya separuh. */
  @media (max-width: 599px) {
    .catalogue__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mcard__name { font-size: 16px; }
    .mcard__latin { font-size: 13px; }
    .mcard__origin { font-size: 11px; letter-spacing: 0.14em; }
  }
</style>
