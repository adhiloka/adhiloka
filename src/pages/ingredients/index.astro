---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import CardGrid from '../../components/blocks/CardGrid.astro';
import PromoBanner from '../../components/blocks/PromoBanner.astro';
import ClosingCta from '../../components/blocks/ClosingCta.astro';
import { CATALOG_DOWNLOAD } from '../../data/downloads';
import {
  INGREDIENTS_INTRO,
  INGREDIENTS_OPENING,
  INGREDIENTS_CARDS,
  INGREDIENTS_MILESTONES,
  INGREDIENTS_CLOSING,
} from '../../data/pages/ingredients';

/* Hub Ingredients, urutannya meniru halaman Ingredients dsm-firmenich.
 * 27 Nov 2026 (pemilik): lini Fragrance cukup Ingredients dan Perfumery;
 * katalog, peta bahan, teknologi dan Natural Ingredients dipadatkan di sini
 * sebagai Discover More (empat kartu 2 x 2, bukan slider). Working With Us dan
 * blok Technologies dilepas. Lalu lima langkah mendatar, pita unduhan
 * katalog, penutup. Slider Collections per keluarga pindah ke Natural
 * Ingredients 13 Nov 2026. */
---

<PageLayout intro={INGREDIENTS_INTRO} bannerTitle="Ingredients">
  <Intro title={INGREDIENTS_INTRO.title} paragraphs={INGREDIENTS_OPENING} />
  <CardGrid title="Discover More" cards={INGREDIENTS_CARDS} grey />

  <section class="sec ms" aria-labelledby="ms-title">
    <div class="wrap">
      <h2 class="h2" id="ms-title" data-anim="title">From Plant to Perfumer</h2>
      <ol class="ms__track" data-anim="columns">
        {
          INGREDIENTS_MILESTONES.map((s) => (
            <li class="ms__item" data-anim-item>
              <p class="ms__year">{s.year}</p>
              <h3 class="ms__title">{s.title}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>


  <PromoBanner
    title={CATALOG_DOWNLOAD.title}
    cta="Download the Catalog"
    href="/ingredients/catalog/#download"
    image="brown-bottles-close"
    grey
  />

  <ClosingCta
    text={INGREDIENTS_CLOSING}
    image="material-nutmeg"
    buttons={[
      { label: 'Ingredient Catalog', href: '/ingredients/catalog/' },
      { label: 'Request a Sample', href: '/contact/?kind=sample' },
    ]}
  />
</PageLayout>

<style>
  /* Tonggak mendatar ala linimasa hub dsm-firmenich: garis bergradien di
     atas, titik per tahun, kolom digeser mendatar di layar sempit. */
  .ms__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
    gap: 32px;
    margin-top: 48px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Garis 1 px setinggi pusat titik. Harus gradien: warna polos mengabaikan
       ukuran latar dan memenuhi seluruh kotak (dulu jadi blok abu). */
    background: linear-gradient(var(--line), var(--line)) 0 5.5px / 100% 1px no-repeat local;
  }
  .ms__item {
    position: relative;
    padding-top: 36px;
    scroll-snap-align: start;
  }
  .ms__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--brand-green);
  }
  .ms__year {
    font-size: calc(14px * var(--fs));
    line-height: 1;
    font-weight: 530;
    letter-spacing: 0.12em;
    color: var(--brand-number);
  }
  .ms__title {
    margin-top: 16px;
    font-size: calc(18px * var(--fs));
    font-weight: 530;
    color: var(--ink);
  }
  .ms__body {
    margin-top: 10px;
    font-size: calc(15px * var(--fs));
    line-height: 1.55;
    color: var(--ink-muted);
  }
  @media (max-width: 1026px) {
    .ms__track { grid-auto-columns: 38%; }
  }
</style>
