---
import { Image } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CardSlider from '../../../../components/blocks/CardSlider.astro';
import DocCard from '../../../../components/blocks/DocCard.astro';
import { images } from '../../../../data/images';
import {
  PRODUCTS,
  FAMILY_COLOR,
  materialHref,
  materialOf,
  productHref,
  productsOf,
  type Product,
} from '../../../../data/materials';
import { CATALOG_DOWNLOAD } from '../../../../data/downloads';

/* Halaman satu kode produk (13 Nov 2026), pola halaman produk dsm-firmenich
 * yang sama dengan halaman bahan: kepala berwarna keluarga dengan kode,
 * strip fakta, profil aroma, lalu tabel spesifikasi, identitas dan regulasi,
 * penyimpanan dan kemasan, Samples & Documents, dan produk lain dari bahan
 * yang sama. Semua isi dari catalog-data.json (master database produk).
 * Angkanya nilai tipikal mutu itu; catatan di bawah tabel mengatakannya. */
export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.ingredient, product: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
const m = materialOf(p);
const siblings = productsOf(m.slug).filter((o) => o.slug !== p.slug);
const contact = (kind: string) => `/contact/?material=${p.slug}&kind=${kind}`;

const facts = [
  { label: 'Product code', value: p.code },
  { label: 'Type', value: p.type },
  { label: 'Botanical name', value: m.latin, latin: true },
  { label: 'Origin', value: p.origin || 'Indonesia' },
];

/* Baris kosong tidak dicetak. */
const rows = (list: [string, string][]) => list.filter(([, v]) => v && v !== 'None');
const spec = rows([
  ['Grade', p.grade],
  ['Appearance', p.appearance],
  ['Colour', p.colour],
  ['Odour', p.odour],
  ['Specific gravity (20 °C)', p.sg],
  ['Refractive index (20 °C)', p.ri],
  ['Optical rotation (20 °C)', p.rot],
  ['Acid value', p.acid],
  ['Main constituents', p.constituents],
  ['Other', p.other],
  ['Solubility', p.solubility],
  ['Flash point (closed cup)', p.flash],
]);
const identity = rows([
  ['Plant part', p.part],
  ['Process', p.process],
  ['Solvent / carrier', p.solvent],
  ['INCI name', p.inci],
  ['CAS No.', p.cas],
  ['EC No.', p.ec],
  ['FEMA No.', p.fema],
  ['HS code', p.hs],
]);
const handling = rows([
  ['Applications', p.apps],
  ['Note', p.notePos],
  ['Shelf life', p.shelf],
  ['Storage', p.storage],
  ['Packaging', p.packaging],
]);
const title = `${p.name} ${p.code}`;
---

<BaseLayout title={title} description={`${p.name} (${p.code}), ${p.type.toLowerCase()} of ${m.name}, ${m.latin}. ${p.odour}.`} inner>
  <section class="ph" style={`--fam: ${FAMILY_COLOR[m.family]}`}>
    <div class="wrap">
      <nav class="ph__crumbs" aria-label="Breadcrumb">
        <a href="/ingredients/catalog/">Ingredient Catalog</a>
        <span aria-hidden="true">/</span>
        <a href={materialHref(m.slug)}>{m.name}</a>
      </nav>
      <div class="ph__grid">
        <div class="ph__media cover">
          {m.image ? <Image quality={75} src={images[m.image]} alt={m.shot} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 320px" loading="eager" /> : <span class="plate">{m.shot}</span>}
        </div>
        <div class="ph__text">
          <p class="ph__fam">{p.code} · {p.type}</p>
          <h1 class="ph__name">{p.name}</h1>
          <p class="ph__latin">{m.latin}</p>
          <a class="ph__sample" href={contact('sample')}>Request sample</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pf" style={`--fam: ${FAMILY_COLOR[m.family]}`} aria-label="Key facts">
    <dl class="wrap pf__grid">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class:list={{ 'is-latin': f.latin }}>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sec pd" id="specification">
    <div class="wrap pd__grid">
      <div class="pd__main">
        <div class="pd__block">
          <h2 class="pd__h">Specification</h2>
          <dl class="spec">
            {
              spec.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="spec__note">Typical values for this grade. The specification for your order is confirmed with the quotation.</p>
        </div>
        <div class="pd__block">
          <h2 class="pd__h">Identification</h2>
          <dl class="spec">
            {
              identity.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <aside class="pd__aside">
        <div class="pd__know">
          <h2 class="pd__h">Use &amp; handling</h2>
          <dl class="spec spec--aside">
            {
              handling.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <a class="pd__ing" href={materialHref(m.slug)}>
          <span class="pd__h">About the ingredient</span>
          <span class="pd__ingname">{m.name}</span>
          <span class="pd__ingnote">{m.note}</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="sec sec--grey mord" id="ordering">
    <div class="wrap mord__grid">
      <div>
        <h2 class="h2" data-anim="title">Samples &amp; Documents</h2>
        <p class="mord__cta">
          <a class="btn" href={contact('sample')}><span class="btn__label">Request a Sample</span></a>
          <a class="btn" href={contact('specification')}><span class="btn__label">Request the Specification</span></a>
          <a class="btn" href={contact('quotation')}><span class="btn__label">Request a Quotation</span></a>
        </p>
        <a class="mord__more" href="/ingredients/working-with-us/">How ordering works</a>
      </div>
      <DocCard doc={CATALOG_DOWNLOAD} />
    </div>
  </section>

  {
    siblings.length > 0 && (
      <CardSlider
        title={`More ${m.name}`}
        viewAll={materialHref(m.slug)}
        items={siblings.map((o) => ({
          href: productHref(o),
          title: o.name,
          image: m.image,
          shot: m.shot,
          tag: `${o.code} · ${o.type}`,
        }))}
      />
    )
  }
</BaseLayout>

<style>
  .ph {
    padding: calc(var(--header-h) + 28px) 0 64px;
    background: var(--fam);
    color: #fff;
  }
  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: calc(13px * var(--fs));
    font-weight: 440;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__crumbs a:hover { color: #fff; }
  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 40px;
  }
  .ph__media { aspect-ratio: 1; border-radius: 4px; }
  .ph__name {
    font-size: calc(clamp(34px, 4.2vw, 60px) * var(--fs));
    line-height: 1.02;
    font-weight: 670;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .ph__fam {
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__latin {
    margin-top: 14px;
    font-size: calc(20px * var(--fs));
    font-style: italic;
    color: rgb(255 255 255 / 0.9);
  }
  .ph__sample {
    display: inline-block;
    margin-top: 28px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #fff;
    font-size: calc(15px * var(--fs));
    font-weight: 530;
    color: #000;
    transition: background var(--t) var(--ease-std);
  }
  .ph__sample:hover { background: var(--brand-cream); }

  .pf {
    padding-block: 32px;
    background: color-mix(in srgb, var(--fam) 16%, var(--bg));
  }
  .pf__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .pf__grid dt { font-size: calc(17px * var(--fs)); font-weight: 530; color: var(--ink); }
  .pf__grid dd { margin-top: 6px; font-size: calc(15px * var(--fs)); line-height: 1.45; color: var(--ink); }
  .pf__grid .is-latin { font-style: italic; }

  .pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 48px 7%;
  }
  .pd__block + .pd__block { margin-top: 48px; }
  .pd__h {
    display: block;
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Tabel spesifikasi: baris bergaris tipis, label kiri, nilai kanan. */
  .spec { border-top: 1px solid var(--line); }
  .spec > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 24px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .spec dt { font-size: calc(15px * var(--fs)); font-weight: 530; color: var(--ink); }
  .spec dd { font-size: calc(15px * var(--fs)); line-height: 1.5; color: var(--ink); font-variant-numeric: tabular-nums; }
  .spec--aside > div { grid-template-columns: 1fr; }
  .spec__note { margin-top: 14px; font-size: calc(13px * var(--fs)); color: var(--ink-muted); }

  .pd__aside { display: flex; flex-direction: column; gap: 24px; }
  .pd__know {
    padding: 28px;
    border-radius: 12px;
    background: var(--bg-grey);
  }
  .pd__ing {
    display: block;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color var(--t) var(--ease-std);
  }
  .pd__ing:hover { border-color: var(--ink); }
  .pd__ingname { display: block; font-size: calc(22px * var(--fs)); font-weight: 530; color: var(--ink); }
  .pd__ingnote { display: block; margin-top: 8px; font-size: calc(15px * var(--fs)); line-height: 1.5; color: var(--ink-muted); }

  .mord__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px 7%;
    align-items: center;
  }
  .mord__cta { display: flex; flex-wrap: wrap; gap: 14px 16px; margin: 36px 0 28px; }
  .mord__more { font-size: calc(16px * var(--fs)); font-weight: 440; text-decoration: underline; text-underline-offset: 5px; }
  .mord__more:hover { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .pd__grid,
    .mord__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .ph { padding-bottom: 44px; }
    .ph__grid { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; }
    .ph__media { width: min(100%, 320px); }
    .pf__grid { grid-template-columns: 1fr 1fr; }
    .spec > div { grid-template-columns: 1fr; }
  }
</style>
