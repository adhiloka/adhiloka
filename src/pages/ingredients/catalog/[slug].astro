---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CardSlider from '../../../components/blocks/CardSlider.astro';
import DocCard from '../../../components/blocks/DocCard.astro';
import { images } from '../../../data/images';
import { MATERIALS, FAMILY_COLOR, materialHref, productHref, productsOf, type Material } from '../../../data/materials';
import { CATALOG_DOWNLOAD } from '../../../data/downloads';

/* Halaman satu bahan bergaya halaman produk dsm-firmenich (23 Okt 2026):
 * kepala berwarna keluarga dengan foto, nama dan Request sample; strip fakta
 * (Botanical, family, plant part, origin); nota aroma, deskripsi olfaktif dan
 * pemakaian di parfum; "Did you know?"; lalu Samples & Documents dengan tiga
 * tombol ke formulir kontak (?material=…&kind=…) dan unduhan katalog.
 *
 * Sejak 13 Nov 2026 ada section Products: semua kode produk bahan ini
 * (kode, nama, jenis, grade) menuju halaman produknya, tempat tabel
 * spesifikasi tinggal. Kalender panen dan syarat pesan tetap tidak dimuat. */
export function getStaticPaths() {
  return MATERIALS.map((material) => ({ params: { slug: material.slug }, props: { material } }));
}

const { material: m } = Astro.props as { material: Material };
/* 33 bahan sejak 13 Nov 2026: slider cukup sembilan, keluarga yang sama dulu. */
const others = MATERIALS.filter((o) => o.slug !== m.slug)
  .sort((a, b) => Number(b.family === m.family) - Number(a.family === m.family))
  .slice(0, 9);
const notes = m.notes.split(' · ');
const contact = (kind: string) => `/contact/?material=${m.slug}&kind=${kind}`;
const products = productsOf(m.slug);

const facts = [
  { label: 'Botanical name', value: m.latin, latin: true },
  { label: 'Family', value: m.family },
  { label: 'Plant part', value: m.part },
  { label: 'Origin', value: m.origin },
];
---

<BaseLayout title={m.name} description={`${m.name} (${m.latin}) from Adhiloka. ${m.note}`} inner>
  <section class="ph" style={`--fam: ${FAMILY_COLOR[m.family]}`}>
    <div class="wrap">
      <nav class="ph__crumbs" aria-label="Breadcrumb">
        <a href="/ingredients/">Ingredients</a>
        <span aria-hidden="true">/</span>
        <a href="/ingredients/catalog/">Ingredient Catalog</a>
      </nav>
      <div class="ph__grid">
        <div class="ph__media cover">
          {m.image ? <Image quality={75} src={images[m.image]} alt={m.shot} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 320px" loading="eager" /> : <span class="plate">{m.shot}</span>}
        </div>
        <div class="ph__text">
          <p class="ph__fam">{m.family}</p>
          <h1 class="ph__name">{m.name}</h1>
          <p class="ph__latin">{m.latin}</p>
          <a class="ph__sample" href={contact('sample')}>Request sample</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pf" style={`--fam: ${FAMILY_COLOR[m.family]}`} aria-label="Key facts">
    <dl class="wrap pf__grid">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class:list={{ 'is-latin': f.latin }}>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sec pd" id="overview">
    <div class="wrap pd__grid">
      <div class="pd__main">
        <div class="pd__block">
          <h2 class="pd__h">Olfactive profile</h2>
          <ul class="pd__chips">
            {notes.map((n) => <li>{n}</li>)}
          </ul>
          <p class="lead pd__lead">{m.note}</p>
        </div>
        <div class="pd__block">
          <h2 class="pd__h">Perfumery usage</h2>
          <p>{m.usage}</p>
        </div>
      </div>
      <aside class="pd__aside">
        <div class="pd__know">
          <h2 class="pd__h">Did you know?</h2>
          <p>{m.know}</p>
        </div>
      </aside>
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="sec prl" id="products">
        <div class="wrap">
          <h2 class="h2" data-anim="title">Products</h2>
          <ul class="prl__list">
            {products.map((p) => (
              <li>
                <a class="prl__row" href={productHref(p)}>
                  <span class="prl__code">{p.code}</span>
                  <span class="prl__name">{p.name}</span>
                  <span class="prl__type">{p.type}</span>
                  <span class="prl__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sec sec--grey mord" id="ordering">
    <div class="wrap mord__grid">
      <div>
        <h2 class="h2" data-anim="title">Samples &amp; Documents</h2>
        <p class="mord__cta">
          <a class="btn" href={contact('sample')}><span class="btn__label">Request a Sample</span></a>
          <a class="btn" href={contact('specification')}><span class="btn__label">Request the Specification</span></a>
          <a class="btn" href={contact('quotation')}><span class="btn__label">Request a Quotation</span></a>
        </p>
        <a class="mord__more" href="/ingredients/working-with-us/">How ordering works</a>
      </div>
      <DocCard doc={CATALOG_DOWNLOAD} />
    </div>
  </section>

  <CardSlider
    title="Other Ingredients"
    viewAll="/ingredients/catalog/"
    items={others.map((o) => ({
      href: materialHref(o.slug),
      title: o.name,
      image: o.image,
      shot: o.shot,
      tag: o.family,
    }))}
  />
</BaseLayout>

<style>
  /* ── Kepala berwarna ala halaman produk dsm-firmenich ─────────────── */
  .ph {
    padding: calc(var(--header-h) + 28px) 0 64px;
    background: var(--fam);
    color: #fff;
  }
  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: calc(13px * var(--fs));
    font-weight: 440;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__crumbs a:hover { color: #fff; }
  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 40px;
  }
  .ph__media {
    aspect-ratio: 1;
    border-radius: 4px;
  }
  .ph__name {
    font-size: calc(clamp(40px, 5.2vw, 76px) * var(--fs));
    line-height: 0.98;
    font-weight: 670;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .ph__fam {
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__latin {
    margin-top: 14px;
    font-size: calc(20px * var(--fs));
    font-style: italic;
    color: rgb(255 255 255 / 0.9);
  }
  .ph__sample {
    display: inline-block;
    margin-top: 28px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #fff;
    font-size: calc(15px * var(--fs));
    font-weight: 530;
    color: #000;
    transition: background 0.3s;
  }
  .ph__sample:hover { background: var(--brand-cream); }

  /* Strip fakta berlatar warna keluarga yang dipudarkan. */
  .pf {
    padding-block: 32px;
    background: color-mix(in srgb, var(--fam) 16%, var(--bg));
  }
  .pf__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .pf__grid dt {
    font-size: calc(17px * var(--fs));
    font-weight: 530;
    color: var(--ink);
  }
  .pf__grid dd {
    margin-top: 6px;
    font-size: calc(15px * var(--fs));
    line-height: 1.45;
    color: var(--ink);
  }
  .pf__grid .is-latin { font-style: italic; }

  /* ── Deskripsi ────────────────────────────────────────────────────── */
  .pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 48px 7%;
  }
  .pd__block + .pd__block { margin-top: 40px; }
  .pd__h {
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .pd__main p:not(.lead) {
    font-size: calc(17px * var(--fs));
    line-height: 1.6;
  }
  .pd__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pd__chips li {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: calc(15px * var(--fs));
    color: var(--ink);
  }
  .pd__aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pd__know {
    padding: 28px;
    border-radius: 12px;
    background: var(--bg-grey);
    font-size: calc(16px * var(--fs));
    line-height: 1.55;
  }
  .pd__lead { margin-top: 24px; }

  /* ── Products: satu baris per kode ───────────────────────────────── */
  .prl__list { margin-top: 28px; border-top: 1px solid var(--line); }
  .prl__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) minmax(0, 220px) 24px;
    gap: 6px 24px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: calc(16px * var(--fs));
    color: var(--ink);
    transition: color var(--t) var(--ease-std);
  }
  .prl__row:hover { color: var(--brand-green); }
  .prl__code { font-weight: 530; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
  .prl__name { font-weight: 530; }
  .prl__type { font-size: calc(14px * var(--fs)); color: var(--ink-muted); }
  .prl__arrow { justify-self: end; transition: transform var(--t) var(--ease-std); }
  .prl__row:hover .prl__arrow { transform: translateX(4px); }

  /* ── Samples & Documents ──────────────────────────────────────────── */
  .mord__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px 7%;
    align-items: center;
  }
  .mord__lead { margin-top: 24px; max-width: 560px; }
  .mord__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
    margin: 36px 0 28px;
  }
  .mord__more {
    font-size: calc(16px * var(--fs));
    font-weight: 440;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .mord__more:hover { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .pd__grid,
    .mord__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .ph { padding-bottom: 44px; }
    .ph__grid { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; }
    .ph__media { width: min(100%, 320px); }
    .pf__grid { grid-template-columns: 1fr 1fr; }
    .prl__row { grid-template-columns: 72px minmax(0, 1fr) 20px; }
    .prl__type { grid-column: 2; grid-row: 2; }
    .prl__arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
