---
import PageLayout from '../../layouts/PageLayout.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import Passages from '../../components/blocks/Passages.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { TECHNOLOGY_INTRO, ROUTES, TECHNOLOGY_SCIENCE, TECHNOLOGY_RANGE, TECHNOLOGY_PASSAGES } from '../../data/pages/ingredients';

/* Susunan mengikuti halaman teknologi dsm-firmenich: daftar teknik, lalu
 * jajaran produk dan mutu. Tiap teknik cukup nama + satu keterangan pendek;
 * tidak ada pembuka dan tidak ada kalimat pengantar di bawah judul. */
const asItems = (list: typeof ROUTES) => list.map((r) => ({ title: r.name, body: r.note }));
---

<PageLayout intro={TECHNOLOGY_INTRO}>
  <InfoGrid id="routes" title="Extraction & Distillation" cols={3} items={asItems(ROUTES)} />
  <InfoGrid id="science" title="Science & Renewables" cols={4} items={asItems(TECHNOLOGY_SCIENCE)} grey />
  <InfoGrid id="range" title="What We Produce" cols={3} items={TECHNOLOGY_RANGE.map((title) => ({ title }))} />
  <Passages passages={TECHNOLOGY_PASSAGES} startGrey />
  <SiblingCards />
</PageLayout>
