---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import Passages from '../../components/blocks/Passages.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { TECHNOLOGY_INTRO, ROUTES, TECHNOLOGY_PASSAGES } from '../../data/pages/ingredients';
---

<PageLayout intro={TECHNOLOGY_INTRO}>
  <Intro title="Owning every step" paragraphs={[TECHNOLOGY_INTRO.lede]} />
  <InfoGrid
    id="routes"
    title="Extraction Routes"
    items={ROUTES.map((r) => ({ title: r.name, sub: r.applies, body: r.body }))}
    grey
  />
  <Passages passages={TECHNOLOGY_PASSAGES} />
  <SiblingCards />
</PageLayout>
