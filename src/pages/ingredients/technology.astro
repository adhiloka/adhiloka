---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import Interlude from '../../components/Interlude.astro';
import { TECHNOLOGY_INTRO, ROUTES, TECHNOLOGY_PASSAGES } from '../../data/pages/ingredients';
---

<PageLayout intro={TECHNOLOGY_INTRO} section="/ingredients/">
  <section class="section">
    <div class="frame">
      <span class="eyebrow" data-reveal="0">Extraction routes</span>
      <dl class="routes">
        {
          ROUTES.map((r, i) => (
            <div class="route" data-reveal={String(i * 60)}>
              <dt class="route__name">
                {r.name}
                <span class="route__applies">{r.applies}</span>
              </dt>
              <dd class="route__body">{r.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    TECHNOLOGY_PASSAGES.map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        reverse={i % 2 === 1}
        ground={i % 2 === 1 ? 'sunk' : 'paper'}
      />
    ))
  }

  <section class="bridge">
    <Interlude
      class="frame"
      line="Every route above, applied to eighteen materials."
      href="/ingredients/catalog/"
      cta="Browse the catalog"
      italic
    />
  </section>
</PageLayout>

<style>
  .routes {
    margin: clamp(26px, 3vw, 44px) 0 0;
    border-top: 1px solid var(--rule-strong);
  }

  .route {
    display: grid;
    grid-template-columns: minmax(200px, 0.32fr) minmax(0, 1fr);
    gap: clamp(18px, 3vw, 56px);
    padding: clamp(22px, 2.6vw, 34px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .route__name {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: var(--leading-title);
    color: var(--teal);
    font-weight: 500;
  }
  .route__applies {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-muted);
    font-weight: 500;
  }

  .route__body {
    margin: 0;
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--ink-body);
    max-width: var(--measure-body);
  }

  .bridge { background: var(--paper); padding: var(--section-y) var(--gutter); }

  @media (max-width: 899px) {
    .route { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
