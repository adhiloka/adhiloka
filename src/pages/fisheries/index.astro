---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import LineCatalog from '../../components/blocks/LineCatalog.astro';
import { SEAFOOD_INTRO, SEAFOOD_OPENING } from '../../data/pages/seafood-line';

/* Halaman lini (pemilik, 27 Nov 2026): overview singkat, lalu katalog di
   bawahnya seperti Ingredient Catalog (cari, tab kategori, kartu item).
   Rincian (jenis, bentuk, ukuran, kode) ada di halaman item dan kode. */
---

<PageLayout intro={SEAFOOD_INTRO}>
  <Intro title={SEAFOOD_OPENING.title} paragraphs={[SEAFOOD_OPENING.body]}>
    <p class="line__btns">
      <a class="btn" href="/contact/?business=seafood&kind=quotation"><span class="btn__label">Request a Quotation</span></a>
    </p>
  </Intro>
  <LineCatalog line="seafood" />
</PageLayout>

<style>
  .line__btns { margin-top: 32px; }
</style>
