---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import Feature from '../../components/blocks/Feature.astro';
import { SEAFOOD_CATEGORIES } from '../../data/seafood';
import { lineCategoryHref } from '../../data/line-products';
import { SEAFOOD_INTRO, SEAFOOD_OPENING, SEAFOOD_QUALITY, SEAFOOD_STEPS } from '../../data/pages/seafood-line';

/* Beranda lini Seafood (situs grup, 26 Nov 2026): pembuka · kategori produk
   (menuju katalog per kategori) · mutu & rantai dingin · cara memesan. */
const cats = SEAFOOD_CATEGORIES.map((c) => ({ title: c.label, body: c.body, href: lineCategoryHref('seafood', c.key), linkLabel: 'View Products' }));
---

<PageLayout intro={SEAFOOD_INTRO}>
  <Intro title={SEAFOOD_OPENING.title} paragraphs={[SEAFOOD_OPENING.body]} />
  <InfoGrid id="products" title="Our Products" items={cats} cols={4} grey />
  <Feature id="quality" heading={SEAFOOD_QUALITY.heading} body={SEAFOOD_QUALITY.body} image="sf-quality" alt="Frozen fish packed in a cold store" />
  <InfoGrid id="working-with-us" title="Working With Us" items={SEAFOOD_STEPS} grey>
    <p class="line__btns">
      <a class="btn" href="/contact/?business=seafood&kind=quotation"><span class="btn__label">Request a Quotation</span></a>
      <a class="btn" href="/seafood/products/"><span class="btn__label">Seafood Products</span></a>
    </p>
  </InfoGrid>
</PageLayout>

<style>
  .line__btns { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 48px; }
</style>
