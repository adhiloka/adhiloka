---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/blocks/PageBanner.astro';
import CardSlider from '../../../components/blocks/CardSlider.astro';
import { NEWS, byDate, formatDate, type Article } from '../../../data/pages/media';

/* Halaman rilis ala adani.com/newsroom/media-releases/…: banner setengah
 * layar berisi remah roti saja (`halfbanner press-release-banner`), lalu
 * kategori, tanggal, judul dan isi, dan "Other Releases" berupa slider dua
 * kartu (`twoImageSlider`). */
export function getStaticPaths() {
  return NEWS.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const others = [...NEWS].sort(byDate).filter((a) => a.slug !== article.slug);
---

<BaseLayout title={article.title} description={article.standfirst} active="/media/" inner>
  <PageBanner title={article.title} image={article.image ?? 'fragrance-resin'} alt={article.shot} half />

  <article class="sec art">
    <div class="wrap">
      <div class="art__head">
        <p class="art__meta">
          <span>{article.category}</span>
          <time datetime={article.date}>{formatDate(article.date)}</time>
        </p>
        <h1 class="art__title">{article.title}</h1>
        <p class="art__standfirst">{article.standfirst}</p>
      </div>
      <div class="art__body prose">
        {article.body.map((p) => <p>{p}</p>)}
        <p class="art__back"><a class="btn" href="/media/news/"><span class="btn__label">All News</span></a></p>
      </div>
    </div>
  </article>

  <CardSlider
    title="Other Releases"
    perView={2}
    viewAll="/media/news/"
    items={others.map((a) => ({
      href: `/media/news/${a.slug}/`,
      title: a.title,
      image: a.image,
      shot: a.shot,
      tag: a.category,
      meta: formatDate(a.date),
      datetime: a.date,
    }))}
    grey
  />
</BaseLayout>

<style>
  .art__head { max-width: 1100px; }
  .art__meta {
    display: flex;
    gap: 20px;
    font-size: 16px;
    color: var(--ink-muted);
  }
  .art__meta span {
    padding: 2px 10px;
    background: var(--bg-grey);
    color: var(--ink);
  }
  .art__title {
    margin-top: 20px;
    font-size: clamp(30px, 3.06vw, 44px);
    line-height: 1.1;
    font-weight: 530;
    color: var(--ink);
  }
  .art__standfirst {
    margin-top: 24px;
    font-size: clamp(18px, 1.53vw, 22px);
    line-height: 1.4;
    color: var(--ink);
  }
  .art__body { max-width: 860px; margin-top: 56px; }
  .art__back { margin-top: 40px !important; }
</style>
