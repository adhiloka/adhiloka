---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsCards from '../../../components/NewsCards.astro';
import { images } from '../../../data/images';
import { NEWS, byDate, formatDate, type Article } from '../../../data/pages/media';

/* Halaman rilis ala adani.com/newsroom: remah, kategori dan tanggal, judul,
 * foto lebar, isi, lalu berita lain. */
export function getStaticPaths() {
  return NEWS.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const more = [...NEWS].sort(byDate).filter((a) => a.slug !== article.slug).slice(0, 3);
---

<BaseLayout title={article.title} description={article.standfirst} active="/media/">
  <article class="art">
    <div class="wrap"><div class="art__head">
      <nav class="art__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/media/">Media</a><span>/</span><a href="/media/news/">News</a>
      </nav>
      <p class="art__meta">
        <span>{article.category}</span>
        <time datetime={article.date}>{formatDate(article.date)}</time>
      </p>
      <h1 class="art__title">{article.title}</h1>
      <p class="art__standfirst">{article.standfirst}</p>
    </div></div>

    <div class="wrap">
      <figure class="art__figure cover">
        {article.image ? <Image quality={70} src={images[article.image]} alt={article.shot} widths={[768, 1280, 1920]} sizes="(max-width: 1219px) 100vw, 89vw" loading="eager" /> : <span class="plate">{article.shot}</span>}
      </figure>
    </div>

    <div class="wrap"><div class="art__body prose">
      {article.body.map((p) => <p>{p}</p>)}
      <p class="art__back"><a class="btn" href="/media/news/"><span class="btn__label">All News</span></a></p>
    </div></div>
  </article>

  <NewsCards title="More News" viewAll="/media/news/" articles={more} grey />
</BaseLayout>

<style>
  .art { padding: calc(var(--header-h) + 60px) 0 var(--sec-pad); }
  .art__head { max-width: 1100px; }
  .art__crumbs { display: flex; gap: 10px; font-size: 14px; color: var(--ink-muted); }
  .art__crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .art__meta {
    display: flex;
    gap: 20px;
    margin-top: 36px;
    font-size: 16px;
    color: var(--ink-muted);
  }
  .art__meta span {
    padding: 2px 10px;
    background: var(--bg-grey);
    color: var(--ink);
  }
  .art__title {
    margin-top: 20px;
    font-size: clamp(30px, 3.06vw, 44px);
    line-height: 1.1;
    font-weight: 530;
    color: var(--ink);
  }
  .art__standfirst {
    margin-top: 24px;
    font-size: clamp(18px, 1.53vw, 22px);
    line-height: 1.4;
    color: var(--ink);
  }
  .art__figure {
    margin-top: 48px;
    aspect-ratio: 16 / 7;
  }
  .art__body { max-width: 860px; margin-top: 56px; }
  .art__back { margin-top: 40px !important; }
  @media (max-width: 767px) { .art__figure { aspect-ratio: 4 / 3; } }
</style>
