---
import PageLayout from '../../../layouts/PageLayout.astro';
import NewsCards from '../../../components/NewsCards.astro';
import PressContact from '../../../components/blocks/PressContact.astro';
import { NEWS_INTRO, NEWS, byDate } from '../../../data/pages/media';

/* Daftar berita ala "Media Releases" adani.com: tab kategori menyaring grid. */
const articles = [...NEWS].sort(byDate);
const cats = ['all', ...new Set(articles.map((a) => a.category))];
---

<PageLayout intro={NEWS_INTRO} lineInBanner>
  <section class="sec" data-tabs data-filter>
    <div class="wrap">
      <div class="nl__bar">
        <h2 class="h2">Media Releases</h2>
        <div class="nl__tabs" role="tablist" aria-label="Filter by category">
          {
            cats.map((c, i) => (
              <button class:list={['ntab', { 'is-active': i === 0 }]} type="button" role="tab" data-tab={c} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {c === 'all' ? 'All' : c}
              </button>
            ))
          }
        </div>
      </div>
      <p class="nl__count" role="status" aria-live="polite" data-filter-count>{articles.length} items</p>
      <NewsCards articles={articles} filterable headingLevel="h3" />
    </div>
  </section>
  <PressContact />
</PageLayout>

<script>
  import { initTabs } from '../../../scripts/tabs';
  initTabs();
</script>

<style>
  .nl__bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .nl__tabs { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
  .ntab {
    position: relative;
    padding: 10px 18px;
    font-size: 17px;
    font-weight: 440;
    color: var(--ink-muted);
  }
  .ntab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transition: transform 0.3s;
  }
  .ntab:hover { color: var(--ink); }
  .ntab.is-active { color: var(--ink); }
  .ntab.is-active::after { transform: none; }
  .nl__count { margin: 28px 0 32px; font-size: 15px; color: var(--ink-muted); }
</style>
