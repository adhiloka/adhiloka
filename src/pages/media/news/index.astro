---
import PageLayout from '../../../layouts/PageLayout.astro';
import NewsList from '../../../components/NewsList.astro';
import Interlude from '../../../components/Interlude.astro';
import { NEWS_INTRO, NEWS, byDate } from '../../../data/pages/media';

const articles = [...NEWS].sort(byDate);
---

<PageLayout intro={NEWS_INTRO} section="/media/" media={false}>
  <section class="section bg-tint-teal">
    <div class="frame">
      <div class="news__head">
        <span class="eyebrow" data-reveal="0">All announcements</span>
        <span class="news__count" data-reveal="50">{articles.length}</span>
      </div>
      <div class="news__grid">
        <NewsList articles={articles} feature />
      </div>
    </div>
  </section>

  <section class="bridge">
    <Interlude
      class="frame"
      line="Images and documents cleared for publication."
      href="/media/media-resources/"
      cta="Media resources"
      italic
    />
  </section>
</PageLayout>

<style>
  .news__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .news__count {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .news__grid { margin-top: clamp(30px, 3.6vw, 52px); }

  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
