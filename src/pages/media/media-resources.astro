---
import PageLayout from '../../layouts/PageLayout.astro';
import DownloadList from '../../components/DownloadList.astro';
import Interlude from '../../components/Interlude.astro';
import {
  RESOURCES_INTRO,
  RESOURCES,
  RESOURCES_NOTE,
  MEDIA_CONTACT,
} from '../../data/pages/media';
---

<PageLayout intro={RESOURCES_INTRO} section="/media/" media={false}>
  <section class="section">
    <div class="frame">
      <span class="eyebrow" data-reveal="0">Downloads</span>
      <div class="res__grid">
        <DownloadList resources={RESOURCES} />
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="frame terms">
      <div class="sticky-col">
        <div class="sticky-col__inner">
          <span class="eyebrow" data-reveal="0">Terms of use</span>
        </div>
      </div>
      <div class="terms__body">
        <p class="prose" data-reveal="60">{RESOURCES_NOTE}</p>
        <p class="prose" data-reveal="110">
          {MEDIA_CONTACT.body}
        </p>
        <a class="btn-solid" href={`mailto:${MEDIA_CONTACT.email}`} data-reveal="160">
          {MEDIA_CONTACT.email}
        </a>
      </div>
    </div>
  </section>

  <section class="bridge">
    <Interlude
      class="frame"
      line="What we have announced so far."
      href="/media/news/"
      cta="Read the news"
      italic
    />
  </section>
</PageLayout>

<style>
  .res__grid { margin-top: clamp(26px, 3vw, 44px); }
  .section--sunk { background: var(--paper-sunk); }

  .terms {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
  }
  .terms__body { max-width: var(--measure-body); }
  .terms__body .btn-solid { margin-top: clamp(18px, 2.2vw, 30px); }

  .bridge { background: var(--paper); padding: var(--section-y) var(--gutter); }

  @media (max-width: 899px) {
    .terms { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
