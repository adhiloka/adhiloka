---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import PressContact from '../../components/blocks/PressContact.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { RESOURCES_INTRO, RESOURCES, RESOURCES_NOTE } from '../../data/pages/media';

/* "Media Kit" adani.com: daftar berkas dengan jenis, ukuran dan tombol unduh.
 * Berkasnya belum ada; href di RESOURCES masih placeholder. */
---

<PageLayout intro={RESOURCES_INTRO}>
  <Intro title="Media Kit" paragraphs={[RESOURCES_INTRO.lede, RESOURCES_NOTE]} />
  <section class="sec sec--grey">
    <div class="wrap">
      <ul class="dl" data-anim="columns">
        {
          RESOURCES.map((r) => (
            <li class="dl__row" data-anim-item>
              <div>
                <h2 class="dl__title">{r.title}</h2>
                <p class="dl__body">{r.body}</p>
              </div>
              <p class="dl__meta">{r.kind} · {r.size}</p>
              <a class="btn" href={r.href}><span class="btn__label">Download</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <PressContact grey={false} />
  <SiblingCards />
</PageLayout>

<style>
  .dl { border-top: 1px solid var(--line); }
  .dl__row {
    display: grid;
    grid-template-columns: 1fr 200px auto;
    gap: 32px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .dl__title { font-size: 22px; font-weight: 530; color: var(--ink); }
  .dl__body { margin-top: 8px; max-width: 720px; font-size: 16px; line-height: 1.6; }
  .dl__meta { font-size: 15px; color: var(--ink-muted); }
  @media (max-width: 767px) {
    .dl__row { grid-template-columns: 1fr; gap: 14px; }
    .dl__row .btn { justify-self: start; }
  }
</style>
