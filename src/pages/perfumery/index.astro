---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import Passages from '../../components/blocks/Passages.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import ClosingCta from '../../components/blocks/ClosingCta.astro';
import {
  PERFUMERY_INTRO,
  PERFUMERY_OPENING,
  PERFUMERY_AREAS,
  PERFUMERY_INNOVATION,
  PERFUMERY_STEPS,
  PERFUMERY_PALETTE,
  PERFUMERY_CLOSING,
} from '../../data/pages/perfumery';

/* Perfumery: satu halaman tanpa subhalaman. Urutannya mengikuti cara
 * dsm-firmenich, Givaudan, IFF dan Robertet menerangkan perfumery:
 * bidang kreasi, inovasi, cara kerja, palet, lalu ajakan. Tiap bagian cukup
 * judul + satu keterangan pendek (data/pages/perfumery.ts). */
---

<PageLayout intro={PERFUMERY_INTRO} bannerTitle="Perfumery">
  <Intro title={PERFUMERY_INTRO.title} paragraphs={PERFUMERY_OPENING} />
  <Passages passages={PERFUMERY_AREAS} startGrey />
  <InfoGrid id="innovation" title="Fragrance Innovation" cols={3} items={PERFUMERY_INNOVATION} grey />
  <InfoGrid id="approach" title="How We Work" cols={4} items={PERFUMERY_STEPS} />
  <Passages passages={[PERFUMERY_PALETTE]} startGrey />
  <ClosingCta
    text={PERFUMERY_CLOSING}
    image="fragrance-petal"
    buttons={[
      { label: 'Contact Us', href: '/contact/?kind=bespoke' },
      { label: 'Explore Ingredients', href: '/ingredients/' },
    ]}
  />
</PageLayout>
