---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import Interlude from '../../components/Interlude.astro';
import { INNOVATION_INTRO, INNOVATION_PASSAGES } from '../../data/pages/perfumery';
import { groundAt, bridgeAfter } from '../../data/ground';
---

<PageLayout intro={INNOVATION_INTRO} section="/perfumery/">
  {
    INNOVATION_PASSAGES.map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        reverse={i % 2 === 1}
        ground={groundAt(i)}
      />
    ))
  }

  <section class="bridge" style={`--bridge-bg:${bridgeAfter(groundAt(INNOVATION_PASSAGES.length - 1))}`}>
    <Interlude
      class="frame"
      line="The extraction routes behind all of it."
      href="/ingredients/technology/"
      cta="Technology"
      italic
    />
  </section>
</PageLayout>

<style>
  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
