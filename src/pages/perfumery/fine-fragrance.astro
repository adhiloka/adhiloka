---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import Passages from '../../components/blocks/Passages.astro';
import QuoteSplit from '../../components/QuoteSplit.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { FINE_INTRO, FINE_PASSAGES, FINE_QUOTE } from '../../data/pages/perfumery';
---

<PageLayout intro={FINE_INTRO}>
  <Intro title="Led by naturals" paragraphs={[FINE_INTRO.lede]} />
  <Passages passages={FINE_PASSAGES} startGrey />
  <QuoteSplit text={FINE_QUOTE.text} name={FINE_QUOTE.attribution} image="fragrance-petal" alt="Orange petals, close" />
  <SiblingCards />
</PageLayout>
