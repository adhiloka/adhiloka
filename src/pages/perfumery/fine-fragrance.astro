---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import Pullquote from '../../components/Pullquote.astro';
import Interlude from '../../components/Interlude.astro';
import { FINE_INTRO, FINE_PASSAGES, FINE_QUOTE } from '../../data/pages/perfumery';
import { groundAt, bridgeAfter } from '../../data/ground';
---

<PageLayout intro={FINE_INTRO} section="/perfumery/">
  {
    FINE_PASSAGES.slice(0, 2).map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        reverse={i % 2 === 1}
        ground={groundAt(i)}
      />
    ))
  }

  <Pullquote quote={FINE_QUOTE} />

  {
    FINE_PASSAGES.slice(2).map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        ground={groundAt(i, 3)}
      />
    ))
  }

  <section class="bridge" style={`--bridge-bg:${bridgeAfter(groundAt(FINE_PASSAGES.slice(2).length - 1, 3))}`}>
    <Interlude
      class="frame"
      line="What we are still working out at the bench."
      href="/perfumery/fragrance-innovation/"
      cta="Fragrance innovation"
      italic
    />
  </section>
</PageLayout>

<style>
  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
