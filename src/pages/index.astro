---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import QuoteSplit from '../components/QuoteSplit.astro';
import BusinessShowcase from '../components/home/BusinessShowcase.astro';
import SustainAccordion from '../components/home/SustainAccordion.astro';
import NewsCards from '../components/NewsCards.astro';
import JoinUs from '../components/home/JoinUs.astro';
import NoticeBox from '../components/home/NoticeBox.astro';
import { SITE } from '../data/site';
import { HERO_SLIDES, HOME_QUOTE } from '../data/pages/home';
import { NEWS, byDate } from '../data/pages/media';

/* Beranda, urutan section persis beranda adani.com. */
const latest = [...NEWS].sort(byDate).slice(0, 3);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <HeroSlider slides={HERO_SLIDES} />
  <QuoteSplit {...HOME_QUOTE} />
  <BusinessShowcase />
  <SustainAccordion />
  <NewsCards title="Latest News" viewAll="/media/news/" articles={latest} />
  <JoinUs />
  <NoticeBox />
</BaseLayout>
