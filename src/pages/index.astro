---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Waves from '../components/Waves.astro';
import SlideRail from '../components/SlideRail.astro';
import Tile from '../components/Tile.astro';
import { getImageFor } from '../data/images';
import { SITE } from '../data/site';
import { GET_IN_TOUCH } from '../data/pages/home';
import { ABOUT_STATS } from '../data/pages/about';
import { SUSTAINABILITY_INTRO } from '../data/pages/sustainability';
import { PERFUMERY_INTRO } from '../data/pages/perfumery';
import { NEWS, byDate, formatDate } from '../data/pages/media';

/* Beranda mengikuti urutan beranda valeindonesia.com: hero, pembuka + angka
   sekilas, section Sustainability bergelombang (dua foto dengan panel biru
   melengkung di antaranya), karusel kartu, pita emas, pita biru langit,
   karusel berita, footer. Tiap section dibuat pendek supaya dua section muat
   dalam satu layar. Semua naskah diambil dari data yang sudah ada. */

const introPhoto = getImageFor('about-table');
const leftPhoto = getImageFor('agroforest-canopy');
const rightPhoto = getImageFor('purpose-generations');
const goldPhoto = getImageFor('fragrance-petal');
const skyPhoto = getImageFor('material-ginger');

const EXPLORE = GET_IN_TOUCH.filter((s) => s.title !== 'Our purpose');
const SAMPLE = GET_IN_TOUCH.find((s) => s.title === 'Request a sample')!;
const LATEST = [...NEWS].sort(byDate);
---

<BaseLayout title={SITE.name} description={SITE.description} headerVariant="over-dark" active="/">
  <Hero />

  <!-- Pembuka: "Welcome to…" abu, naskah, dan angka sekilas dalam satu baris.
       Teks masuk dari kiri, foto dari kanan (pola .animar di Vale). -->
  <section class="intro">
    <div class="frame intro__grid">
      <div class="intro__text" data-reveal data-reveal-from="left">
        <h2 class="intro__title">Welcome to {SITE.legalName}!</h2>
        <p class="intro__lede">{SITE.description}</p>
        <h3 class="intro__glance">Adhiloka at a glance</h3>
        <dl class="intro__stats">
          {
            ABOUT_STATS.map((s) => (
              <div class="intro__stat">
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="intro__media" data-reveal data-reveal-from="right">
        {
          introPhoto && (
            <Image
              src={introPhoto}
              alt="Three people talking over a laid table"
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Section bergelombang (bentuk "Sustainability" di Vale): foto kiri turun,
       foto kanan naik, dan panel biru langit berlekuk S menyambung keduanya.
       Ukurannya dalam persen lebar kolom (foto 16:10, geseran 20%), jadi
       lekuknya selalu bertemu sudut kedua foto di lebar layar berapa pun. -->
  <section class="wave-box bg-tint-teal">
    <div class="frame wave-box__grid">
      <h2 class="wave-box__title" data-reveal data-reveal-from="left">Sustainability</h2>

      <div class="wave-box__photo wave-box__photo--left" data-curtain>
        {
          leftPhoto && (
            <Image
              src={leftPhoto}
              alt="Forest canopy seen from below"
              width={800}
              widths={[400, 800]}
              sizes="(max-width: 899px) 90vw, 33vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
      </div>

      <div class="wave-box__panel" data-reveal>
        <svg class="wave-box__shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0 24.2C38 24.2 58 0 100 0V75.8C62 75.8 42 100 0 100Z"></path>
        </svg>
        <div class="wave-box__text">
          <p>{SUSTAINABILITY_INTRO.lede}</p>
          <a class="btn-solid" href="/sustainability/">Our sustainability approach</a>
        </div>
      </div>

      <div class="wave-box__photo wave-box__photo--right" data-curtain>
        {
          rightPhoto && (
            <Image
              src={rightPhoto}
              alt="Two children running through a summer meadow"
              width={800}
              widths={[400, 800]}
              sizes="(max-width: 899px) 90vw, 33vw"
              loading="lazy"
              decoding="async"
              quality={66}
              style="object-position: 20% 50%"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- Karusel kartu (Governance di Vale), di atas teal solid. -->
  <section class="explore bg-teal on-dark">
    <div class="frame explore__head" data-reveal>
      <h2 class="explore__title">Explore Adhiloka</h2>
    </div>
    <div data-reveal="120">
      <SlideRail label="Explore Adhiloka">
        {
          EXPLORE.map((s) => (
            <Tile title={s.title} body={s.body} href={s.href} cta={s.cta} image={s.image} alt={s.shot} />
          ))
        }
      </SlideRail>
    </div>
  </section>

  <!-- Pita emas (Investors di Vale). Teks gelap: abu di atas emas cuma 3,9:1. -->
  <section class="band band--gold on-color">
    <div class="frame band__grid">
      <div class="band__text" data-reveal data-reveal-from="left">
        <h2 class="band__title">Perfumery</h2>
        <p class="band__lede">{PERFUMERY_INTRO.lede}</p>
        <a class="btn-solid" href="/perfumery/">Discover the perfumery</a>
      </div>
      <div class="band__media" data-curtain>
        {
          goldPhoto && (
            <Image
              src={goldPhoto}
              alt="A petal, close"
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Pita biru langit (Supplier di Vale). -->
  <section class="band band--sky on-color">
    <div class="frame band__grid">
      <div class="band__text" data-reveal data-reveal-from="left">
        <h2 class="band__title">{SAMPLE.title}</h2>
        <p class="band__lede">{SAMPLE.body}</p>
        <a class="btn-solid" href={SAMPLE.href}>{SAMPLE.cta}</a>
      </div>
      <div class="band__media" data-curtain>
        {
          skyPhoto && (
            <Image
              src={skyPhoto}
              alt={SAMPLE.shot}
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Karusel berita. NEWS masih kabar contoh (PLACEHOLDER di media.ts). -->
  <section class="news">
    <div class="frame news__head" data-reveal>
      <h2 class="section-title">News</h2>
      <a class="action-link" href="/media/news/">All news</a>
    </div>
    <div data-reveal="120">
      <SlideRail label="Latest news">
        {
          LATEST.map((a) => (
            <Tile
              title={a.title}
              body={a.standfirst}
              href={`/media/news/${a.slug}/`}
              cta="Read more"
              image={a.image}
              alt={a.shot}
              meta={`${formatDate(a.date)} · ${a.category}`}
            />
          ))
        }
      </SlideRail>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Pembuka ────────────────────────────────────────────────────────── */
  .intro { padding: var(--pad-y) var(--gutter); }
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .intro__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--ink-body);
  }
  .intro__lede {
    margin-top: 14px;
    max-width: 38em;
    font-size: 17px;
    line-height: 1.55;
  }
  .intro__glance {
    margin-top: 20px;
    font-size: var(--type-h4);
    font-weight: 500;
    color: var(--teal);
  }
  /* Angka sekilas dalam satu baris empat kolom: hemat tinggi. */
  .intro__stats {
    margin: 12px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .intro__stat {
    padding-left: 12px;
    border-left: 3px solid var(--gold);
  }
  .intro__stat dt {
    font-size: clamp(26px, 2.2vw, 34px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--teal);
  }
  .intro__stat dd {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-body);
  }
  .intro__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 16 / 10;
    max-height: 340px;
    width: 100%;
  }
  .intro__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* ── Section bergelombang ───────────────────────────────────────────── */
  .wave-box {
    padding: var(--pad-y) var(--gutter);
    --wave-ground: var(--tint-teal);
  }
  .wave-box__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* Judul duduk di celah di atas foto kiri (celah = 20% lebar kolom). */
  .wave-box__title {
    position: absolute;
    top: 0;
    left: 0;
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: 1.1;
    color: var(--teal);
  }
  /* align-self: start supaya rasio 16:10 berlaku (stretch akan menimpanya).
     Margin persen pada anak grid dihitung terhadap lebar kolomnya. */
  .wave-box__photo {
    position: relative;
    overflow: hidden;
    align-self: start;
    aspect-ratio: 16 / 10;
  }
  .wave-box__photo--left { margin-top: 20%; }
  .wave-box__photo--right { margin-bottom: 20%; }
  .wave-box__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .wave-box__panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wave-box__shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wave-box__shape path { fill: var(--sky); }
  .wave-box__text {
    position: relative;
    padding: 0 12%;
    color: var(--ink);
  }
  .wave-box__text p {
    font-size: clamp(16px, 1.15vw, 19px);
    line-height: 1.5;
    font-weight: 500;
  }
  .wave-box__text :global(.btn-solid) { margin-top: 16px; }

  /* ── Karusel kartu ──────────────────────────────────────────────────── */
  .explore { padding: var(--pad-y) 0; }
  .explore__head { padding-inline: var(--gutter); margin-bottom: 20px; }
  .explore__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--paper);
  }

  /* ── Pita emas / biru langit ────────────────────────────────────────── */
  .band { padding: var(--pad-y) var(--gutter); color: var(--ink); }
  .band--gold { background: var(--gold); --wave-ground: var(--gold); --wave-accent: var(--teal); }
  .band--sky { background: var(--sky); --wave-ground: var(--sky); }
  .band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .band__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--ink);
  }
  .band__lede {
    margin-top: 14px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
  }
  .band__text :global(.btn-solid) { margin-top: 20px; }
  .band__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 16 / 9;
    max-height: 320px;
    width: 100%;
  }
  .band__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* ── Berita ─────────────────────────────────────────────────────────── */
  .news { padding: var(--pad-y) 0; }
  .news__head {
    padding-inline: var(--gutter);
    margin-bottom: 20px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .news :global(.tile__text) { background: var(--paper-sunk); }

  @media (max-width: 899px) {
    .intro__grid,
    .band__grid { grid-template-columns: 1fr; }
    .band__media { order: -1; }
    .intro__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    /* Satu kolom: geseran dan lekuk dibuang, panel jadi kotak biru bersudut. */
    .wave-box__grid { grid-template-columns: 1fr; gap: 16px; }
    .wave-box__title { position: static; }
    .wave-box__photo--left, .wave-box__photo--right { margin: 0; }
    .wave-box__shape { display: none; }
    .wave-box__panel {
      background: var(--sky);
      border-radius: var(--radius-card);
      padding: 24px 0;
    }
  }
</style>
