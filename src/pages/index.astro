---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Waves from '../components/Waves.astro';
import SlideRail from '../components/SlideRail.astro';
import Tile from '../components/Tile.astro';
import { getImageFor } from '../data/images';
import { SITE } from '../data/site';
import { GET_IN_TOUCH } from '../data/pages/home';
import { ABOUT_STATS } from '../data/pages/about';
import { SUSTAINABILITY_INTRO } from '../data/pages/sustainability';
import { PERFUMERY_INTRO } from '../data/pages/perfumery';
import { NEWS, byDate, formatDate } from '../data/pages/media';

/* Beranda mengikuti urutan beranda valeindonesia.com: hero, pembuka + angka
   sekilas, kotak Sustainability, karusel kartu, pita emas, pita biru langit,
   karusel berita, footer. Semua naskah diambil dari data yang sudah ada. */

const introPhoto = getImageFor('about-table');
const boxPhoto = getImageFor('agroforest-canopy');
const goldPhoto = getImageFor('fragrance-petal');
const skyPhoto = getImageFor('material-ginger');

const EXPLORE = GET_IN_TOUCH.filter((s) => s.title !== 'Our purpose');
const SAMPLE = GET_IN_TOUCH.find((s) => s.title === 'Request a sample')!;
const LATEST = [...NEWS].sort(byDate);
---

<BaseLayout title={SITE.name} description={SITE.description} headerVariant="over-dark" active="/">
  <Hero />

  <!-- Pembuka: "Welcome to…" abu, naskah, dan angka sekilas. Teks masuk dari
       kiri, foto dari kanan (pola .animar di Vale). -->
  <section class="intro">
    <div class="frame intro__grid">
      <div class="intro__text" data-reveal data-reveal-from="left">
        <h2 class="intro__title">Welcome to {SITE.legalName}!</h2>
        <p class="intro__lede">{SITE.description}</p>
        <h3 class="intro__glance">Adhiloka at a glance</h3>
        <dl class="intro__stats">
          {
            ABOUT_STATS.map((s) => (
              <div class="intro__stat">
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="intro__media" data-reveal data-reveal-from="right">
        {
          introPhoto && (
            <Image
              src={introPhoto}
              alt="Three people talking over a laid table"
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Kotak Sustainability (box-conecta di Vale): foto bergelombang atas dan
       bawah yang dibuka tirai, lalu judul teal dan tombol pil. -->
  <section class="box">
    <div class="frame box__grid">
      <div class="box__media" data-curtain>
        {
          boxPhoto && (
            <Image
              src={boxPhoto}
              alt="Forest canopy seen from below"
              width={1000}
              widths={[520, 1000]}
              sizes="(max-width: 899px) 90vw, 50vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="top" />
        <Waves kind="bottom" />
      </div>
      <div class="box__text" data-reveal data-reveal-from="right">
        <h2 class="section-title">Sustainability</h2>
        <p class="box__lede">{SUSTAINABILITY_INTRO.lede}</p>
        <p class="box__body">
          Sustainability is the value everything else answers to: floor prices agreed before the
          season, traceability to the household, and progress reported as it is.
        </p>
        <a class="btn-solid" href="/sustainability/">Our sustainability approach</a>
      </div>
    </div>
  </section>

  <!-- Karusel kartu (Governance di Vale). -->
  <section class="explore">
    <div class="frame explore__head" data-reveal>
      <h2 class="section-title">Explore Adhiloka</h2>
      <p class="explore__sub">
        Sourcing, the works in Medan, the bench, and the catalog behind all of it.
      </p>
    </div>
    <div data-reveal="120">
      <SlideRail label="Explore Adhiloka">
        {
          EXPLORE.map((s) => (
            <Tile title={s.title} body={s.body} href={s.href} cta={s.cta} image={s.image} alt={s.shot} />
          ))
        }
      </SlideRail>
    </div>
  </section>

  <!-- Pita emas (Investors di Vale). Teks gelap: abu di atas emas cuma 3,9:1. -->
  <section class="band band--gold on-color">
    <div class="frame band__grid">
      <div class="band__text" data-reveal data-reveal-from="left">
        <h2 class="band__title">Perfumery</h2>
        <p class="band__lede">{PERFUMERY_INTRO.lede}</p>
        <a class="btn-solid" href="/perfumery/">Discover the perfumery</a>
      </div>
      <div class="band__media" data-curtain>
        {
          goldPhoto && (
            <Image
              src={goldPhoto}
              alt="A petal, close"
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Pita biru langit (Supplier di Vale). -->
  <section class="band band--sky on-color">
    <div class="frame band__grid">
      <div class="band__text" data-reveal data-reveal-from="left">
        <h2 class="band__title">{SAMPLE.title}</h2>
        <p class="band__lede">{SAMPLE.body}</p>
        <a class="btn-solid" href={SAMPLE.href}>{SAMPLE.cta}</a>
      </div>
      <div class="band__media" data-curtain>
        {
          skyPhoto && (
            <Image
              src={skyPhoto}
              alt={SAMPLE.shot}
              width={900}
              widths={[480, 900]}
              sizes="(max-width: 899px) 90vw, 45vw"
              loading="lazy"
              decoding="async"
              quality={66}
            />
          )
        }
        <Waves kind="corner" />
      </div>
    </div>
  </section>

  <!-- Karusel berita. NEWS masih kabar contoh (PLACEHOLDER di media.ts). -->
  <section class="news">
    <div class="frame news__head" data-reveal>
      <h2 class="section-title">News</h2>
      <a class="action-link" href="/media/news/">All news</a>
    </div>
    <div data-reveal="120">
      <SlideRail label="Latest news">
        {
          LATEST.map((a) => (
            <Tile
              title={a.title}
              body={a.standfirst}
              href={`/media/news/${a.slug}/`}
              cta="Read more"
              image={a.image}
              alt={a.shot}
              meta={`${formatDate(a.date)} · ${a.category}`}
            />
          ))
        }
      </SlideRail>
    </div>
    <div class="frame news__foot">
      <a class="btn-pill" href="/media/news/">Access all news</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Pembuka ────────────────────────────────────────────────────────── */
  .intro { padding: clamp(64px, 7vw, 110px) var(--gutter); }
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .intro__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--ink-body);
  }
  .intro__lede {
    margin-top: 24px;
    max-width: 36em;
    font-size: var(--type-lede);
    line-height: var(--leading-lede);
  }
  .intro__glance {
    margin-top: clamp(32px, 3.4vw, 48px);
    font-size: var(--type-h4);
    font-weight: 500;
    color: var(--teal);
  }
  .intro__stats {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
  }
  .intro__stat {
    padding-left: 16px;
    border-left: 3px solid var(--gold);
  }
  .intro__stat dt {
    font-size: clamp(30px, 2.6vw, 42px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--teal);
  }
  .intro__stat dd {
    margin: 4px 0 0;
    font-size: 16px;
    color: var(--ink-body);
  }
  .intro__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 4 / 3.4;
  }
  .intro__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* ── Kotak Sustainability ───────────────────────────────────────────── */
  .box { padding: clamp(48px, 6vw, 96px) var(--gutter); }
  .box__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .box__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 0.86;
  }
  .box__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .box__lede {
    margin-top: 24px;
    font-size: var(--type-lede);
    line-height: var(--leading-lede);
    color: var(--ink-body);
  }
  .box__body { margin-top: 16px; max-width: 34em; }
  .box__text :global(.btn-solid) { margin-top: 32px; }

  /* ── Karusel kartu ──────────────────────────────────────────────────── */
  .explore {
    padding: clamp(48px, 6vw, 96px) 0;
    background: var(--paper-sunk);
  }
  .explore__head { padding-inline: var(--gutter); margin-bottom: clamp(28px, 3vw, 44px); }
  .explore__sub { margin-top: 12px; max-width: 40em; font-size: var(--type-lede); }

  /* ── Pita emas / biru langit ────────────────────────────────────────── */
  .band { padding: clamp(56px, 6vw, 96px) var(--gutter); color: var(--ink); }
  .band--gold { background: var(--gold); --wave-ground: var(--gold); --wave-accent: var(--teal); }
  .band--sky { background: var(--sky); --wave-ground: var(--sky); }
  .band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .band__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--ink);
  }
  .band__lede {
    margin-top: 22px;
    max-width: 32em;
    font-size: var(--type-lede);
    line-height: var(--leading-lede);
    color: var(--ink);
  }
  .band__text :global(.btn-solid) { margin-top: 32px; }
  .band__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 16 / 11;
  }
  .band__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* ── Berita ─────────────────────────────────────────────────────────── */
  .news { padding: clamp(56px, 6vw, 96px) 0; }
  .news__head {
    padding-inline: var(--gutter);
    margin-bottom: clamp(28px, 3vw, 44px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .news :global(.tile__text) { background: var(--paper-sunk); }
  .news__foot {
    padding: clamp(28px, 3vw, 44px) var(--gutter) 0;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 899px) {
    .intro__grid,
    .box__grid,
    .band__grid { grid-template-columns: 1fr; }
    .band__media { order: -1; }
  }
</style>
