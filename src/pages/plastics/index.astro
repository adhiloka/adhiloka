---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import LineCatalog from '../../components/blocks/LineCatalog.astro';
import { PACKAGING_INTRO, PACKAGING_OPENING } from '../../data/pages/packaging-line';

/* Halaman lini (pemilik, 27 Nov 2026): overview singkat, lalu katalog di
   bawahnya seperti Ingredient Catalog (cari, tab kategori, kartu item).
   Rincian (jenis, bentuk, ukuran, kode) ada di halaman item dan kode. */
---

<PageLayout intro={PACKAGING_INTRO}>
  <Intro title={PACKAGING_OPENING.title} paragraphs={PACKAGING_OPENING.paragraphs}>
    <p class="line__btns">
      <a class="btn" href="/contact/?business=packaging&kind=quotation"><span class="btn__label">Request a Quotation</span></a>
    </p>
  </Intro>
  <LineCatalog line="packaging" />
</PageLayout>

<style>
  .line__btns { margin-top: 32px; }
</style>
