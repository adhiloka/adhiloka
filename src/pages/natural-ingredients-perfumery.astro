---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import BusinessSubnav from '../components/blocks/BusinessSubnav.astro';
import QuoteSplit from '../components/QuoteSplit.astro';
import BusinessShowcase from '../components/home/BusinessShowcase.astro';
import SustainAccordion from '../components/home/SustainAccordion.astro';
import NewsCards from '../components/NewsCards.astro';
import JoinUs from '../components/home/JoinUs.astro';
import { NATURALS_HERO_SLIDES, HOME_QUOTE, NATURALS_PANES } from '../data/pages/home';
import { NEWS, byDate } from '../data/pages/media';

/* Beranda lini Natural Ingredients & Perfumery (situs grup, 26 Nov 2026):
   isi beranda adhiloka.com sebelum jadi situs grup, dipindah apa adanya
   (hero empat slide final 21 Nov, Our Business empat tile final 22 Nov),
   ditambah bilah sub-menu lini di bawah hero. */
const latest = [...NEWS].sort(byDate).slice(0, 3);
---

<BaseLayout
  title="Natural Ingredients & Perfumery"
  description="Adhiloka supplies natural aromatic ingredients from Indonesia, from benzoin and patchouli to roots and spices, and creates fragrances in its own perfumery."
>
  <HeroSlider slides={NATURALS_HERO_SLIDES} />
  <BusinessSubnav />
  <QuoteSplit {...HOME_QUOTE} />
  <BusinessShowcase panes={NATURALS_PANES} />
  <SustainAccordion />
  <NewsCards title="Latest News" viewAll="/media/news/" articles={latest} />
  <JoinUs />
</BaseLayout>
