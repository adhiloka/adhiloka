---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import Feature from '../../components/blocks/Feature.astro';
import { PACKAGING_CATEGORIES } from '../../data/packaging';
import { lineCategoryHref } from '../../data/line-products';
import { PACKAGING_INTRO, PACKAGING_OPENING, PACKAGING_GRADES, PACKAGING_STEPS } from '../../data/pages/packaging-line';

/* Beranda lini Plastics & Packaging (situs grup, 26 Nov 2026): pembuka ·
   kategori produk (menuju katalog per kategori) · grade & proses · cara memesan. */
const cats = PACKAGING_CATEGORIES.map((c) => ({ title: c.label, body: c.body, href: lineCategoryHref('packaging', c.key), linkLabel: 'View Products' }));
---

<PageLayout intro={PACKAGING_INTRO}>
  <Intro title={PACKAGING_OPENING.title} paragraphs={[PACKAGING_OPENING.body]} />
  <InfoGrid id="products" title="Our Products" items={cats} cols={3} grey />
  <Feature id="grades" heading={PACKAGING_GRADES.heading} body={PACKAGING_GRADES.body} image="pk-grades" alt="Plastic film coming off a blown film line" />
  <InfoGrid id="working-with-us" title="Working With Us" items={PACKAGING_STEPS} cols={3} grey>
    <p class="line__btns">
      <a class="btn" href="/contact/?business=packaging&kind=quotation"><span class="btn__label">Request a Quotation</span></a>
      <a class="btn" href="/plastics-packaging/products/"><span class="btn__label">Plastics &amp; Packaging Products</span></a>
    </p>
  </InfoGrid>
</PageLayout>

<style>
  .line__btns { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 48px; }
</style>
