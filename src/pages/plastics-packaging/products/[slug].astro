---
import LineProductPage from '../../../components/blocks/LineProductPage.astro';
import { PACKAGING_PRODUCTS } from '../../../data/packaging';
import type { LineProduct } from '../../../data/line-products';

export function getStaticPaths() {
  return PACKAGING_PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: LineProduct };
---

<LineProductPage p={p} />
