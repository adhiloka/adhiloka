---
import PageLayout from '../layouts/PageLayout.astro';
import Intro from '../components/blocks/Intro.astro';
import Feature from '../components/blocks/Feature.astro';
import { BUSINESSES } from '../data/businesses';
import { OUR_BUSINESSES_INTRO, OUR_BUSINESSES_OPENING, BUSINESS_BODY } from '../data/pages/group';

/* Our Businesses (situs grup, 26 Nov 2026), pola adani.com/businesses:
   banner, pembuka, satu blok bergambar per lini yang menaut ke beranda lini.
   Foto blok = foto beranda lini (businesses.ts), jadi satu konteks. */
---

<PageLayout intro={OUR_BUSINESSES_INTRO}>
  <Intro title={OUR_BUSINESSES_OPENING.title} paragraphs={[OUR_BUSINESSES_OPENING.body]} />
  {
    BUSINESSES.map((b, i) => (
      <Feature
        id={b.key}
        heading={b.name}
        body={BUSINESS_BODY[b.key]}
        cta="Explore More"
        href={b.href}
        image={b.image}
        alt={b.alt}
        flip={i % 2 === 1}
        grey={i % 2 === 0}
      />
    ))
  }
</PageLayout>
