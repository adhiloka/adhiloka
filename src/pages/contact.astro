---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { OFFICES, ENQUIRY_KINDS, CONTACT_INTRO, CONTACT_HERO } from '../data/pages/contact';
import { MATERIALS } from '../data/materials';
import { SITE } from '../data/site';

// Peta slug ke nama, supaya tautan ?material=nutmeg-mace terisi sebagai
// "Nutmeg & Mace" dan bukan hasil tebakan dari slug.
const materialNames = Object.fromEntries(MATERIALS.map((m) => [m.slug, m.name]));

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? 'https://api.web3forms.com/submit';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
const configured = accessKey.length > 0;
---

<BaseLayout
  title="Contact"
  description={CONTACT_INTRO.description}
  headerVariant="over-dark"
  active="/contact/"
>
  {/* Section 1: hero foto penuh layar, sama seperti halaman hub. Kepala halaman
      bergaris yang dulu ada di sini digantikan olehnya. */}
  <Hero slides={CONTACT_HERO} label="Contact" />

  <section class="section section--lg contact">
    <div class="frame contact__grid">
      <div class="contact__form-col">
        <!-- Keadaan terkirim -->
        <div class="sent" data-sent hidden>
          <span class="sent__title">Thank you — we have it.</span>
          <span class="sent__body">
            Someone from the sourcing team will reply within two working days. Sample sets ship from
            Medan on Tuesdays and Fridays.
          </span>
          <button type="button" class="sent__again" data-reset>Send another</button>
        </div>

        <form
          class="form"
          data-form
          data-endpoint={endpoint}
          data-configured={String(configured)}
          data-materials={JSON.stringify(materialNames)}
          method="post"
          action={endpoint}
          novalidate
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value="Enquiry from adhiloka.com" />
          <input type="hidden" name="from_name" value="Adhiloka website" />
          <!-- Perangkap bot: manusia tidak pernah mengisi kolom ini. -->
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />

          <div class="form__row">
            <label class="field">
              <span class="field__label">Name</span>
              <input
                type="text"
                name="name"
                placeholder="Your name"
                autocomplete="name"
                required
                aria-describedby="err-name"
              />
              <span class="field__error" id="err-name" data-error-for="name"></span>
            </label>

            <label class="field">
              <span class="field__label">Company</span>
              <input
                type="text"
                name="company"
                placeholder="Fragrance house, brand, lab"
                autocomplete="organization"
              />
            </label>
          </div>

          <div class="form__row">
            <label class="field">
              <span class="field__label">Email</span>
              <input
                type="email"
                name="email"
                placeholder="name@company.com"
                autocomplete="email"
                required
                aria-describedby="err-email"
              />
              <span class="field__error" id="err-email" data-error-for="email"></span>
            </label>

            <label class="field">
              <span class="field__label">Enquiry</span>
              <select name="kind" data-kind>
                {ENQUIRY_KINDS.map((k) => <option value={k}>{k}</option>)}
              </select>
            </label>
          </div>

          <label class="field">
            <span class="field__label">Brief</span>
            <textarea
              rows="5"
              name="message"
              placeholder="Materials, volumes, timing, specification"
              required
              aria-describedby="err-message"></textarea>
            <span class="field__error" id="err-message" data-error-for="message"></span>
          </label>

          <div class="form__foot">
            <button type="submit" class="btn-solid" data-submit>
              <span data-submit-label>Send enquiry</span>
              <span aria-hidden="true">&#8594;</span>
            </button>

            <p class="form__status" role="status" aria-live="polite" data-status></p>
          </div>

          {
            !configured && (
              <p class="form__notice">
                Delivery is not connected yet, so this button opens your email client instead. To
                post enquiries straight to the sourcing desk, set{' '}
                <code>PUBLIC_FORM_ACCESS_KEY</code> in <code>.env</code> — see{' '}
                <code>.env.example</code>. You can also write to{' '}
                <a href={`mailto:${SITE.email}`}>{SITE.email}</a> directly.
              </p>
            )
          }
        </form>
      </div>

      <div class="offices" id="offices">
        {
          OFFICES.map((o) => (
            <div class="office">
              <span class="office__role">{o.role}</span>
              <span class="office__city">{o.city}</span>
              <span class="office__line">{o.address}</span>
              <a class="office__line office__contact" href={o.href}>
                {o.contact}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initContactForm } from '../scripts/contact-form';
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(32px, 5vw, 96px);
    align-items: start;
  }
  .contact__form-col { min-width: 0; grid-column: span 2; }

  /* ── Formulir ──────────────────────────────────────────────────────── */
  .form {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 34px);
  }
  .form[hidden] { display: none; }

  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(20px, 2.4vw, 34px);
  }

  .field { display: flex; flex-direction: column; gap: 9px; }
  .field__label {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-label);
  }
  .field input,
  .field select,
  .field textarea {
    padding: 9px 0;
    border-bottom: 1px solid var(--border-field);
    border-radius: 0;
    font-size: 15px;
    font-weight: 400;
    transition: border-color var(--dur-fast) ease;
  }
  .field textarea { resize: vertical; line-height: 1.7; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus { border-bottom-color: var(--ink); }
  .field :is(input, select, textarea):focus-visible {
    outline-offset: 4px;
  }
  .field [aria-invalid='true'] { border-bottom-color: var(--gold-clay); }

  .field__error {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--gold-clay);
  }
  .field__error:empty { display: none; }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 6px;
  }
  .btn-solid[data-busy='true'] { opacity: 0.65; pointer-events: none; }

  .form__status { font-size: 14px; line-height: 1.6; color: var(--text-body); }
  .form__status[data-tone='error'] { color: var(--gold-clay); }

  .form__notice {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-body);
    padding: 14px 16px;
    background: var(--stone-1);
    border-left: 2px solid var(--rule-strong);
  }
  .form__notice code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }
  .form__notice a { border-bottom: 1px solid currentColor; }

  /* ── Keadaan terkirim ──────────────────────────────────────────────── */
  .sent {
    padding: clamp(28px, 4vw, 56px);
    background: var(--stone-2);
    display: flex;
    flex-direction: column;
    gap: 15px;
    animation: rise 600ms var(--ease-glide) both;
  }
  .sent[hidden] { display: none; }
  .sent__title {
    font-family: var(--font-display);
    font-size: clamp(21px, 2.4vw, 36px);
    line-height: 1.2;
    color: var(--teal);
    font-weight: 500;
  }
  .sent__body {
    font-size: 14px;
    line-height: 1.74;
    color: var(--text-body);
    max-width: 34em;
  }
  .sent__again {
    align-self: flex-start;
    margin-top: 8px;
    font-size: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--stone-8);
    font-weight: 500;
  }

  /* ── Kantor ────────────────────────────────────────────────────────── */
  .offices {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 38px);
  }
  .office {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border-hairline);
  }
  .office__role {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .office__city { font-family: var(--font-display); font-size: clamp(17px, 1.6vw, 26px);
    color: var(--teal);
    font-weight: 500;
  }
  .office__line { font-size: 15px; line-height: 1.74; color: var(--text-body); }
  .office__contact { align-self: flex-start; border-bottom: 1px solid var(--border-hairline); }
</style>
