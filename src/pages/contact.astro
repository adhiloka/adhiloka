---
import PageLayout from '../layouts/PageLayout.astro';
import { OFFICES, ENQUIRY_KINDS, CONTACT_INTRO } from '../data/pages/contact';
import { MATERIAL_NAMES } from '../data/material-names';
import { BUSINESSES } from '../data/businesses';
import { LINE_CATALOG, type LineItem } from '../data/line-products';
import SiblingCards from '../components/blocks/SiblingCards.astro';

/* Contact ala adani.com/contact-us: banner, lalu formulir di kiri dan
 * alamat kantor di kanan.
 * 28 Nov 2026 malam (pemilik: "maunya dia ketik disitu udh terkirim langsung
 * ke kita"): formulir dikirim lewat Netlify Forms (situs di-host Netlify),
 * tanpa kunci dan tanpa membuka klien email. Kiriman masuk ke Netlify > Forms
 * > enquiry dan diteruskan ke info@adhiloka.com lewat notifikasi email formulir
 * itu. Web3Forms dipakai hanya bila PUBLIC_FORM_ACCESS_KEY diisi. */

// Peta slug ke nama, supaya ?material=nutmeg-mace terisi "Nutmeg & Mace".
// Situs grup (26 Nov 2026): produk seafood dan plastik ikut, lewat ?product=slug.
const materialNames = {
  ...MATERIAL_NAMES,
  ...Object.fromEntries(([...LINE_CATALOG.seafood.items, ...LINE_CATALOG.packaging.items] as LineItem[]).map((i) => [i.slug, i.name])),
};

const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
const provider = accessKey ? 'web3forms' : 'netlify';
const endpoint = accessKey ? (import.meta.env.PUBLIC_FORM_ENDPOINT ?? 'https://api.web3forms.com/submit') : '/';
---

<PageLayout intro={CONTACT_INTRO} bannerTitle="Contact Us">
  <section class="sec">
    <div class="wrap contact">
      <div class="contact__form">
        <h2 class="h2" data-anim="title">Get in Touch</h2>

        <div class="sent" data-sent hidden>
          <p class="sent__title">Thank you. We will reply by email.</p>
          <button type="button" class="btn" data-reset><span class="btn__label">Send another</span></button>
        </div>

        <form
          class="form"
          name="enquiry"
          data-form
          data-provider={provider}
          data-endpoint={endpoint}
          data-materials={JSON.stringify(materialNames)}
          method="post"
          action="/contact/?sent=1"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <input type="hidden" name="subject" value="Enquiry from adhiloka.com" />
          {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
          <p class="sr-only" aria-hidden="true">
            <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="form__row">
            <label class="field">
              <span class="field__label">Name*</span>
              <input type="text" name="name" autocomplete="name" required aria-describedby="err-name" />
              <span class="field__error" id="err-name" data-error-for="name"></span>
            </label>
            <label class="field">
              <span class="field__label">Company</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
          </div>

          <div class="form__row">
            <label class="field">
              <span class="field__label">Email*</span>
              <input type="email" name="email" autocomplete="email" required aria-describedby="err-email" />
              <span class="field__error" id="err-email" data-error-for="email"></span>
            </label>
            <label class="field">
              <span class="field__label">Enquiry</span>
              <select name="kind" data-kind>
                {ENQUIRY_KINDS.map((k) => <option value={k}>{k}</option>)}
              </select>
            </label>
          </div>

          <label class="field">
            <span class="field__label">Business</span>
            <select name="business" data-business>
              <option value="Adhiloka Group">Adhiloka Group</option>
              {BUSINESSES.map((b) => <option value={b.name} data-key={b.key}>{b.name}</option>)}
            </select>
          </label>
          <label class="field">
            <span class="field__label">Message*</span>
            <textarea rows="5" name="message" placeholder="Product, quantity, specification, timing" required aria-describedby="err-message"></textarea>
            <span class="field__error" id="err-message" data-error-for="message"></span>
          </label>

          <div class="form__foot">
            <button type="submit" class="btn" data-submit><span class="btn__label" data-submit-label>Send enquiry</span></button>
            <p class="form__status" role="status" aria-live="polite" data-status></p>
          </div>

        </form>
      </div>

      <aside class="offices" aria-label="Our offices" data-anim="columns">
        {
          OFFICES.map((o) => (
            <div class="office" data-anim-item>
              <p class="office__role">{o.role}</p>
              <h3 class="office__city">{o.city}</h3>
              <p class="office__line">{o.address}</p>
              <a class="office__contact" href={o.href}>{o.contact}</a>
            </div>
          ))
        }
      </aside>
    </div>
  </section>
  <SiblingCards />
</PageLayout>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 34%;
    gap: 8%;
    align-items: start;
  }
  .contact__lead { margin-top: 20px; }

  .form { display: flex; flex-direction: column; gap: 28px; margin-top: 40px; }
  .form[hidden] { display: none; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field__label { font-size: calc(14px * var(--fs)); letter-spacing: 0.03em; color: var(--ink-muted); }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: calc(16px * var(--fs));
    color: var(--ink);
    background: var(--bg);
    transition:
      border-color var(--t-fast) var(--ease-std),
      box-shadow var(--t-fast) var(--ease-std);
  }
  .field input,
  .field select { height: 52px; }
  .field ::placeholder { color: var(--ink-muted); opacity: 0.75; }
  .field textarea { min-height: 148px; resize: vertical; line-height: 1.6; }
  /* Panah pilihan digambar sendiri (segitiga 5 px seperti pemilih di header),
     pengganti panah bawaan peramban yang berbeda di tiap sistem. */
  .field select {
    padding-right: 44px;
    -webkit-appearance: none;
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 22px) 50%, calc(100% - 17px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: var(--ink-muted); }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--brand-green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-green-light) 22%, transparent);
    outline: none;
  }
  .field :global([aria-invalid='true']) { border-color: var(--error); }
  .field__error { font-size: calc(14px * var(--fs)); color: var(--error); }
  /* Slot galat kosong tidak makan tempat: jarak antarbaris formulir sama rata. */
  .field__error:empty { display: none; }
  .form__foot { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .form__status { font-size: calc(15px * var(--fs)); color: var(--ink-muted); }
  .form__notice { font-size: calc(14px * var(--fs)); line-height: 1.6; color: var(--ink-muted); }
  .form__notice a { text-decoration: underline; }

  .sent { margin-top: 40px; padding: 32px; background: var(--bg-grey); }
  .sent__title { margin-bottom: 24px; font-size: calc(24px * var(--fs)); font-weight: 530; }
  .sent__body { margin: 12px 0 24px; font-size: calc(17px * var(--fs)); line-height: 1.6; }

  .offices { display: flex; flex-direction: column; }
  .office { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .office:first-child { padding-top: 0; }
  .office__role { font-size: calc(14px * var(--fs)); color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .office__city { margin-top: 8px; font-size: calc(24px * var(--fs)); font-weight: 530; color: var(--ink); }
  .office__line { margin-top: 10px; font-size: calc(16px * var(--fs)); line-height: 1.6; }
  .office__contact {
    display: inline-block;
    margin-top: 10px;
    font-size: calc(16px * var(--fs));
    font-weight: 440;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--t) var(--ease-std);
  }
  .office__contact:hover { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .contact { grid-template-columns: 1fr; gap: 56px; }
  }
  @media (max-width: 600px) {
    .form__row { grid-template-columns: 1fr; }
  }
</style>
