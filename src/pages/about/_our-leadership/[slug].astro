---
import { Image } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import { images } from '../../../data/images';
import { LEADERSHIP, LEADERSHIP_INTRO, LEADER_BODY, leaderSlug, leaderHref, type Leader } from '../../../data/pages/about';

/* Profil pimpinan ala adani.com/about-us/leadership/<nama>: kolom kiri berisi
 * potret (dan Download Image bila fotonya ada) yang menempel selama bio
 * digulir (pin dari inner-page.js Adani), kolom kanan jabatan, nama dan bio,
 * lalu strip "Meet Our Leaders" dengan pimpinan sebelum/sesudahnya dan View
 * All (`otherleadership`). */
export function getStaticPaths() {
  return LEADERSHIP.map((leader, i) => ({
    params: { slug: leaderSlug(leader) },
    props: {
      leader,
      prev: LEADERSHIP[(i - 1 + LEADERSHIP.length) % LEADERSHIP.length],
      next: LEADERSHIP[(i + 1) % LEADERSHIP.length],
    },
  }));
}

const { leader, prev, next } = Astro.props as { leader: Leader; prev: Leader; next: Leader };
const photo = leader.image ? images[leader.image] : undefined;
const intro = {
  title: leader.name,
  lede: leader.role,
  description: leader.bio,
  image: LEADERSHIP_INTRO.image,
  caption: LEADERSHIP_INTRO.caption,
};
---

<PageLayout intro={intro} lineInBanner>
  <section class="sec prof" data-no-panel>
    <div class="wrap prof__grid" data-pin-scope>
      <div class="prof__side" data-pin>
        <span class="prof__photo cover">
          {photo ? <Image quality={75} src={photo} alt={leader.name} widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" /> : <span class="plate">{leader.shot}</span>}
        </span>
        {
          photo && (
            <a class="btn prof__dl" href={photo.src} download>
              <span class="btn__label">Download Image</span>
            </a>
          )
        }
      </div>
      <div class="prof__main">
        <p class="prof__role" data-anim="title">{leader.role}</p>
        <h2 class="h2 prof__name" data-anim="title">{leader.name}</h2>
        <div class="prose prof__bio" data-anim="sub">
          <p>{leader.bio}</p>
          {LEADER_BODY.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--grey meet">
    <div class="wrap">
      <div class="head-row">
        <h2 class="h2" data-anim="title">Meet Our Leaders</h2>
        <a class="btn" href="/about/our-leadership/" data-anim="title"><span class="btn__label">View All</span></a>
      </div>
      <ul class="meet__grid" data-anim="columns">
        {
          [
            { dir: 'Previous', p: prev },
            { dir: 'Next', p: next },
          ].map(({ dir, p }) => (
            <li data-anim-item>
              <a class:list={['meet__card', { 'meet__card--next': dir === 'Next' }]} href={leaderHref(p)}>
                <span class="meet__dir">
                  <svg viewBox="0 0 16 12" width="16" height="12" aria-hidden="true"><path d="M0 6h14M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                  {dir}
                </span>
                <span class="meet__row">
                  <span class="meet__photo cover">
                    {p.image ? <Image quality={70} src={images[p.image]} alt="" widths={[200]} sizes="120px" loading="lazy" /> : <span class="plate" />}
                  </span>
                  <span>
                    <span class="meet__name">{p.name}</span>
                    <span class="meet__role">{p.role}</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .prof__grid {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 8%;
    align-items: start;
  }
  .prof__photo { display: block; aspect-ratio: 3 / 4; }
  .prof__dl { margin-top: 24px; }
  .prof__role {
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .prof__name { margin-top: 16px; }
  .prof__bio { margin-top: 36px; max-width: 760px; }

  .meet__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4%;
    margin-top: 48px;
  }
  .meet__card {
    display: block;
    height: 100%;
    padding: 28px;
    background: var(--bg);
    transition: background-color 0.7s;
  }
  .meet__card:hover { background: #fafafa; }
  .meet__dir {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .meet__card:not(.meet__card--next) .meet__dir svg { transform: rotate(180deg); }
  .meet__row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 20px;
  }
  .meet__photo {
    flex: none;
    width: 96px;
    aspect-ratio: 1;
  }
  .meet__name { display: block; font-size: calc(20px * var(--fs)); font-weight: 440; color: var(--ink); }
  .meet__role { display: block; margin-top: 6px; font-size: calc(16px * var(--fs)); color: var(--ink-muted); }
  .meet__card:hover .meet__name { text-decoration: underline; text-underline-offset: 5px; }

  @media (max-width: 1026px) {
    .prof__grid { grid-template-columns: 1fr; gap: 40px; }
    .prof__photo { max-width: 360px; }
  }
  @media (max-width: 767px) {
    .meet__grid { grid-template-columns: 1fr; gap: 16px; }
  }
  :global(html.dark-mode) .meet__card:hover { background: #0d0d0d; }
</style>
