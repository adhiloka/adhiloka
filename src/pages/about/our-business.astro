---
import PageLayout from '../../layouts/PageLayout.astro';
import Band from '../../components/Band.astro';
import Interlude from '../../components/Interlude.astro';
import { BUSINESS_INTRO, BUSINESS_PASSAGES } from '../../data/pages/about';
import { groundAt, bridgeAfter } from '../../data/ground';
---

<PageLayout intro={BUSINESS_INTRO} section="/about/">
  {
    BUSINESS_PASSAGES.map((p, i) => (
      <Band
        id={p.id}
        eyebrow={p.eyebrow}
        title={p.title}
        body={p.body}
        points={p.points}
        cta={p.cta}
        href={p.href}
        caption={p.caption}
        image={p.image}
        reverse={i % 2 === 1}
        ground={groundAt(i)}
      />
    ))
  }

  <section class="bridge" style={`--bridge-bg:${bridgeAfter(groundAt(BUSINESS_PASSAGES.length - 1))}`}>
    <Interlude
      class="frame"
      line="Three activities, one chain of custody."
      href="/sustainability/responsible-sourcing/"
      cta="Responsible sourcing"
      italic
    />
  </section>
</PageLayout>

<style>
  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
