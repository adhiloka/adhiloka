---
import PageLayout from '../../layouts/PageLayout.astro';
import PeopleGrid from '../../components/PeopleGrid.astro';
import Interlude from '../../components/Interlude.astro';
import { LEADERSHIP_INTRO, LEADERSHIP } from '../../data/pages/about';
---

<PageLayout intro={LEADERSHIP_INTRO} section="/about/" media={false}>
  <section class="section">
    <div class="frame">
      <span class="eyebrow" data-reveal="0">Executive leadership</span>
      <div class="people-wrap">
        <PeopleGrid people={LEADERSHIP} />
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="frame gov">
      <h2 class="gov__title" data-lines>Ownership and governance</h2>
      <div class="gov__cols">
        <p class="prose" data-reveal="70">
          Quisquam ex similique iure in vel proident labore rem eum ipsam atque commodi commodo. Atque
          ab et veritatis eligendi quas ab fugiat ea, earum ex est quam facere ea quasi autem aut id
          quo cumque ea labore magnam odit nobis in.
        </p>
        <p class="prose" data-reveal="130">
          Eum rerum optio ipsa earum ab quod eum incidunt est tempore quas commodo non magnam.
          Deleniti itaque, eum similique nesciunt rem nam iure occaecat eum mollitia irure ad atque
          eiusmod facere quos id libero minima.
        </p>
      </div>
    </div>
  </section>

  <section class="bridge">
    <Interlude
      class="frame"
      line="Est labore lorem tempor quo non animi nisi ad nam aperiam."
      href="/sustainability/people/"
      cta="Driving progress for people"
      italic
    />
  </section>
</PageLayout>

<style>
  .people-wrap { margin-top: clamp(26px, 3vw, 44px); }
  .section--sunk { background: var(--paper-sunk); }

  .gov__title {
    font-size: var(--type-h2);
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
    max-width: 16em;
  }
  .gov__cols {
    margin-top: clamp(20px, 2.4vw, 34px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3vw, 56px);
  }

  .bridge { background: var(--paper); padding: var(--section-y) var(--gutter); }
</style>
