---
import PageLayout from '../../layouts/PageLayout.astro';
import PeopleGrid from '../../components/PeopleGrid.astro';
import Interlude from '../../components/Interlude.astro';
import { LEADERSHIP_INTRO, LEADERSHIP } from '../../data/pages/about';
---

<PageLayout intro={LEADERSHIP_INTRO} section="/about/" media={false}>
  <section class="section bg-tint-teal">
    <div class="frame">
      <span class="eyebrow" data-reveal="0">Executive leadership</span>
      <div class="people-wrap">
        <PeopleGrid people={LEADERSHIP} />
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="frame gov">
      <h2 class="gov__title" data-lines>Ownership and governance</h2>
      <div class="gov__cols">
        <p class="prose" data-reveal="70">
          Adhiloka is privately held by the founding family and has never taken outside
          capital. There is no quarterly earnings call to answer to, which is the main
          reason a floor price can be set before a season rather than after it.
        </p>
        <p class="prose" data-reveal="130">
          The board meets four times a year and includes two members from outside the
          family. Purchase policy, the household register and the land position are
          standing items at every meeting rather than an annual review.
        </p>
      </div>
    </div>
  </section>

  <section class="bridge" style={`--bridge-bg:${'var(--tint-gold)'}`}>
    <Interlude
      class="frame"
      line="The people above answer for the price paid at the station."
      href="/sustainability/people/"
      cta="Driving progress for people"
      italic
    />
  </section>
</PageLayout>

<style>
  .people-wrap { margin-top: clamp(26px, 3vw, 44px); }
  .section--sunk { background: var(--paper); }

  .gov__title {
    font-size: var(--type-h2);
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
    max-width: 16em;
  }
  .gov__cols {
    margin-top: clamp(20px, 2.4vw, 34px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3vw, 56px);
  }

  .bridge { background: var(--bridge-bg, var(--paper)); padding: var(--section-y) var(--gutter); }
</style>
