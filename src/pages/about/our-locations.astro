---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/blocks/Intro.astro';
import LocationCards from '../../components/blocks/LocationCards.astro';
import SiblingCards from '../../components/blocks/SiblingCards.astro';
import { LOCATIONS_INTRO, SITES } from '../../data/pages/about';
---

<PageLayout intro={{ ...LOCATIONS_INTRO, image: 'agroforest-canopy', caption: 'Tree canopy seen from below' }}>
  <Intro title="Within a day of each other" paragraphs={[LOCATIONS_INTRO.lede]} />
  <LocationCards sites={SITES} />
  <SiblingCards />
</PageLayout>
