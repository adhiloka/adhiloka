---
import PageLayout from '../../layouts/PageLayout.astro';
import LocationList from '../../components/LocationList.astro';
import Interlude from '../../components/Interlude.astro';
import { LOCATIONS_INTRO, SITES } from '../../data/pages/about';

const stations = SITES.filter((s) => s.kind === 'Commodo sit amet');
const rest = SITES.filter((s) => s.kind !== 'Commodo sit amet');
---

<PageLayout intro={LOCATIONS_INTRO} section="/about/">
  <section class="section">
    <div class="frame">
      <div class="section__head">
        <span class="eyebrow" data-reveal="0">Ipsum non placeat</span>
        <span class="section__count" data-reveal="60">{rest.length}</span>
      </div>
      <div class="section__grid">
        <LocationList sites={rest} />
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="frame">
      <div class="section__head">
        <span class="eyebrow" data-reveal="0">Voluptatem expedita</span>
        <span class="section__count" data-reveal="60">{stations.length}</span>
      </div>
      <p class="prose stations__note" data-reveal="90">
        Ipsam dolores vero deleniti enim sit laboriosam cumque ut sit unde id eos vel. Maiores do
        est ducimus autem laboris et ullamco ea consequuntur.
      </p>
      <div class="section__grid">
        <LocationList sites={stations} />
      </div>
    </div>
  </section>

  <section class="bridge">
    <Interlude
      class="frame"
      line="Odio ea mollitia ut odio ea quis, non cum."
      href="/sustainability/responsible-sourcing/"
      cta="Responsible sourcing"
      italic
    />
  </section>
</PageLayout>

<style>
  .section--sunk { background: var(--paper-sunk); }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .section__count {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .stations__note { margin-top: clamp(18px, 2vw, 26px); }
  .section__grid { margin-top: clamp(26px, 3vw, 44px); }

  .bridge { background: var(--paper); padding: var(--section-y) var(--gutter); }
</style>
