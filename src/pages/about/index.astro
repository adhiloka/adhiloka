---
import PageLayout from '../../layouts/PageLayout.astro';
import QuoteSplit from '../../components/QuoteSplit.astro';
import Feature from '../../components/blocks/Feature.astro';
import VisionSlider from '../../components/blocks/VisionSlider.astro';
import InfoGrid from '../../components/blocks/InfoGrid.astro';
import CardGrid from '../../components/blocks/CardGrid.astro';
import {
  ABOUT_INTRO,
  ABOUT_OPENING,
  ABOUT_HOW,
  ABOUT_CARDS,
  ABOUT_MORE,
  PURPOSE_VALUES,
} from '../../data/pages/about';
import { HOME_QUOTE } from '../../data/pages/home';

/* Susunan halaman /about-us adani.com: banner, kutipan terbelah, visi
 * (slider foto fade), konten + foto, nilai, kartu. Angka sekilas, pimpinan
 * dan teaser Our Journey dilepas 10 Nov 2026 sampai datanya ada (lihat
 * catatan "Diparkir" di data/pages/about.ts). "Awards & Accolades" dilewati:
 * tidak ada penghargaan untuk dicantumkan. */
---

<PageLayout intro={ABOUT_INTRO} bannerTitle="About Us">
  <QuoteSplit
    text={HOME_QUOTE.text}
    name={HOME_QUOTE.name}
    role={HOME_QUOTE.role}
    cta="Our Purpose"
    href="/about/our-purpose/"
    image="agroforest-canopy"
    alt="Tree canopy seen from below"
  />

  <VisionSlider
    heading="Who We Are"
    subheading={ABOUT_INTRO.title}
    body={[ABOUT_INTRO.lede, ABOUT_OPENING[0]]}
    slides={[
      { image: 'material-benzoin', alt: 'Sorted benzoin resin tears' },
      { image: 'fragrance-resin', alt: 'Resin pieces, close' },
      { image: 'material-nutmeg', alt: 'Nutmeg, close' },
    ]}
  />

  <Feature
    heading="How We Work"
    subheading={ABOUT_HOW}
    body={ABOUT_OPENING[1]}
    cta="Our Business"
    href="/about/our-business/"
    image="hero-benzoin-tears"
    alt="Cassia bark, close"
    flip
  />


  <InfoGrid title="Our Values" items={PURPOSE_VALUES} grey />

  <CardGrid title="Explore More" cards={[...ABOUT_CARDS, ABOUT_MORE]} />
</PageLayout>
