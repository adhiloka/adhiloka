---
import { Font, getImage } from 'astro:assets';
import { SITE } from '../data/site';
import { images } from '../data/images';
import SiteHeader from '../components/SiteHeader.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Jalur aktif untuk penanda menu; default dari URL saat ini. */
  active?: string;
  ogImage?: string;
}

const { title, description, active = Astro.url.pathname, ogImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;

// Kartu bagikan: JPEG 1200×630 dihasilkan saat build.
const og = await getImage({
  src: images['material-benzoin'],
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 76,
});
const ogImageUrl = new URL(ogImage ?? og.src, Astro.site ?? Astro.url.origin).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  alternateName: SITE.name,
  url: (Astro.site ?? Astro.url.origin).toString(),
  logo: new URL('/brand/adhiloka-lockup-1000w.png', Astro.site ?? Astro.url.origin).toString(),
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phone,
  // foundingDate dan address dilepas selama naskah berupa lorem ipsum: tahun
  // 1840 dan alamat Medan belum terverifikasi. Pasang lagi dari data asli.
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-sans" preload />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader active={active} />
    <SearchOverlay />

    <!-- Pembungkus ScrollSmoother (scripts/scroll-fx.ts). Elemen fixed (header,
         panel pencarian, tombol ke atas) harus tetap di luarnya. -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main" tabindex="-1">
          <slot />
        </main>

        <SiteFooter />
      </div>
    </div>
    <BackToTop />

    <script>
      import { initScrollFx } from '../scripts/scroll-fx';
      initScrollFx();
    </script>
  </body>
</html>
