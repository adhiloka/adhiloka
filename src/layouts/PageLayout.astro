---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SiblingNav from '../components/SiblingNav.astro';
import type { PageIntro } from '../data/pages/types';

/**
 * Kerangka halaman dalam: kepala halaman, bilah saudara, lalu isi. Dua puluh
 * halaman memakai susunan yang sama; tanpa layout ini tiap halaman mengulang
 * blok yang identik.
 *
 * `section` adalah href induk di NAV — dari situ breadcrumb dan bilah saudara
 * menemukan sendiri label dan daftarnya.
 */
interface Props {
  intro: PageIntro;
  section?: string;
  size?: 'hub' | 'page';
  media?: boolean;
  /** Bilah saudara disembunyikan di halaman hub yang sudah menampilkan kartu. */
  subnav?: boolean;
  /** Kepala halaman jadi foto penuh layar dengan naskah di atasnya. */
  cover?: boolean;
}

const { intro, section, size = 'page', media = true, subnav = true, cover = false } = Astro.props;
---

<BaseLayout
  title={intro.metaTitle ?? intro.title}
  description={intro.description}
  headerVariant={cover ? 'over-dark' : 'solid'}
>
  <PageHero
    section={size === 'hub' ? undefined : section}
    eyebrow={intro.eyebrow}
    title={intro.title}
    lede={intro.lede}
    image={intro.image}
    caption={intro.caption}
    size={size}
    media={media}
    cover={cover}
  >
    {cover && subnav && section && (
      <SiblingNav slot="foot" section={section} onImage />
    )}
  </PageHero>

  {!cover && subnav && section && <SiblingNav section={section} />}

  <slot />
</BaseLayout>
