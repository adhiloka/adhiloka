---
import type { Era } from '../data/pages/about';

/** Garis waktu satu kolom: tahun di kiri, peristiwa di kanan. */
interface Props {
  eras: Era[];
}

const { eras } = Astro.props;
---

<ol class="tl">
  {
    eras.map((e, i) => (
      <li class="tl__row" data-reveal={String(i * 50)}>
        <span class="tl__year">{e.year}</span>
        <div class="tl__body">
          <h3 class="tl__title">{e.title}</h3>
          <p class="tl__text">{e.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .tl__row {
    display: grid;
    grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 56px);
    padding: clamp(24px, 2.8vw, 40px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .tl__year {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.1;
    letter-spacing: var(--ls-title);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .tl__title {
    font-size: var(--type-h4);
    line-height: var(--leading-title);
    margin-bottom: 10px;
  }

  .tl__text {
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--ink-body);
    max-width: var(--measure-body);
  }

  @media (max-width: 899px) {
    .tl__row { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
