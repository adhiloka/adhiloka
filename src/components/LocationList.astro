---
import { Image } from 'astro:assets';
import { getImageFor } from '../data/images';
import type { Site } from '../data/pages/about';

/** Kartu per situs: kota, jenis, apa yang dikerjakan, dan daftar kemampuannya. */
interface Props {
  sites: Site[];
}

const { sites } = Astro.props;
---

<div class="sites">
  {
    sites.map((s, i) => {
      const photo = getImageFor(s.image);
      return (
        <article class="site" data-reveal={String(i * 60)}>
          <div class="site__plate plate">
            {photo ? (
              <Image
                src={photo}
                alt={s.shot}
                width={900}
                widths={[420, 900]}
                sizes="(max-width: 899px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
                quality={70}
              />
            ) : (
              <span class="plate__caption">{s.shot}</span>
            )}
          </div>

          <div class="site__copy">
            <span class="site__kind">{s.kind}</span>
            <h3 class="site__city">{s.city}</h3>
            <span class="site__region">{s.region}</span>
            <p class="site__body">{s.body}</p>
            <ul class="site__detail">
              {s.detail.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .sites {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(28px, 3.4vw, 56px);
  }

  .site {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .site__plate {
    position: relative;
    aspect-ratio: 3 / 2;
  }
  .site__plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .site__kind {
    font-size: var(--type-micro);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .site__city {
    font-size: var(--type-h3);
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
  }

  .site__region {
    font-size: var(--type-ui);
    color: var(--ink-muted);
  }

  .site__body {
    margin-top: 10px;
    font-size: var(--type-ui);
    line-height: var(--leading-body);
    color: var(--ink-body);
  }

  .site__detail {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .site__detail li {
    padding: 5px 12px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-pill);
    font-size: var(--type-micro);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
</style>
