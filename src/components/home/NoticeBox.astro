---
import { NOTICE } from '../../data/pages/home';

/* Kotak peringatan penipuan ala `.Com_textBox` adani.com: judul tebal 20 px,
 * teks 20 px dipotong dua baris, dan "Read More" yang membukanya. Naskahnya
 * milik Adhiloka (lihat NOTICE di home.ts). */
---

<section class="notice" aria-labelledby="notice-title">
  <div class="wrap">
    <p class="notice__title" id="notice-title"><strong>{NOTICE.title}</strong></p>
    <div class="notice__body" id="notice-body" data-notice data-anim="sub">
      {NOTICE.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <button class="notice__more" type="button" aria-expanded="false" aria-controls="notice-body" data-notice-btn data-anim="sub">Read More</button>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-notice-btn]');
  const body = document.querySelector<HTMLElement>('[data-notice]');
  btn?.addEventListener('click', () => {
    const open = body!.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Read Less' : 'Read More';
    // Tinggi halaman berubah: posisi pemicu gerak gulir dihitung ulang.
    window.dispatchEvent(new CustomEvent('fx:refresh'));
  });
</script>

<style>
  .notice { padding: 70px 0 60px; background: var(--bg); }
  .notice__title {
    font-size: calc(clamp(17px, 1.39vw, 20px) * var(--fs));
    line-height: 1.23;
    color: var(--ink);
  }
  .notice__body {
    margin-top: 16px;
    font-size: calc(clamp(16px, 1.39vw, 20px) * var(--fs));
    line-height: 1.23;
    color: var(--ink);
  }
  .notice__body p + p { margin-top: 14px; }
  .notice__body:not(.is-open) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }
  .notice__body:not(.is-open) p + p { display: none; }
  .notice__more {
    margin-top: 16px;
    font-size: calc(16px * var(--fs));
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
