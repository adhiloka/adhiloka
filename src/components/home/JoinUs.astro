---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import { JOIN_US } from '../../data/pages/home';

/* "JOIN US" adani.com: judul lalu kartu foto (tombol Discover More di samping
 * judul dilepas 22 Nov 2026: sama dengan kartu Careers, berlebihan). Kartu foto
 * setinggi ±600 px (Adhiloka: dua kartu sejak 22 Nov 2026, Careers dan Partner with Us). Kartu aktif lebar (490 px pada 1440), tiga lainnya sempit;
 * hover atau fokus memindahkan lebarnya. Tautan tombol dan tiap kartu dari
 * JOIN_US (home.ts). */
---

<section class="sec sec--grey join">
  <div class="wrap">
    <div class="head-row">
      <div class="head-row__text">
        <h2 class="h2">{JOIN_US.title}</h2>
      </div>
    </div>

    <ul class="join__cards" data-join data-anim="columns">
      {
        JOIN_US.cards.map((c, i) => (
          <li class:list={['join__card', { 'is-active': i === 0 }]} data-anim-item>
            <a class="join__link cover shade" href={c.href}>
              <Image quality={70} src={images[c.image]} alt={c.alt} widths={[480, 800, 1000]} sizes="(max-width: 1026px) 90vw, 36vw" loading="lazy" />
              <span class="join__label">
                {c.label}
                <svg viewBox="0 0 18 12" width="17" height="11" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-join]').forEach((list) => {
    const cards = [...list.querySelectorAll<HTMLElement>('.join__card')];
    const activate = (card: HTMLElement) => cards.forEach((c) => c.classList.toggle('is-active', c === card));
    cards.forEach((c) => {
      c.addEventListener('mouseenter', () => activate(c));
      c.addEventListener('focusin', () => activate(c));
    });
  });
</script>

<style>
  .join__cards {
    display: flex;
    gap: 2.3%;
    height: clamp(420px, 41.6vw, 600px);
    margin-top: 56px;
  }
  .join__card {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 0.6s var(--ease-io);
  }
  .join__card.is-active { flex-grow: 2.14; }

  .join__link {
    display: block;
    height: 100%;
  }
  .join__link :global(img) { transition: transform var(--t-img) var(--ease-out); }
  .join__link:hover :global(img) { transform: scale(1.05); }

  .join__label {
    position: absolute;
    z-index: 1;
    left: 20px;
    right: 20px;
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: calc(18px * var(--fs));
    line-height: 1.2;
    color: #fff;
  }
  /* Panah tersembunyi; muncul hanya saat kartu di-hover atau difokus, bukan
     karena kartu pertama lebar sejak awal (pemilik, 22 Nov 2026). */
  .join__label svg {
    flex: none;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--t) var(--ease-std), transform 0.5s var(--ease-out);
  }
  .join__card:hover .join__label svg,
  .join__card:focus-within .join__label svg { opacity: 1; transform: none; transition-delay: 0.15s; }
  .join__label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -12px;
    width: 72%;
    height: 3px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .is-active .join__label::after { transform: none; }

  @media (max-width: 1026px) {
    .join__cards {
      height: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 36px;
    }
    .join__link { aspect-ratio: 3 / 4; height: auto; }
    /* Kartu ganjil terakhir selebar dua kolom supaya baris tidak bolong. */
    .join__card:last-child:nth-child(odd) { grid-column: span 2; }
    .join__card:last-child:nth-child(odd) .join__link { aspect-ratio: 3 / 2; }
  }
</style>
