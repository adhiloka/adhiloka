---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import type { BusinessPane, BusinessTab } from '../../data/pages/home';

/* Section "BUSINESSES" adani.com, diisi usaha Adhiloka.
 * 22 Nov 2026 (pemilik): bentuk tile + foto besar tetap, tetapi tab
 * Ingredients/Perfumery (dan sempat Products/Expertise) dilepas; cukup empat
 * tile 2 x 2 di kiri: Natural Ingredients, Perfumery, Technology,
 * Sustainability. Tile memilih foto besar di kanan, yang memuat chip bagian
 * halaman tujuan dan Explore More ("Verticals" Adani).
 * Tile terpilih tidak ditutup gradien: tile lain meredup, yang terpilih tetap
 * terang dengan bilah gradien di dasarnya, garis bawah dan panah. */

/* Situs grup: isinya lewat prop. `panes` = satu set tile tanpa tab.
   `tabs` (beranda grup, pemilik 27 Nov 2026: "tiru Adani, bisnisnya sudah
   tiga") = tab bergaris bawah per lini seperti section Businesses adani.com;
   tiap tab punya empat tile dan foto besarnya sendiri. */
interface Props {
  panes?: BusinessPane[];
  tabs?: BusinessTab[];
  title?: string;
}
const { panes = [], tabs, title = 'Our Business' } = Astro.props;
const groups: BusinessTab[] = tabs ?? [{ key: 'all', label: '', href: '', panes }];
const arrow = '<path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path>';
---

<section class="sec sec--grey biz" data-tabs={tabs ? '' : undefined}>
  <div class="wrap">
    <div class="biz__head">
      <h2 class="h2" data-anim="title">{title}</h2>
      {
        tabs && (
          <div class="biz__tabs" role="tablist" aria-label="Business" data-anim="title">
            {tabs.map((t, i) => (
              <button class:list={['tab', { 'is-active': i === 0 }]} type="button" role="tab" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}>
                {t.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    {
      groups.map((g, gi) => (
        <div class="biz__panel" data-panel={tabs ? g.key : undefined} role={tabs ? 'tabpanel' : undefined} hidden={gi !== 0} data-picker>
          <ul class="biz__tiles biz__tiles--pick">
            {g.panes.map((p, i) => (
              <li data-anim={gi === 0 ? 'thumb' : undefined}>
                <button class:list={['tile', 'shade', { 'is-active': i === 0 }]} type="button" data-pick={p.key} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <Image quality={70} src={images[p.image]} alt="" widths={[320, 520]} sizes="(max-width: 767px) 50vw, 18vw" loading="lazy" />
                  <span class="tile__text">
                    {p.label}
                    <svg class="tile__arrow" viewBox="0 0 18 12" width="17" height="11" aria-hidden="true" set:html={arrow} />
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <div class="biz__big" data-speed="0.9">
            {g.panes.map((p, i) => (
              <div class="big" data-pane={p.key} hidden={i !== 0} data-anim={gi === 0 ? 'thumb' : undefined}>
                <Image quality={70} class="big__img" src={images[p.image]} alt="" widths={[640, 960, 1400]} sizes="(max-width: 1026px) 100vw, 55vw" loading="lazy" />
                <div class="big__links">
                  <ul>
                    {p.chips.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                  <div class="big__more">
                    <a class="more" href={p.href}>
                      <span class="more__label">Explore More</span>
                      <svg class="more__arrow" viewBox="0 0 18 12" width="17" height="11" aria-hidden="true" set:html={arrow} />
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { initTabs, initPickers } from '../../scripts/tabs';
  initTabs();
  initPickers();
</script>

<style>
  .biz__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    flex-wrap: wrap;
  }
  /* Tab ala `.business-right-tab` Adani: 20 px, aktif = teks bergradien +
     garis gradien 4 px yang tumbuh dari kiri. */
  .biz__tabs { display: flex; max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  .biz__tabs::-webkit-scrollbar { display: none; }
  .tab {
    position: relative;
    flex: none;
    padding: 10px 24px;
    border-bottom: 1px solid var(--line);
    font-size: calc(20px * var(--fs));
    font-weight: 440;
    color: var(--ink-muted);
    letter-spacing: 0.2px;
    white-space: nowrap;
    transition: color var(--t) var(--ease-std);
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .tab:hover { color: var(--ink); }
  .tab.is-active {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tab.is-active::after { transform: none; }
  /* Panel tab yang baru tampil masuk pelan (bukan berkedip). */
  .biz__panel:not([hidden]) { animation: biz-in 0.6s var(--ease-out); }
  @keyframes biz-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .biz__panel:not([hidden]) { animation: none; }
  }

  .biz__panel:not([hidden]) {
    display: flex;
    align-items: stretch;
    gap: 0.8%;
    margin-top: 40px;
  }

  .biz__tiles {
    width: 38.4%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-content: start;
  }

  .tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #222;
    text-align: left;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform var(--t-img) var(--ease-out),
      filter var(--t-slow) var(--ease-std);
  }
  .tile:hover :global(img),
  .tile:focus-visible :global(img) { transform: scale(1.06); }

  /* Tanda tile terpilih (pemilik, 22 Nov 2026: jangan ditutup gradien).
     Tile lain meredup sedikit; yang terpilih tetap penuh warna, bilah
     gradien 4 px tumbuh dari kiri di dasarnya. Hover menerangkan lagi. */
  .biz__tiles--pick .tile:not(.is-active) :global(img) { filter: saturate(0.55) brightness(0.72); }
  .biz__tiles--pick .tile:not(.is-active):hover :global(img),
  .biz__tiles--pick .tile:not(.is-active):focus-visible :global(img) { filter: none; }
  .tile::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .tile.is-active::before { transform: none; }

  .tile__text {
    position: absolute;
    z-index: 2;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: calc(16px * var(--fs));
    color: #fff;
    letter-spacing: 0.16px;
  }
  .tile__text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -7px;
    height: 2px;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .tile:hover .tile__text::after,
  .tile:focus-visible .tile__text::after,
  .tile.is-active .tile__text::after { transform: none; }
  /* Panah tersembunyi; muncul (masuk dari kiri) hanya saat kursor ada di
     mana pun di atas tile, atau saat fokus keyboard (pemilik, 22 Nov 2026). */
  .tile__arrow {
    flex: none;
    margin-left: auto;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity var(--t) var(--ease-std), transform 0.5s var(--ease-out);
  }
  .tile:hover .tile__arrow,
  .tile:focus-visible .tile__arrow { opacity: 1; transform: none; }

  .biz__big { position: relative; width: 61.1%; min-height: 360px; }
  .big {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #222;
  }
  .big__img { width: 100%; height: 100%; object-fit: cover; }
  /* Foto besar bergeser −5,4 % mengikuti gulir (scroll-fx.ts); dilebihkan 6 %
     supaya tepi bawahnya tidak terlihat. */
  :global(html.fx) .big__img { height: 106%; }
  .big::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: var(--scrim);
    opacity: 0.92;
    pointer-events: none;
  }
  .big__links {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 26px;
    padding: 0 30px;
  }
  .big__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    padding: 20px 0 8px;
    border-bottom: 1px solid rgb(255 255 255 / 0.55);
  }
  .big__links li {
    position: relative;
    overflow: hidden;
    margin-bottom: 12px;
    background: rgb(0 0 0 / 0.6);
  }
  .big__links li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-bar);
    transform: translateX(-101%);
    transition: transform 0.45s var(--ease-out);
  }
  .big__links li:hover::after,
  .big__links li:focus-within::after { transform: none; }
  .big__links li a {
    position: relative;
    z-index: 1;
    display: block;
    padding: 12px 13px 12px 12px;
    font-size: calc(16px * var(--fs));
    color: rgb(255 255 255 / 0.86);
    letter-spacing: 0.16px;
    transition: color var(--t) var(--ease-std);
  }
  .big__links li:hover a,
  .big__links li a:focus-visible { color: #fff; }

  /* Explore More: garis putih 1 px di bawah; saat hover garis gradien tumbuh
     dari kiri menimpanya dan panah muncul. */
  .big__more { padding-top: 18px; }
  .more {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    font-size: calc(16px * var(--fs));
    color: #fff;
  }
  .more::before,
  .more::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .more::before { height: 1px; background: rgb(255 255 255 / 0.7); }
  .more::after {
    height: 2px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  /* Panah tersembunyi sampai hover/fokus (pemilik, 22 Nov 2026). */
  .more__arrow {
    flex: none;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--t) var(--ease-std), transform 0.5s var(--ease-out);
  }
  .more:hover::after,
  .more:focus-visible::after { transform: none; }
  .more:hover .more__arrow,
  .more:focus-visible .more__arrow { opacity: 1; transform: none; }

  @media (max-width: 1026px) {
    .biz__panel:not([hidden]) { flex-direction: column; gap: 20px; }
    .biz__tiles { width: 100%; }
    .biz__big { width: 100%; min-height: 0; aspect-ratio: 4 / 3; }
    .tab { padding: 10px 16px; font-size: calc(17px * var(--fs)); }
  }
  @media (max-width: 480px) {
    /* Tiga tab muat selebar layar HP: dibagi rata, label boleh dua baris. */
    .biz__tabs { width: 100%; }
    .tab { flex: 1 1 0; padding: 10px 6px 12px; font-size: calc(15px * var(--fs)); line-height: 1.25; white-space: normal; text-align: center; }
    .biz__big { aspect-ratio: 1 / 1; }
    .big__links { padding: 0 16px; bottom: 16px; }
    .big__links li a { font-size: calc(14px * var(--fs)); padding: 9px 10px; }
    /* Label dua baris ("Natural Ingredients") butuh tile sedikit lebih tinggi. */
    .biz__tiles--pick .tile { aspect-ratio: 1.5 / 1; }
    .tile__text { left: 12px; right: 18px; bottom: 12px; gap: 8px; font-size: calc(14px * var(--fs)); line-height: 1.2; }
    .tile__text::after { bottom: -5px; }
  }
</style>
