---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import { BUSINESS_CARDS } from '../../data/pages/home';

/* Section "Our Business" beranda.
 * Dirombak total 22 Nov 2026 (komentar pemilik): tab Products/Expertise dan
 * tile pemilih dilepas. Isinya empat kartu tautan dalam satu baris, pola
 * deret "Our businesses" dsm-firmenich: foto, nama di bawah kiri, seluruh
 * kartu satu tautan. Panah tersembunyi dan baru muncul saat kursor ada di
 * mana pun di atas kartu (pemilik, 22 Nov 2026). */

const arrow = '<path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path>';
---

<section class="sec sec--grey biz">
  <div class="wrap">
    <h2 class="h2" data-anim="title">Our Business</h2>

    <ul class="biz__cards">
      {
        BUSINESS_CARDS.map((c) => (
          <li data-anim="thumb">
            <a class="card shade" href={c.href}>
              <Image quality={72} src={images[c.image]} alt={c.alt} widths={[400, 640, 900]} sizes="(max-width: 767px) 100vw, (max-width: 1026px) 50vw, 25vw" loading="lazy" />
              <span class="card__text">
                {c.label}
                <svg class="card__arrow" viewBox="0 0 18 12" width="17" height="11" aria-hidden="true" set:html={arrow} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .biz__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 40px;
  }

  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #222;
  }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-img) var(--ease-out);
  }
  .card:hover :global(img),
  .card:focus-visible :global(img) { transform: scale(1.06); }

  /* Bilah gradien 4 px tumbuh dari kiri di dasar kartu saat hover. */
  .card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .card:hover::before,
  .card:focus-visible::before { transform: none; }

  .card__text {
    position: absolute;
    z-index: 2;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: calc(20px * var(--fs));
    color: #fff;
    letter-spacing: 0.2px;
  }
  .card__text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    height: 2px;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .card:hover .card__text::after,
  .card:focus-visible .card__text::after { transform: none; }
  .card__arrow {
    flex: none;
    margin-left: auto;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity var(--t) var(--ease-std), transform 0.5s var(--ease-out);
  }
  .card:hover .card__arrow,
  .card:focus-visible .card__arrow { opacity: 1; transform: none; }

  @media (max-width: 1026px) {
    .biz__cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .biz__cards { grid-template-columns: 1fr; margin-top: 28px; }
    .card { aspect-ratio: 16 / 10; }
    .card__text { left: 16px; right: 16px; bottom: 18px; font-size: calc(17px * var(--fs)); }
  }
</style>
