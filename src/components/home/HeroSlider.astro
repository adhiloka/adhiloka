---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import type { HeroSlide } from '../../data/pages/home';

/* Hero beranda ala `.banner-slider` adani.com: foto selayar dengan bayangan
 * hitam dari bawah, judul 44 px di kiri bawah, satu baris teks dan tombol
 * garis putih; di kanan bawah deret kartu slide berikutnya, nomor slide,
 * garis progres 400 px, dan dua panah bulat. Tombol "Watch Video" Adani
 * menjadi "Know More" karena kita tidak memakai video. */

interface Props {
  slides: HeroSlide[];
}
const { slides } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero" data-hero aria-roledescription="carousel" aria-label="Highlights">
  {
    slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image
          class="hero__img"
          src={images[s.image]}
          alt={s.alt}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
        <div class="hero__text">
          {i === 0 ? <h1 class="hero__title">{s.title}</h1> : <p class="hero__title">{s.title}</p>}
          <p class="hero__line">{s.line}</p>
          <div class="hero__btns">
            <a class="btn btn--light" href={s.href} tabindex={i === 0 ? undefined : -1}>
              <span class="btn__label">Know More</span>
            </a>
          </div>
        </div>
      </div>
    ))
  }

  <div class="hero__cards" data-cards>
    {
      slides.map((s, i) => (
        <button class="hero__card" type="button" data-goto={i} aria-label={`Show slide ${i + 1}: ${s.title}`}>
          <Image src={images[s.image]} alt="" widths={[240, 400]} sizes="180px" loading="lazy" />
          <span>{s.title}</span>
        </button>
      ))
    }
  </div>

  <div class="hero__ctrl">
    <span class="hero__num" data-num aria-hidden="true">{pad(1)}</span>
    <span class="hero__bar"><span class="hero__fill" data-fill></span></span>
    <button class="hero__arrow" type="button" data-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m14.5 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button class="hero__arrow" type="button" data-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m9.5 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>
</section>

<script>
  import { initHeroSlider } from '../../scripts/hero-slider';
  initHeroSlider();
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #111;
    color: #fff;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.9s ease,
      visibility 0s linear 0.9s;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.9s ease;
  }
  /* Bayangan `img-box::after` Adani: transparan → hitam, 0,7. */
  .hero__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 0, #000 100%);
    opacity: 0.7;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 7s linear;
  }
  .is-active .hero__img { transform: scale(1); }

  .hero__text {
    position: absolute;
    z-index: 2;
    left: 5.56%;
    bottom: 105px;
    max-width: 53%;
  }
  .hero__title {
    font-size: clamp(32px, 3.06vw, 44px);
    line-height: 1;
    font-weight: 600;
    color: #fff;
  }
  .hero__line {
    margin-top: 24px;
    font-size: clamp(17px, 1.53vw, 22px);
    line-height: 1.35;
    color: #fff;
    max-width: 640px;
  }
  .hero__btns { margin-top: 40px; }

  .hero__title,
  .hero__line,
  .hero__btns {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .is-active .hero__title,
  .is-active .hero__line,
  .is-active .hero__btns {
    opacity: 1;
    transform: none;
  }
  .is-active .hero__line { transition-delay: 0.15s; }
  .is-active .hero__btns { transition-delay: 0.3s; }

  /* Kartu slide berikutnya: `.scard` 180 × 260 dengan bayangan. */
  .hero__cards {
    position: absolute;
    z-index: 3;
    right: 5.56%;
    bottom: 115px;
    display: flex;
    gap: 16px;
  }
  .hero__card {
    position: relative;
    width: 150px;
    height: 220px;
    overflow: hidden;
    box-shadow: 2px 3px 4px #333;
    transition: transform 0.4s ease;
  }
  .hero__card:hover { transform: translateY(-6px); }
  .hero__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__card::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
  }
  .hero__card span {
    position: absolute;
    z-index: 1;
    left: 12px;
    right: 12px;
    bottom: 12px;
    font-size: 13px;
    line-height: 1.25;
    text-align: left;
    color: #fff;
  }
  .hero__card.is-current { display: none; }

  .hero__ctrl {
    position: absolute;
    z-index: 3;
    right: 5.56%;
    bottom: 34px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .hero__num {
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 1;
    color: rgb(253 247 238 / 0.4);
    margin-right: 8px;
    font-variant-numeric: tabular-nums;
  }
  .hero__bar {
    position: relative;
    width: min(400px, 28vw);
    height: 2px;
    background: #fff;
    margin-right: 12px;
  }
  .hero__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--grad-bar);
  }
  .hero__fill.is-running {
    animation: fill var(--hero-ms, 7000ms) linear forwards;
  }
  @keyframes fill {
    to { width: 100%; }
  }
  .hero__arrow {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1px solid #fff;
    border-radius: 50%;
    color: #fff;
    transition: background 0.2s, color 0.2s;
  }
  .hero__arrow:hover { background: #fff; color: #000; }

  @media (max-width: 1026px) {
    .hero__cards { display: none; }
    .hero__text { max-width: 88%; bottom: 120px; }
    .hero__ctrl { left: 20px; right: 20px; bottom: 30px; }
    .hero__num { display: none; }
    .hero__bar { flex: 1; width: auto; }
    .hero__arrow { width: 42px; height: 42px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__title,
    .hero__line,
    .hero__btns { transition: none; transform: none; }
  }
</style>
