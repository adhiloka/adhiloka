---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import { PILLARS, PILLAR_HEADLINE } from '../../data/pages/home';

/* Akordeon keberlanjutan ala `.sustainabilityCompWrap` adani.com: tiga panel
 * foto setinggi 92vh. Panel aktif melebar, dua lainnya menyempit jadi pita
 * 124 px berjudul tegak; klik (atau fokus) membuka panel itu. Di layar
 * sempit panelnya bertumpuk dan yang tertutup jadi pita 150 px.
 *
 * Mekanismenya diukur dari adani.com (CSS + pelacakan frame rekaman layar):
 * yang dianimasikan hanya LEBAR panel (0,5 s ease; aktif 100 %, tertutup
 * 150 px, disusutkan flex). Foto tiap panel berskala TETAP dan duduk di
 * tengah panelnya, jadi saat panel melebar fotonya tersingkap dan bergeser
 * setengah kecepatan tepinya — tidak pernah membesar. Judul tegak hanya ada
 * di pita tertutup (muncul 0,4 s sesudah jeda 0,2 s); isi panel aktif hilang
 * seketika dan muncul 0,6 s sesudah jeda 0,5 s. */
---

<section class="sa" aria-label="Sustainability" data-accordion data-anim="pad">
  {
    PILLARS.map((p, i) => (
      <article class:list={['sa__card', { 'is-active': i === 0 }]} data-acc-item>
        <Image quality={70} class="sa__img" src={images[p.image]} alt={p.alt} widths={[640, 1280, 1920]} sizes="100vw" loading="lazy" />
        <button class="sa__label" type="button" data-acc-btn aria-expanded={i === 0 ? 'true' : 'false'}>
          <span>{p.label}</span>
        </button>
        <div class="sa__content" data-acc-content>
          <p class="sa__headline">
            {PILLAR_HEADLINE.map((l) => (
              <span>{l}</span>
            ))}
          </p>
          <div class="sa__stat">
            <p>{p.stat}</p>
            <a class="sa__cta" href={p.href}>
              {p.cta}
              <svg viewBox="0 0 18 12" width="17" height="11" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
            </a>
          </div>
        </div>
      </article>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-acc-item]')];
    const open = (item: HTMLElement) => {
      items.forEach((it) => {
        const on = it === item;
        it.classList.toggle('is-active', on);
        it.querySelector('[data-acc-btn]')!.setAttribute('aria-expanded', String(on));
      });
    };
    items.forEach((it) => {
      it.addEventListener('click', (e) => {
        if (!it.classList.contains('is-active') && !(e.target as HTMLElement).closest('a')) open(it);
      });
      it.querySelector('[data-acc-btn]')!.addEventListener('click', () => open(it));
    });
  });
</script>

<style>
  /* Latar section = latar halaman: saat digulir, padding-nya bertambah sampai
     40 px (scrollPadding Adani, scripts/scroll-fx.ts) dan akordeonnya jadi
     panel berbingkai. Warna gelap pindah ke kartunya. */
  .sa {
    container-type: inline-size;
    display: flex;
    width: 100%;
    height: 92vh;
    min-height: 560px;
    overflow: hidden;
    background: var(--bg);
  }

  .sa__card {
    position: relative;
    flex: 0 1 auto;
    width: 150px;
    min-width: 0;
    overflow: hidden;
    cursor: pointer;
    background: #111;
    transition: width 0.5s ease;
  }
  /* Lebar CSS Adani 150 px; flex menyusutkan semua panel sebanding lebarnya
     sehingga pita tampil ±124 px dan jumlahnya selalu pas selebar akordeon,
     juga di tengah animasi. Hover 250 px seperti `.subcard:hover`. */
  .sa__card:not(.is-active):hover { width: 250px; }
  .sa__card.is-active {
    width: 100%;
    cursor: default;
  }
  .sa__card + .sa__card { border-left: 1px solid rgb(255 255 255 / 0.15); }

  /* Kotak foto berukuran tetap: setinggi panel dan selebar panel terbuka
     (lebar akordeon dikurangi dua pita ±124 px; dikurangi 200 px supaya
     tidak pernah lebih sempit dari panel terbuka), diletakkan di tengah
     panel. Karena kotaknya tidak ikut melebar, `cover` tidak pernah
     menskalakan ulang foto — penting karena foto kita potret/persegi,
     sedangkan foto Adani 2:1. Dengan `width: 100%` foto membesar ±2× saat
     panel dibuka di layar lebar. */
  .sa__img {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(100cqw - 200px);
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateX(-50%);
  }
  .sa__card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 70%;
    background: linear-gradient(to bottom, transparent, #000);
    opacity: 0.7;
    pointer-events: none;
  }
  /* Bayangan sama untuk panel aktif dan pita, seperti `.subcard:after`
     Adani, supaya tidak ada lonjakan terang-gelap saat panel berganti. */

  /* Judul tegak dalam kotak hitam 40 %, dibaca dari bawah ke atas. */
  .sa__label {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 60px;
    padding: 25px 10px;
    background: rgb(0 0 0 / 0.4);
    color: #fff;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.15;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: left;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }
  .sa__card:not(.is-active) .sa__label {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.4s ease-in 0.2s;
  }
  .sa__label:focus-visible { opacity: 1; }

  /* `.sustainabilityBoxWrap`: kiri 5,1 %, 60 px dari bawah; judul bergaris
     tegak di kanannya, lalu kotak hitam 40 % berisi angka dan tautan. */
  .sa__content {
    position: absolute;
    z-index: 2;
    left: 5.1%;
    right: 60px;
    bottom: 60px;
    display: flex;
    align-items: center;
    color: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .is-active .sa__content {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.6s ease-in 0.5s;
  }

  .sa__headline {
    display: flex;
    flex-direction: column;
    padding-right: 40px;
    border-right: 1px solid rgb(255 255 255 / 0.8);
    font-size: clamp(30px, 3.06vw, 44px);
    line-height: 1.2;
    font-weight: 530;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .sa__stat {
    max-width: 420px;
    margin-left: 56px;
    padding: 20px;
    background: rgb(0 0 0 / 0.4);
  }
  .sa__stat p {
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.24;
    font-weight: 530;
    text-transform: uppercase;
  }
  .sa__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 25px;
    padding-bottom: 5px;
    border-bottom: 2px solid #fff;
    font-size: clamp(18px, 1.39vw, 20px);
    font-weight: 300;
    color: #fff;
  }
  .sa__cta svg { flex: none; transition: transform 0.4s; }
  .sa__cta:hover svg { transform: translateX(4px); }

  @media (max-width: 1026px) {
    .sa { flex-direction: column; height: auto; min-height: 0; }
    .sa__card,
    .sa__card:not(.is-active):hover { flex: none; width: 100%; height: 110px; transition: height 0.5s ease; }
    .sa__card.is-active { flex: none; height: 78vh; min-height: 480px; }
    /* Bertumpuk: kotak foto setinggi panel terbuka, di tengah pita. */
    .sa__img { top: 50%; left: 0; width: 100%; height: max(78vh, 480px); transform: translateY(-50%); }
    .sa__card + .sa__card { border-left: 0; border-top: 1px solid rgb(255 255 255 / 0.15); }
    .sa__label,
    .sa__card:not(.is-active) .sa__label {
      left: 20px;
      top: 0;
      bottom: auto;
      padding: 14px 16px;
      font-size: 20px;
      writing-mode: horizontal-tb;
      transform: none;
    }
    .sa__card:not(.is-active) .sa__label { top: 50%; transform: translateY(-50%); background: none; padding: 0; }
    .sa__content { left: 20px; right: 20px; bottom: 30px; flex-direction: column; align-items: flex-start; gap: 24px; }
    .sa__headline { white-space: normal; padding-right: 0; border-right: 0; }
    .sa__stat { max-width: none; margin-left: 0; }
  }
  @media (max-width: 767px) {
    .sa__card::after { height: 100%; opacity: 1; }
  }
</style>
