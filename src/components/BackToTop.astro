<button type="button" class="to-top" data-to-top aria-label="Back to top">
  <svg width="18" height="12" viewBox="0 0 24 15" fill="none" aria-hidden="true">
    <path
      d="M2.6 12.4 12 3l9.4 9.4"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .to-top {
    position: fixed;
    right: clamp(16px, 2.2vw, 34px);
    bottom: calc(clamp(16px, 2.2vw, 34px) + var(--to-top-lift, 0px));
    z-index: 150;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--shade-rgb) / 0.22);
    background: rgb(255 255 255 / 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--espresso);
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 480ms ease,
      transform var(--dur-slow) var(--ease-glide),
      bottom var(--dur-fast) ease,
      background var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Dulu tombol ini membalik jadi garis terang di atas footer gelap. Footernya
     sekarang panel putih, jadi yang membalik justru menghilang; yang tersisa
     hanyalah menegaskan garisnya supaya tetap terbaca di atas putih. */
  .to-top.is-over-footer {
    background: var(--footer-panel);
    border-color: oklch(0 0 0 / 0.3);
    color: var(--footer-ink);
  }

  .to-top:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ivory-1);
  }
</style>
