---
import { Image } from 'astro:assets';
import { getImageFor } from '../data/images';
import { GET_IN_TOUCH } from '../data/pages/home';
import type { CarouselSlide } from '../data/pages/types';
import Waves from './Waves.astro';

/**
 * Pita berkarusel: media di kiri, naskah di kanan, panah dan hitungan slide.
 * Tampilannya meniru kotak Sustainability valeindonesia.com: foto bergelombang
 * atas-bawah, judul teal, tombol pil, panah bulat teal.
 *
 * Isi bawaannya adalah "Get in touch" di halaman depan — dari situlah nama
 * berkas ini — tetapi bentuknya umum: halaman hub About memakainya untuk lima
 * pintu ke halaman anaknya. Slide berfoto dan slide berpelat hatch berbagi
 * kotak yang sama; hanya opacity-nya yang berganti.
 */
interface Props {
  /** Slide yang ditampilkan. Bawaannya karusel penutup halaman depan. */
  slides?: CarouselSlide[];
  /** Nama karusel untuk pembaca layar. */
  label?: string;
  /** Pita ditarik masuk dari kedua tepi layar, bukan full-bleed — bentuk yang
   *  dulu dipakai pita "Our purpose" di posisi ini. */
  inset?: boolean;
}

const { slides = GET_IN_TOUCH, label = 'Get in touch', inset = false } = Astro.props;
---

<section class="gt" aria-roledescription="carousel" aria-label={label}>
  <div class:list={['gt__band', inset && 'gt__band--inset']} data-gt>
    <div class="gt__media">
      {
        slides.map((slide, i) => {
          const photo = getImageFor(slide.image);
          return (
            <div
              class:list={['gt__plate', 'plate', photo && 'gt__plate--photo']}
              data-gt-media={i}
              data-state={i === 0 ? 'current' : 'idle'}
              style={[
                slide.bg && `background:${slide.bg}`,
                slide.focus && `--gt-focus:${slide.focus}`,
              ]
                .filter(Boolean)
                .join(';')}
              aria-hidden="true"
            >
              {photo ? (
                <Image
                  src={photo}
                  alt=""
                  width={1100}
                  widths={[600, 900, 1100]}
                  sizes="(max-width: 899px) 100vw, 50vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  quality={72}
                />
              ) : (
                <span class="plate__caption">{slide.shot}</span>
              )}
            </div>
          );
        })
      }
      <Waves kind="top" />
      <Waves kind="bottom" />
    </div>

    <div class="gt__copy">
      <div class="gt__nav">
        <button type="button" data-gt-prev aria-label="Previous">
          <svg width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true">
            <path d="M10 2 2 10l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
        <span class="gt__count" data-gt-count aria-hidden="true">1 / {slides.length}</span>
        <button type="button" data-gt-next aria-label="Next">
          <svg width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true">
            <path d="M2 2l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="gt__slides">
        {
          slides.map((slide, i) => (
            <div
              class="gt__slide"
              data-gt-slide={i}
              data-state={i === 0 ? 'current' : 'idle'}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${slides.length}`}
              hidden={i !== 0}
            >
              <h2>{slide.title}</h2>
              <p>{slide.body}</p>
              <a class="btn-pill" href={slide.href}>
                {slide.cta}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initGetInTouch } from '../scripts/get-in-touch';
  document.addEventListener('astro:page-load', initGetInTouch);
</script>

<style>
  .gt__band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
    max-width: var(--measure-max);
    margin-inline: auto;
    cursor: grab;
    touch-action: pan-y;
  }
  .gt__band.is-dragging { cursor: grabbing; user-select: none; }
  .gt__band--inset { padding-inline: var(--gutter); }

  .gt__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 0.8;
    max-height: calc(100svh - 160px);
    width: 100%;
    background: var(--plate);
  }

  .gt__plate {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .gt__plate[data-state='current'] { opacity: 1; }
  .gt__plate .plate__caption { left: 20px; right: 20px; bottom: 30%; }
  .gt__plate--photo { background-image: none; }
  .gt__plate--photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--gt-focus, 50% 50%);
  }
  .gt__media :global(.waves) { z-index: 3; }

  .gt__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    color: var(--ink-body);
  }

  .gt__nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .gt__nav button {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--teal);
    color: var(--teal);
    transition: background 150ms ease-in-out, color 150ms ease-in-out, box-shadow 150ms ease-in-out;
  }
  .gt__nav button:hover {
    background: var(--teal);
    color: var(--paper);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }
  .gt__count {
    min-width: 3.5em;
    text-align: center;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-body);
  }

  .gt__slides { position: relative; }
  .gt__slide {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    opacity: 1;
    transform: translateX(0);
    transition: opacity 500ms ease, transform 750ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .gt__slide[hidden] { display: none; }
  .gt__slide[data-state='out'] { opacity: 0; }

  .gt__slide h2 {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--teal);
  }
  .gt__slide p {
    max-width: 34em;
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--ink-body);
  }
  .gt__slide :global(.btn-pill) { margin-top: 8px; }

  @media (max-width: 899px) {
    .gt__band { grid-template-columns: 1fr; }
    .gt__media { aspect-ratio: 4 / 3; }
  }
</style>
