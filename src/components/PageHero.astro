---
import { Image } from 'astro:assets';
import { getImageFor, type ImageKey } from '../data/images';
import Breadcrumb from './Breadcrumb.astro';

/**
 * Kepala halaman dalam ala valeindonesia.com.
 *
 * Dengan foto: spanduk foto selebar layar (diredupkan 0,8, gradien hitam dari
 * kiri) dengan jejak, judul, dan lede putih di kiri bawah; bidang lengkung
 * logo dari header duduk di atasnya. `cover` membuatnya setinggi satu layar.
 *
 * Tanpa foto (`media={false}` atau data tanpa gambar): blok putih dengan
 * judul teal, header memakai varian solid. Blok ini ditandai tempelan
 * (data-section-skip) supaya bergabung dengan isi sesudahnya alih-alih
 * diregangkan sendirian setinggi satu layar.
 */
interface Props {
  section?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageKey;
  caption: string;
  /** Halaman hub memakai judul lebih besar daripada halaman anak. */
  size?: 'hub' | 'page';
  /** Foto bisa dimatikan pada halaman yang isinya langsung bergambar. */
  media?: boolean;
  /** Spanduk setinggi satu layar. */
  cover?: boolean;
}

const {
  section,
  eyebrow,
  title,
  lede,
  image,
  caption,
  size = 'page',
  media = true,
  cover = false,
} = Astro.props;

const photo = media || cover ? getImageFor(image) : undefined;
---

<section
  class:list={['phero', size === 'hub' && 'phero--hub', photo && 'phero--photo', cover && 'phero--cover']}
  data-section-raw={photo ? '' : undefined}
  data-section-skip={photo ? undefined : ''}
>
  {
    photo && (
      <div class="phero__photo">
        <Image
          src={photo}
          alt={caption}
          width={2200}
          widths={[900, 1400, 1800, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={72}
        />
      </div>
    )
  }

  <div class="frame phero__inner">
    {section && <Breadcrumb section={section} current={title} onImage={!!photo} />}
    {eyebrow && !section && <span class="eyebrow phero__eyebrow">{eyebrow}</span>}
    <h1 class="phero__title" data-reveal data-reveal-from="left">{title}</h1>
    {lede && <p class="phero__lede" data-reveal="120" data-reveal-from="left">{lede}</p>}
  </div>

  {
    Astro.slots.has('foot') && (
      <div class="phero__foot">
        <slot name="foot" />
      </div>
    )
  }
</section>

<style>
  .phero { background: var(--paper); }

  .phero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(14px, 1.6vw, 22px);
    /* Ruang atas memperhitungkan bidang logo di kiri atas. */
    padding: calc(clamp(110px, 9vw, 140px) + 12px) var(--gutter) clamp(24px, 3vw, 40px);
  }

  .phero__title {
    font-size: var(--type-h1);
    font-weight: 500;
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
    color: var(--teal);
    max-width: 20em;
  }
  .phero--hub .phero__title {
    font-size: var(--type-display);
    font-weight: 600;
    line-height: var(--leading-display);
    max-width: 16em;
  }

  .phero__lede {
    font-size: var(--type-lede);
    line-height: var(--leading-lede);
    color: var(--ink-body);
    max-width: 34em;
  }

  /* ── Spanduk foto ───────────────────────────────────────────────────── */
  .phero--photo {
    position: relative;
    min-height: clamp(360px, 46svh, 460px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--teal-dark);
    color: var(--on-image);
  }
  .phero--cover { min-height: 100svh; }

  .phero__photo { position: absolute; inset: 0; }
  .phero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    filter: brightness(0.8);
  }
  .phero__photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.65) 0%, rgb(0 0 0 / 0) 60%),
      linear-gradient(to top, rgb(0 0 0 / 0.35) 0%, rgb(0 0 0 / 0) 45%);
  }

  .phero--photo .phero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    /* Jejak dan judul harus di bawah lengkung putih header (tingginya 15,6vw). */
    padding-top: clamp(150px, 12vw, 210px);
    padding-bottom: clamp(28px, 3.4vw, 52px);
  }
  .phero--photo .phero__title,
  .phero--photo .phero__lede,
  .phero--photo .phero__eyebrow {
    color: var(--on-image);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
  }
  .phero--photo .phero__title { max-width: 16em; }

  .phero__foot {
    position: relative;
    z-index: 2;
  }
  .phero__foot:empty { display: none; }
</style>
