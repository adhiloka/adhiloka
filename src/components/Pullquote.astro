---
import type { Quote } from '../data/pages/types';

/** Kutipan besar di atas dasar gelap. Satu per halaman, tidak lebih. */
interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
---

<section class="pq on-dark">
  <blockquote class="frame pq__inner">
    <p class="pq__text" data-lines>{quote.text}</p>
    <footer class="pq__by" data-reveal="120">{quote.attribution}</footer>
  </blockquote>
</section>

<style>
  .pq {
    position: relative;
    overflow: hidden;
    background: var(--teal);
    color: var(--paper);
  }

  .pq__inner {
    margin: 0;
    padding: clamp(64px, 9vw, 130px) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(22px, 2.6vw, 36px);
  }

  /* Tanda kutip emas besar, satu-satunya hiasan di pita ini. */
  .pq__text::before {
    content: 'C';
    display: block;
    height: 0.62em;
    margin-bottom: 0.1em;
    font-size: 2.6em;
    line-height: 1;
    color: var(--gold);
  }
  .pq__text {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: 1.3;
    max-width: 26ch;
    text-wrap: balance;
  }

  .pq__by {
    font-size: 16px;
    font-weight: 500;
    color: var(--paper);
  }
</style>
