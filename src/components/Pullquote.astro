---
import type { Quote } from '../data/pages/types';

/** Kutipan besar di atas dasar gelap. Satu per halaman, tidak lebih. */
interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
---

<section class="pq on-dark">
  <blockquote class="frame pq__inner">
    <p class="pq__text" data-lines>{quote.text}</p>
    <footer class="pq__by" data-reveal="120">{quote.attribution}</footer>
  </blockquote>
</section>

<style>
  .pq {
    background: var(--ground-dark);
    color: var(--text-on-dark);
  }

  .pq__inner {
    margin: 0;
    padding: clamp(64px, 9vw, 130px) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(22px, 2.6vw, 36px);
  }

  .pq__text {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: 1.3;
    letter-spacing: var(--ls-title);
    max-width: 26ch;
    text-wrap: balance;
  }

  .pq__by {
    font-size: var(--type-micro);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-on-dark-dim);
  }
</style>
