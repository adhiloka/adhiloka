---
import { Image } from 'astro:assets';
import { images, type ImageKey } from '../data/images';

/* Kutipan terbelah ala `.growth-section` adani.com: foto setinggi layar di
 * kiri (42,1 %), kutipan di kanan dengan padding 8,4 % / 9,8 %. Hurufnya
 * berubah dari abu #c1c1c1 ke gelap satu per satu mengikuti gulir (SplitText
 * Adani; di sini dipecah di server, digerakkan scripts/scroll-fx.ts), kata
 * kunci (*bintang* di naskah) dicetak tebal, lalu garis balon, nama, jabatan
 * dan tombol. Teks kutipan bergerak 1,1× kecepatan gulir (data-speed Adani).
 * Di halaman dalam pemicunya memakai takaran inner-page.js (data-quote="inner"). */

interface Props {
  text: string;
  name: string;
  role?: string;
  cta?: string;
  href?: string;
  image?: ImageKey;
  alt?: string;
  /** Pelat pengganti bila foto belum ada. */
  shot?: string;
  grey?: boolean;
}
const { text, name, role, cta, href, image, alt = '', shot, grey = false } = Astro.props;

// "*kata kunci*" → token tebal; sisanya dipecah per kata, lalu per huruf.
const tokens = text
  .split(/(\*[^*]+\*)/)
  .filter(Boolean)
  .flatMap((part) => {
    const bold = part.startsWith('*');
    return part
      .replace(/\*/g, '')
      .split(/(\s+)/)
      .filter((w) => w.length)
      .map((w) => ({ w, bold, space: /^\s+$/.test(w) }));
  });
const plain = text.replace(/\*/g, '');
---

<section class:list={['qs', { 'sec--grey': grey }]} data-quote={Astro.url.pathname === '/' ? '' : 'inner'}>
  <div class="qs__media cover zoom">
    {image ? <Image quality={70} src={images[image]} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 1026px) 100vw, 42vw" /> : <span class="plate">{shot}</span>}
  </div>
  <div class="qs__body" data-speed="1.1">
    <blockquote class="qs__quote">
      {/* Satu baris: spasi dari pemformatan tidak boleh masuk ke dalam kata. */}
      <p><span class="sr-only">{plain}</span><span aria-hidden="true">{tokens.map((t) => (t.space ? t.w : <span class:list={['qs__w', { 'qs__b': t.bold }]}>{[...t.w].map((c) => <span class="qs__c">{c}</span>)}</span>))}</span></p>
    </blockquote>
    <div class="qs__rule" aria-hidden="true"></div>
    <p class="qs__name">{name}</p>
    {role && <p class="qs__role">{role}</p>}
    {cta && href && (
      <a class="btn qs__btn" href={href}><span class="btn__label">{cta}</span></a>
    )}
  </div>
</section>

<style>
  .qs {
    display: flex;
    align-items: center;
    background: var(--bg);
  }
  .qs.sec--grey { background: var(--bg-grey); }

  .qs__media {
    flex: none;
    width: 42.1%;
    height: 101vh;
    min-height: 560px;
  }
  .qs__media :global(img) { height: 100%; }

  .qs__body {
    flex: 1;
    padding: 60px 9.8% 60px 8.4%;
  }

  .qs__quote {
    position: relative;
    font-size: calc(clamp(20px, 1.8vw, 26px) * var(--fs));
    line-height: 1.24;
    color: var(--line);
  }
  .qs__quote::before {
    content: '“';
    position: absolute;
    left: -0.8em;
    top: -0.1em;
    font-size: 2em;
    line-height: 1;
    color: var(--ink);
  }
  .qs__quote p::after {
    content: '”';
    font-size: 1.6em;
    line-height: 0;
    vertical-align: -0.25em;
    color: var(--line);
  }
  .qs__quote.is-done p::after { color: var(--ink); }
  /* Huruf abu (#c1c1c1) sampai skrip menyalakannya; tanpa JS langsung gelap. */
  .qs__c.is-on { color: var(--ink); }
  html:not(.js) .qs__c { color: var(--ink); }
  html:not(.js) .qs__quote p::after { color: var(--ink); }
  .qs__b { font-weight: 670; }

  /* Garis balon: garis tipis dengan ekor segitiga di kiri, di atas nama. */
  .qs__rule {
    position: relative;
    height: 1px;
    margin: 32px 0 28px;
    background: var(--line);
  }
  .qs__rule::after {
    content: '';
    position: absolute;
    left: 60px;
    top: -1px;
    width: 18px;
    height: 18px;
    background: var(--bg);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transform: translateY(-50%) rotate(45deg) translate(6px, 6px);
  }
  .sec--grey .qs__rule::after { background: var(--bg-grey); }

  .qs__name {
    font-size: calc(clamp(20px, 1.67vw, 24px) * var(--fs));
    color: var(--ink);
  }
  .qs__role {
    margin-top: 6px;
    font-size: calc(14px * var(--fs));
    color: var(--ink-muted);
  }
  .qs__btn { margin-top: 28px; }

  @media (max-width: 1026px) {
    .qs { flex-direction: column; align-items: stretch; }
    .qs__media { width: 100%; height: 60vh; min-height: 320px; }
    .qs__body { padding: 50px 20px 50px 48px; }
  }
</style>
