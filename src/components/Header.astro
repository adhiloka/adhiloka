---
import Logo from './Logo.astro';
import SearchPanel from './SearchPanel.astro';
import MenuOverlay from './MenuOverlay.astro';

interface Props {
  variant: 'over-dark' | 'over-light' | 'solid';
  active: string;
}

const { variant, active } = Astro.props;
---

<!-- Header meniru valeindonesia.com: tidak ada bilah menu. Di kiri atas bidang
     putih melengkung memikul tombol menu pil emas dan logo; di kanan atas pil
     putih berisi tombol cari dan tombol bahasa bulat. Semua navigasi lewat
     tombol menu, yang membuka MenuOverlay. -->
<header class="site-header" data-variant={variant} data-site-header>
  <div class="site-header__brand">
    <svg
      class="site-header__swoosh"
      viewBox="0 0 540 192"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 0H540C520 10 470 50 420 90C340 140 170 180 0 190Z" fill="currentColor"></path>
    </svg>
    <Logo class="site-header__logo" size="var(--menu-h)" />
  </div>

  <div class="site-header__tools">
    <div class="tools-pill">
      <button
        type="button"
        class="tools-pill__search"
        data-search-open
        aria-label="Open search"
        aria-controls="search-panel"
        aria-expanded="false"
      >
        <span>Search</span>
        <svg width="17" height="17" viewBox="0 0 21 21" fill="none" aria-hidden="true">
          <circle cx="8.6" cy="8.6" r="6.6" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M13.6 13.6 19.4 19.4" stroke="currentColor" stroke-width="1.8"></path>
        </svg>
      </button>
    </div>

    <div class="lang" data-lang>
      <button
        type="button"
        class="lang__toggle"
        aria-expanded="false"
        aria-controls="lang-menu"
        aria-label="Language: English"
        data-lang-toggle
      >
        EN
      </button>
      <div class="lang__menu" id="lang-menu" role="menu" data-lang-menu>
        <a role="menuitem" href="/" hreflang="id" lang="id">Bahasa Indonesia</a>
        <a role="menuitem" href="/" hreflang="en" lang="en" aria-current="true">English</a>
      </div>
    </div>
  </div>
</header>

<!-- Tombol menu pil emas. Di luar <header> supaya tetap menempel di kiri atas
     sepanjang halaman, sementara logo dan pil kanan pergi setelah section 1. -->
<button
  type="button"
  class="menu-btn"
  data-menu-toggle
  aria-label="Open menu"
  aria-controls="site-menu"
  aria-expanded="false"
>
  <span class="menu-btn__lines" aria-hidden="true"></span>
</button>

<MenuOverlay active={active} />
<SearchPanel />

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 150;
    height: 0;
    pointer-events: none;
  }

  /* ── Bidang putih melengkung + logo ─────────────────────────────────── */
  .site-header__brand {
    position: absolute;
    top: 0;
    left: 0;
    /* Lebih pendek dan landai daripada sebelumnya: proporsi lengkung Vale
       (±28vw x 10vw). */
    width: clamp(260px, 27vw, 520px);
    height: clamp(100px, 10vw, 192px);
    color: var(--paper);
    pointer-events: none;
    transition: transform 500ms ease, opacity 400ms ease;
  }
  .site-header__swoosh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.06));
  }
  /* Tanda logo sejajar atas-bawah dengan tombol menu, dan hanya
     --menu-gap dari tepi kanan tombol. */
  :global(.site-header__logo) {
    position: absolute;
    top: var(--menu-top);
    left: calc(var(--menu-w) + var(--menu-gap));
    color: var(--ink);
    pointer-events: auto;
  }

  /* Halaman tanpa foto sampul sudah berlatar putih: bidang lengkungnya
     tidak dibutuhkan, dan bayangannya hanya terbaca sebagai garis abu. */
  .site-header[data-variant='solid'] .site-header__swoosh { display: none; }

  /* ── Pil kanan: cari + bahasa ───────────────────────────────────────── */
  .site-header__tools {
    position: absolute;
    top: clamp(24px, 2.2vw, 38px);
    right: clamp(20px, 3vw, 60px);
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.2vw, 20px);
    pointer-events: auto;
    transition: transform 500ms ease, opacity 400ms ease;
  }

  .tools-pill {
    display: flex;
    align-items: center;
    height: 42px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.08);
  }
  .tools-pill__search {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--type-ui);
    font-weight: 500;
    color: var(--ink-body);
    transition: color 150ms ease-in-out;
  }
  .tools-pill__search svg { color: var(--teal); }
  .tools-pill__search:hover { color: var(--teal); }

  .lang { position: relative; }
  .lang__toggle {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--teal);
    background: var(--paper);
    color: var(--teal);
    font-size: 15px;
    font-weight: 600;
    transition: background 150ms ease-in-out, color 150ms ease-in-out, box-shadow 150ms ease-in-out;
  }
  /* Hover tombol bahasa Vale: isi teal, huruf putih, bayangan 0 2px 8px. */
  .lang__toggle:hover,
  .lang__toggle:focus-visible,
  .lang.is-open .lang__toggle {
    background: var(--teal);
    color: var(--paper);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 180px;
    padding: 8px 0;
    background: var(--paper);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 300ms ease, transform 300ms ease;
  }
  .lang.is-open .lang__menu { opacity: 1; transform: none; pointer-events: auto; }
  .lang__menu a {
    display: block;
    padding: 10px 20px;
    font-size: 15px;
    color: var(--ink-body);
  }
  .lang__menu a:hover { background: var(--paper-sunk); color: var(--teal); }
  .lang__menu a[aria-current] { color: var(--teal); font-weight: 500; }

  /* Di luar section 1 logo dan pil kanan pergi; tombol menu tetap. */
  .site-header.is-away .site-header__brand {
    transform: translateY(-100%);
    opacity: 0;
  }
  .site-header.is-away .site-header__tools {
    transform: translateY(-160%);
    opacity: 0;
    pointer-events: none;
  }
  .site-header.is-away :global(.site-header__logo) { pointer-events: none; }

  /* ── Tombol menu pil emas ───────────────────────────────────────────── */
  .menu-btn {
    position: fixed;
    z-index: 190;
    top: var(--menu-top);
    left: 0;
    width: var(--menu-w);
    height: var(--menu-h);
    padding-left: clamp(22px, 1.6vw, 30px);
    display: flex;
    align-items: center;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--gold);
    color: var(--paper);
    /* Lingkar putih tipis: tombol ini menetap di atas semua section, termasuk
       pita emas, dan tanpa lingkar ia hilang di sana. */
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9), 0 1px 6px rgb(0 0 0 / 0.12);
    transition: box-shadow 150ms ease-in-out;
  }
  .menu-btn:hover { box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9), 0 0 8px rgb(236 177 31 / 0.7); }

  /* Tiga garis dari satu elemen: garisnya sendiri + ::before + ::after.
     Saat di-hover garis atas bergeser 9px ke kiri, seperti burger Vale. */
  .menu-btn__lines,
  .menu-btn__lines::before,
  .menu-btn__lines::after {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .menu-btn__lines {
    position: relative;
    top: -7px;
  }
  .menu-btn__lines::before,
  .menu-btn__lines::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-btn__lines::before {
    transform: translateY(7px);
    transition: transform 300ms ease-in-out;
  }
  .menu-btn__lines::after { transform: translateY(14px); }
  .menu-btn:hover .menu-btn__lines::before { transform: translateX(-9px) translateY(7px); }

  @media (max-width: 899px) {
    .site-header__brand {
      width: 330px;
      height: 104px;
    }
    .menu-btn { padding-left: 20px; }
    .tools-pill { display: none; }
    .site-header__tools { top: 18px; right: 16px; }
    .lang__toggle { width: 42px; height: 42px; font-size: 14px; }
  }
</style>
