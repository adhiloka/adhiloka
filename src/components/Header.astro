---
import Wordmark from './Wordmark.astro';
import SearchPanel from './SearchPanel.astro';
import MenuOverlay from './MenuOverlay.astro';

interface Props {
  variant: 'over-dark' | 'over-light' | 'solid';
  active: string;
}

const { variant, active } = Astro.props;
---

<!-- Header meniru pola louisvuitton.com: satu bar tiga kolom. Kiri tombol Menu
     dan Search, tengah wordmark tulisan saja, kanan Contact dan pemilih bahasa.
     Di atas foto sampul bar-nya transparan dengan huruf putih; setelah section 1
     (atau di halaman tanpa foto sampul) ia menjadi bar putih berhuruf gelap.
     Tombol Menu membuka MenuOverlay ala Vale. -->
<header class="site-header" data-variant={variant} data-site-header>
  <div class="site-header__bar">
    <div class="site-header__side site-header__side--left">
      <button
        type="button"
        class="hbtn hbtn--menu"
        data-menu-toggle
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <span class="burger" aria-hidden="true"><span class="burger__line"></span></span>
        <span class="hbtn__label">Menu</span>
      </button>

      <button
        type="button"
        class="hbtn"
        data-search-open
        aria-controls="search-panel"
        aria-expanded="false"
      >
        <svg width="19" height="19" viewBox="0 0 21 21" fill="none" aria-hidden="true">
          <circle cx="8.6" cy="8.6" r="6.9" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M13.8 13.8 19.6 19.6" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <span class="hbtn__label">Search</span>
      </button>
    </div>

    <Wordmark class="site-header__wordmark" size="clamp(19px, 1.62vw, 31px)" />

    <div class="site-header__side site-header__side--right">
      <a class="hbtn" href="/contact/" aria-current={active.startsWith('/contact') ? 'page' : undefined}>
        <svg class="hbtn__icon-narrow" width="20" height="16" viewBox="0 0 20 16" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="m1.5 2 8.5 7 8.5-7" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <span class="hbtn__label">Contact</span>
      </a>

      <div class="lang" data-lang>
        <button
          type="button"
          class="hbtn lang__toggle"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label="Language: English"
          data-lang-toggle
        >
          <span class="lang__long">English</span>
          <span class="lang__short">EN</span>
          <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
            <path d="m1 1 4.5 4.5L10 1" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
        <div class="lang__menu" id="lang-menu" role="menu" data-lang-menu>
          <a role="menuitem" href="/" hreflang="id" lang="id">Bahasa Indonesia</a>
          <a role="menuitem" href="/" hreflang="en" lang="en" aria-current="true">English</a>
        </div>
      </div>
    </div>
  </div>
</header>

<MenuOverlay active={active} />
<SearchPanel />

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 150;
    height: var(--header-h);
    color: var(--on-image);
    background: transparent;
    transition: background 300ms ease, color 300ms ease, box-shadow 300ms ease;
  }

  /* Di atas foto: bayang gelap tipis dari atas supaya huruf putih tetap
     terbaca di foto yang terang. Hilang begitu bar menjadi putih. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.34), rgb(0 0 0 / 0));
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  /* Bar putih: halaman tanpa foto sampul, atau setelah section 1. */
  .site-header[data-variant='solid'],
  .site-header.is-solid {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
  }
  .site-header[data-variant='solid']::before,
  .site-header.is-solid::before { opacity: 0; }

  .site-header__bar {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--header-gutter);
  }

  .site-header__side {
    display: flex;
    align-items: center;
    gap: clamp(22px, 2.6vw, 50px);
  }
  .site-header__side--right { justify-content: flex-end; gap: clamp(22px, 2.2vw, 42px); }

  :global(.site-header__wordmark) { justify-self: center; }

  /* ── Tombol teks + ikon ─────────────────────────────────────────────── */
  .hbtn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 44px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1;
    color: inherit;
  }
  .hbtn:hover,
  .hbtn:focus-visible { color: inherit; }
  .hbtn__label {
    padding-block: 3px;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
    transition: background-size 300ms ease;
  }
  .hbtn:hover .hbtn__label,
  .hbtn:focus-visible .hbtn__label,
  .hbtn[aria-current='page'] .hbtn__label { background-size: 100% 1px; }
  .hbtn__icon-narrow { display: none; }

  /* Burger tiga garis, takaran burger Vale: 18px x 2px, jarak 7px. Saat
     di-hover garis tengah bergeser 9px ke kiri (0,3 detik). */
  .burger {
    position: relative;
    width: 18px;
    height: 16px;
  }
  .burger__line,
  .burger__line::before,
  .burger__line::after {
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    border-radius: 5px;
    background: currentColor;
  }
  .burger__line { top: 0; }
  .burger__line::before,
  .burger__line::after { content: ''; }
  .burger__line::before {
    transform: translateY(7px);
    transition: transform 300ms ease-in-out;
  }
  .burger__line::after { transform: translateY(14px); }
  .hbtn--menu:hover .burger__line::before,
  .hbtn--menu:focus-visible .burger__line::before { transform: translateX(-9px) translateY(7px); }

  /* ── Pemilih bahasa ─────────────────────────────────────────────────── */
  .lang { position: relative; }
  .lang__toggle { gap: 10px; }
  .lang__toggle svg { transition: transform 300ms ease; }
  .lang.is-open .lang__toggle svg { transform: rotate(180deg); }
  .lang__short { display: none; }

  .lang__menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    min-width: 190px;
    padding: 8px 0;
    background: var(--paper);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 300ms ease, transform 300ms ease;
  }
  .lang.is-open .lang__menu { opacity: 1; transform: none; pointer-events: auto; }
  .lang__menu a {
    display: block;
    padding: 10px 20px;
    font-size: 15px;
    color: var(--ink-body);
  }
  .lang__menu a:hover { background: var(--paper-sunk); color: var(--teal); }
  .lang__menu a[aria-current] { color: var(--teal); font-weight: 500; }

  /* ── HP: ikon saja, seperti LV ──────────────────────────────────────── */
  @media (max-width: 767px) {
    /* Label disembunyikan secara visual saja: tetap jadi nama tombol. */
    .hbtn__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .hbtn__icon-narrow { display: block; }
    .lang__long { display: none; }
    .lang__short { display: inline; font-size: 15px; font-weight: 500; }
    .lang__toggle svg { display: none; }
    .site-header__side { gap: 18px; }
    .site-header__side--right { gap: 18px; }
  }
</style>
