---
import { NAV_LINKS, SEARCH_SUGGESTIONS } from '../data/site';
import { MATERIALS } from '../data/materials';
import { MATERIAL_NAMES } from '../data/material-names';
import { NEWS } from '../data/pages/media';

/* Panel cari ala `.search-bar-wrapper` adani.com: lembar putih selayar yang
 * turun dari atas, satu kolom input besar, lalu "Popular Pages". Situs ini
 * statis, jadi hasilnya dicari di klien dari indeks kecil yang dibangun di
 * sini — halaman, material, dan berita. */

const index = [
  ...NAV_LINKS.map((l) => ({ label: l.label, href: l.href, kind: 'Page' })),
  ...MATERIALS.map((m) => ({
    label: MATERIAL_NAMES[m.slug] ?? m.name,
    href: `/ingredients/catalog/#${m.slug}`,
    kind: 'Ingredient',
    extra: `${m.latin} ${m.family} ${m.origin}`,
  })),
  ...NEWS.map((n) => ({ label: n.title, href: `/media/news/${n.slug}/`, kind: 'News' })),
  { label: 'Contact', href: '/contact/', kind: 'Page' },
];
---

<div class="srch" data-search hidden>
  <div class="wrap srch__inner">
    <button class="srch__close" type="button" data-search-close aria-label="Close search">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.6"></path></svg>
    </button>

    <form class="srch__box" role="search" data-search-form>
      <label class="sr-only" for="srch-input">Search Adhiloka</label>
      <input id="srch-input" type="search" placeholder="Search" autocomplete="off" data-search-input />
      <svg class="srch__glass" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </form>

    <ul class="srch__results" data-search-results aria-live="polite"></ul>

    <div class="srch__popular" data-search-popular>
      <p class="srch__label">Popular Pages</p>
      <ul class="srch__keys">
        {SEARCH_SUGGESTIONS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</div>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>

<style>
  .srch {
    position: fixed;
    inset: 0;
    z-index: 9995;
    background: #fff;
    overflow-y: auto;
    transform: translateY(-100%);
    transition: transform 0.45s ease;
  }
  .srch.is-open { transform: none; }

  .srch__inner { position: relative; padding-top: 150px; padding-bottom: 80px; }

  .srch__close {
    position: absolute;
    top: 24px;
    right: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: #000;
  }
  @media (max-width: 1219px) { .srch__close { right: 20px; } }

  .srch__box {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .srch__box input {
    width: 100%;
    height: 64px;
    padding-right: 48px;
    font-size: clamp(22px, 2.2vw, 32px);
    color: var(--ink);
  }
  .srch__box input::placeholder { color: var(--line); }
  .srch__box input::-webkit-search-cancel-button { display: none; }
  .srch__glass { position: absolute; right: 8px; top: 20px; color: var(--ink-muted); }

  .srch__results:not(:empty) { margin-top: 24px; }
  .srch__results :global(li) { border-bottom: 1px solid var(--line-soft); }
  .srch__results :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    font-size: 18px;
    color: var(--ink);
  }
  .srch__results :global(a:hover) { text-decoration: underline; }
  .srch__results :global(span) { font-size: 14px; color: var(--ink-muted); flex: none; }
  .srch__results :global(.srch__none) { padding: 16px 0; color: var(--ink-muted); }

  .srch__popular { margin-top: 48px; }
  .srch__label {
    font-size: 20px;
    font-weight: 530;
    color: var(--ink);
  }
  .srch__keys {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  .srch__keys a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 40px;
    font-size: 16px;
    color: var(--ink);
    transition: border-color 0.2s;
  }
  .srch__keys a:hover { border-color: var(--ink); }
</style>
