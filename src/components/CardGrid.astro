---
import { Image } from 'astro:assets';
import { getImageFor } from '../data/images';
import type { LinkCard } from '../data/pages/types';

/**
 * Grid kartu yang mengantar ke halaman lain — tulang punggung halaman hub.
 * Nomor urut dipakai sebagai penanda, bukan hiasan: pada lima kartu tanpa
 * gambar, itu satu-satunya hal yang membedakan barisnya.
 */
interface Props {
  cards: LinkCard[];
  /** Kolom pada layar lebar. Lima kartu terbaca lebih baik di tiga kolom. */
  columns?: 2 | 3;
  numbered?: boolean;
}

const { cards, columns = 3, numbered = true } = Astro.props;
---

<div class:list={['cards', `cards--${columns}`]}>
  {
    cards.map((card, i) => {
      const photo = getImageFor(card.image);
      return (
        <a href={card.href} class="card" data-reveal={String(i * 70)}>
          {photo && (
            <span class="card__plate plate">
              <Image
                src={photo}
                alt=""
                width={720}
                widths={[420, 720]}
                sizes="(max-width: 899px) 100vw, 33vw"
                loading="lazy"
                decoding="async"
                quality={70}
              />
            </span>
          )}

          <span class="card__head">
            {numbered && <span class="card__index">{String(i + 1).padStart(2, '0')}</span>}
            <span class="card__title">{card.title}</span>
          </span>

          <span class="card__body">{card.body}</span>
          <span class="card__cta sweep">{card.cta ?? 'Discover'}</span>
        </a>
      );
    })
  }
</div>

<style>
  /* Kolomnya dipatok, bukan auto-fit. Dengan auto-fit, lima kartu jatuh jadi
     empat plus satu yatim di baris kedua; tiga kolom membuatnya 3 + 2. */
  .cards {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(22px, 2.2vw, 32px);
    background: var(--paper);
    border: 1px solid var(--border-hairline);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .card:hover,
  .card:focus-visible {
    background: var(--paper-sunk);
    border-color: var(--rule-strong);
    color: inherit;
  }

  .card__plate {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 4px;
  }
  .card__plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .card__index {
    font-size: var(--type-micro);
    letter-spacing: var(--ls-label);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .card__title {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
  }

  .card__body {
    font-size: var(--type-ui);
    line-height: var(--leading-body);
    color: var(--ink-body);
  }

  /* Sweep di dalam kartu ikut menyapu saat kartunya di-hover, bukan hanya saat
     tulisannya sendiri disentuh. */
  .card__cta { margin-top: auto; padding-top: 10px; }
  .card:hover .card__cta::after,
  .card:focus-visible .card__cta::after {
    transform: scaleX(0);
    transform-origin: right;
  }
</style>
