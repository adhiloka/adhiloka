---
/**
 * Panah progres gulir, meniru seta-de-progresso di valeindonesia.com.
 *
 * Tombol bulat 64px yang menetap di kanan bawah. Cincin emasnya (r = 29,
 * keliling ±182) terisi mengikuti persen halaman yang sudah digulir; panah
 * emas di tengahnya menunjuk ke bawah dan berputar 180 derajat saat dasar
 * halaman tercapai. Klik: turun ke section berikutnya, atau kembali ke atas
 * bila sudah di dasar.
 */
---

<button type="button" class="sprog" data-scroll-progress aria-label="Go to next section">
  <svg class="sprog__ring" width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <circle class="sprog__track" cx="32" cy="32" r="29" stroke-width="2"></circle>
    <circle
      class="sprog__bar"
      cx="32"
      cy="32"
      r="29"
      stroke-width="2"
      stroke-dasharray="182.2"
      stroke-dashoffset="182.2"
      data-scroll-progress-bar></circle>
  </svg>
  <span class="sprog__arrow" aria-hidden="true"></span>
</button>

<script>
  import { initScrollProgress } from '../scripts/scroll-progress';
  document.addEventListener('astro:page-load', initScrollProgress);
</script>

<style>
  .sprog {
    position: fixed;
    z-index: 160;
    right: clamp(16px, 2.2vw, 40px);
    bottom: clamp(16px, 2.6vh, 30px);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
    transition: box-shadow 150ms ease-in-out;
  }
  .sprog:hover { box-shadow: 0 0 6px rgb(236 177 31 / 0.7); }

  .sprog__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
  }
  .sprog__track { stroke: rgb(0 126 122 / 0.14); }
  .sprog__bar {
    stroke: var(--gold);
    stroke-linecap: round;
  }

  /* Panah: batang + kepala dari satu elemen, menunjuk ke bawah. Kelas
     is-end memutarnya 180 derajat dalam 0,4 detik. */
  .sprog__arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 22px;
    border-radius: 2px;
    background: var(--gold);
    transform: translate(-50%, -50%) rotate(0deg);
    transition: transform 400ms ease;
  }
  .sprog__arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-right: 2px solid var(--gold);
    border-bottom: 2px solid var(--gold);
    transform: rotate(45deg);
    transform-origin: 70% 70%;
  }
  .sprog.is-end .sprog__arrow { transform: translate(-50%, -50%) rotate(180deg); }

  @media (max-width: 599px) {
    .sprog { width: 54px; height: 54px; }
    .sprog__ring { width: 54px; height: 54px; }
  }
</style>
