---
/**
 * Panah progres gulir, meniru seta-de-progresso di valeindonesia.com.
 *
 * Cincin emas transparan 64px yang terisi mengikuti persen halaman yang sudah
 * digulir; panah emas di tengahnya menunjuk ke bawah dan berputar 180 derajat
 * (0,4 detik) saat dasar halaman tercapai. Klik: turun satu langkah (lihat
 * langkahHalaman di scripts/sections.ts), atau kembali ke atas bila sudah di
 * dasar. Latarnya sengaja tidak diisi, seperti tombol Vale.
 */
---

<button type="button" class="sprog" data-scroll-progress aria-label="Go to next section">
  <svg class="sprog__ring" width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <circle class="sprog__track" cx="32" cy="32" r="29" stroke-width="3"></circle>
    <circle
      class="sprog__bar"
      cx="32"
      cy="32"
      r="29"
      stroke-width="3"
      stroke-dasharray="182.2"
      stroke-dashoffset="182.2"
      data-scroll-progress-bar></circle>
  </svg>
  <svg class="sprog__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 3v17M5.5 13.5 12 20l6.5-6.5" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  import { initScrollProgress } from '../scripts/scroll-progress';
  document.addEventListener('astro:page-load', initScrollProgress);
</script>

<style>
  .sprog {
    position: fixed;
    z-index: 160;
    right: clamp(16px, 2.2vw, 40px);
    bottom: clamp(16px, 2.6vh, 30px);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: transparent;
    transition: filter 150ms ease-in-out;
  }
  .sprog:hover,
  .sprog:focus-visible { filter: drop-shadow(0 0 6px rgb(236 177 31 / 0.75)); }

  .sprog__ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
    /* Bayangan tipis: cincin emas tetap terbaca di atas pita emas dan biru. */
    filter: drop-shadow(0 0 1.5px rgb(0 0 0 / 0.3));
  }
  .sprog__track { stroke: rgb(236 177 31 / 0.3); }
  .sprog__bar {
    stroke: var(--gold);
    stroke-linecap: round;
    transition: stroke-dashoffset 150ms linear;
  }

  /* Panah satu SVG yang berputar di pusatnya sendiri. */
  .sprog__arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: -12px 0 0 -12px;
    stroke: var(--gold);
    transform: rotate(0deg);
    transition: transform 400ms ease;
    filter: drop-shadow(0 0 1.5px rgb(0 0 0 / 0.3));
  }
  .sprog.is-end .sprog__arrow { transform: rotate(180deg); }

  @media (max-width: 599px) {
    .sprog { width: 54px; height: 54px; }
    .sprog__ring { width: 54px; height: 54px; }
  }
</style>
