---
import { Image } from 'astro:assets';
import { getImageFor, type ImageKey } from '../data/images';

/**
 * Kartu ala valeindonesia.com: foto bersudut 4px di atas kotak teks putih,
 * judul teal, naskah abu, dan tautan aksi teal berpanah emas. Tanpa bayangan.
 * Seluruh kartu bisa diklik; tautan aksinya hanya penanda visual.
 */
interface Props {
  title: string;
  body?: string;
  href: string;
  cta?: string;
  image?: ImageKey;
  alt?: string;
  meta?: string;
  /** Judul pembuka baca untuk pembaca layar, misalnya tanggal berita. */
  level?: 'h3' | 'h4';
}

const { title, body, href, cta = 'Learn more', image, alt = '', meta, level = 'h3' } = Astro.props;
const photo = getImageFor(image);
const Heading = level;
---

<article class="tile">
  <a class="tile__link" href={href}>
    <span class="tile__media plate">
      {
        photo && (
          <Image
            src={photo}
            alt={alt}
            width={760}
            widths={[380, 760]}
            sizes="(max-width: 699px) 80vw, 380px"
            loading="lazy"
            decoding="async"
            quality={64}
          />
        )
      }
    </span>
    <span class="tile__text">
      {meta && <span class="tile__meta">{meta}</span>}
      <Heading class="tile__title">{title}</Heading>
      {body && <span class="tile__body">{body}</span>}
      <span class="tile__cta action-link">{cta}</span>
    </span>
  </a>
</article>

<style>
  .tile { height: 100%; }
  .tile__link {
    height: 100%;
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .tile__link:hover { color: inherit; }

  .tile__media {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
  }
  .tile__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .tile__link:hover .tile__media :global(img) { transform: scale(1.04); }

  .tile__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 22px 26px;
    background: var(--paper);
  }
  .tile__meta {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .tile__title {
    font-size: clamp(20px, 1.5vw, 24px);
    font-weight: 500;
    line-height: 1.25;
    color: var(--teal);
  }
  .tile__body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-body);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Kartu putih tetap berteks teal walau berada di section teal (.on-dark). */
  .tile .tile__cta { margin-top: auto; padding-top: 6px; color: var(--teal); }
  .tile .tile__link:hover .tile__cta { color: var(--teal-deep); }
  .tile__link:hover .tile__cta {
    color: var(--teal-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tile__link:hover .tile__cta::after { transform: translateX(4px); }
</style>
