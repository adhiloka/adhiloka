---
import type { Channel } from '../data/pages/media';

/** Kartu per kanal. Semua tautan keluar, jadi rel dan target disetel di sini. */
interface Props {
  channels: Channel[];
}

const { channels } = Astro.props;
---

<div class="chan">
  {
    channels.map((c, i) => (
      <a
        href={c.href}
        class="chan__card"
        target="_blank"
        rel="noopener noreferrer me"
        data-reveal={String(i * 60)}
      >
        <span class="chan__name">{c.name}</span>
        <span class="chan__handle">{c.handle}</span>
        <span class="chan__body">{c.body}</span>
        <span class="chan__cta sweep">Open</span>
      </a>
    ))
  }
</div>

<style>
  .chan {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--grid-gap);
  }

  .chan__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: clamp(22px, 2.2vw, 32px);
    border: 1px solid var(--border-hairline);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .chan__card:hover,
  .chan__card:focus-visible {
    background: var(--paper-sunk);
    border-color: var(--rule-strong);
    color: inherit;
  }

  .chan__name {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    line-height: var(--leading-title);
    letter-spacing: var(--ls-title);
    color: var(--teal);
    font-weight: 500;
  }
  .chan__handle {
    font-size: 14px;
    color: var(--ink-muted);
    font-weight: 500;
  }
  .chan__body {
    margin-top: 8px;
    font-size: var(--type-ui);
    line-height: var(--leading-body);
    color: var(--ink-body);
  }
  .chan__cta { margin-top: auto; padding-top: 14px; }
  .chan__card:hover .chan__cta::after,
  .chan__card:focus-visible .chan__cta::after {
    transform: scaleX(0);
    transform-origin: right;
  }
</style>
