---
/**
 * Logo Adhiloka: lockup resmi (tanda + tulisan ADHILOKA) dari
 * public/brand/adhiloka-lockup.svg, dipasang apa adanya sebagai gambar.
 * Tulisannya sudah berupa kurva abu #77787B dengan tinggi huruf setengah
 * tinggi tanda, dan jarak tanda ke tulisan sudah diatur di berkasnya, jadi
 * komponen ini tidak menggambar atau menyetel huruf sendiri.
 *
 * `size` adalah tinggi lockup (setara tinggi tanda); lebarnya mengikuti rasio
 * 1575,5 : 328,3 dari viewBox berkas.
 */
interface Props {
  /** Tinggi lockup, mis. `var(--menu-h)`. */
  size?: string;
  class?: string;
}

const { size = '40px', class: className } = Astro.props;
---

<a
  href="/"
  class:list={['logo', className]}
  style={`--logo-h:${size}`}
  aria-label="Adhiloka Group — home"
>
  <img
    class="logo__img"
    src="/brand/adhiloka-lockup.svg"
    alt="Adhiloka"
    width="1575"
    height="328"
    decoding="async"
    fetchpriority="high"
  />
</a>

<style>
  .logo { display: inline-flex; }
  .logo__img {
    display: block;
    height: var(--logo-h);
    width: auto;
    aspect-ratio: 1575.5 / 328.3;
  }
</style>
