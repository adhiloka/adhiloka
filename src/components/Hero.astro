---
import { Image } from 'astro:assets';
import { HERO_SLIDES, type HeroSlide } from '../data/pages/home';
import { getImageFor, images } from '../data/images';

/**
 * Hero setinggi layar. Isi bawaannya karusel empat slide di beranda — dari
 * situlah seluruh takarannya berasal — tapi ia menerima daftar slide mana pun.
 * Dengan satu slide, panah dan titiknya tidak dirender dan yang tersisa adalah
 * foto ber-Ken Burns, judul yang naik, Discover, dan panah bawah.
 */
interface Props {
  slides?: HeroSlide[];
  /** Nama untuk pembaca layar. */
  label?: string;
}

const { slides = HERO_SLIDES, label = 'Adhiloka' } = Astro.props;
const banyak = slides.length > 1;

// Bingkai pertama video dipakai sebagai gambar hero. Ia dirender sebagai
// <Image> responsif, bukan atribut `poster` yang hanya menerima satu ukuran —
// di ponsel yang tampil versi ~400px, bukan 1920px.
const posterImage = images['hero-poster'];
---

<section
  class="hero"
  data-hero
  data-section-raw
  role="region"
  aria-roledescription={banyak ? 'carousel' : undefined}
  aria-label={label}
>
  <div class="hero__stage">
    {
      slides.map((slide, i) => {
        const img = getImageFor(slide.image);
        return (
          <div
            class="hero__layer"
            data-hero-slide={i}
            data-state={i === 0 ? 'current' : 'idle'}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length} — ${slide.headline}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <!-- Sumber video sengaja belum dipasang (data-src). Berkasnya 11 MB;
                 skrip hero yang memutuskan apakah layar dan koneksi ini pantas
                 mengunduhnya. Kalau tidak, poster WebP-nya yang tampil. -->
            <div class="hero__ken">
              {slide.kind === 'video' ? (
                <Fragment>
                  <Image
                    class="hero__poster"
                    src={posterImage}
                    alt={slide.shot}
                    width={1920}
                    widths={[600, 900, 1400, 1920]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    quality={62}
                  />
                  <video
                    data-hero-video
                    data-src="/media/hero.mp4"
                    muted
                    loop
                    playsinline
                    preload="none"
                  ></video>
                </Fragment>
              ) : img ? (
                <Image
                  src={img}
                  alt={slide.shot}
                  width={1920}
                  widths={[900, 1400, 1920, 2560]}
                  sizes="100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  quality={60}
                />
              ) : (
                <div
                  class="hero__plate"
                  style={`background:${slide.bg};background-image:repeating-linear-gradient(122deg,transparent 0 11px,${slide.stripe} 11px 12px)`}
                />
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="hero__veil" aria-hidden="true"></div>

  {
    banyak && (
      <Fragment>
        <button type="button" class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="Previous slide">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M14 3 6 11l8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
          </svg>
        </button>
        <button type="button" class="hero__arrow hero__arrow--next" data-hero-next aria-label="Next slide">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M8 3l8 8-8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
          </svg>
        </button>
      </Fragment>
    )
  }

  <div class="hero__content" data-hero-content>
    <h1 class="hero__headline" data-hero-headline>{slides[0].headline}</h1>
    {
      slides[0].href && (
        <a class="hero__cta sweep" href={slides[0].href} data-hero-cta>
          Discover
        </a>
      )
    }
  </div>

  {
    banyak && (
      <div class="hero__dots" role="tablist" aria-label="Choose slide">
        {slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            data-hero-dot={i}
            data-href={slide.href}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={slide.headline}
          />
        ))}
      </div>
    )
  }

  <button type="button" class="hero__cue" data-hero-cue aria-label="Scroll to next section">
    <svg width="24" height="15" viewBox="0 0 24 15" fill="none" aria-hidden="true">
      <path
        d="M2.6 2.6 12 12 21.4 2.6"
        stroke="currentColor"
        stroke-width="3.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</section>

<script>
  import { initHero } from '../scripts/hero';
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: var(--espresso);
    color: var(--ivory-1);
    touch-action: pan-y;
  }

  .hero__stage { position: absolute; inset: 0; }

  .hero__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    z-index: 0;
  }
  .hero__layer[data-state='current'] {
    opacity: 1;
    z-index: 1;
    animation: heroDissolveIn 1200ms ease forwards;
  }
  .hero__layer[data-state='leaving'] {
    opacity: 1;
    z-index: 0;
    animation: heroDissolveOut 1200ms ease forwards;
  }

  .hero__ken { position: absolute; inset: 0; }
  .hero__layer[data-state='current'] .hero__ken,
  .hero__layer[data-state='leaving'] .hero__ken {
    animation: heroKen 9000ms cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  .hero__ken :global(img),
  .hero__ken video,
  .hero__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Video duduk di atas posternya; selama belum ada sumber ia transparan,
     jadi yang terlihat adalah gambar di bawahnya. */
  .hero__ken video { z-index: 1; background: transparent; }
  .hero__ken :global(.hero__poster) { z-index: 0; }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(var(--shade-rgb) / 0.82) 0%,
      rgb(var(--shade-rgb) / 0.16) 46%,
      rgb(var(--shade-rgb) / 0.52) 100%
    );
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    color: var(--ivory-1);
    padding: 12px;
    opacity: 0.72;
    filter: drop-shadow(0 1px 10px rgb(var(--shade-rgb) / 0.65));
    transition: opacity 280ms ease;
  }
  .hero__arrow:hover { opacity: 1; color: var(--ivory-1); }
  .hero__arrow--prev { left: clamp(14px, 2.4vw, 36px); }
  .hero__arrow--next { right: clamp(14px, 2.4vw, 36px); }

  .hero__content {
    position: relative;
    z-index: 4;
    pointer-events: none;
    width: 100%;
    max-width: var(--measure-max);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(88px, 10.6vw, 132px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: heroTextIn 1100ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Berat 500, bukan 600: pada ukuran display Plus Jakarta Sans 600 terlalu
     padat di atas video dan bersaing dengan logo di header. */
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 5vw, 72px);
    line-height: var(--leading-display);
    letter-spacing: var(--ls-display);
    color: var(--on-image);
    text-shadow: 0 1px 30px rgb(var(--shade-rgb) / 0.5);
    max-width: 16em;
  }

  .hero__cta {
    margin-top: clamp(16px, 1.8vw, 26px);
    pointer-events: auto;
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    padding-bottom: 5px;
    color: var(--on-image);
    text-shadow: 0 1px 14px rgb(var(--shade-rgb) / 0.6);
  }
  .hero__cta:hover,
  .hero__cta:focus-visible { color: var(--on-image); }

  /* Garisnya menyapu begitu kursor masuk ke hero, bukan hanya ke tautannya. */
  .hero:hover .hero__cta::after {
    transform: scaleX(0);
    transform-origin: right;
  }

  .hero__dots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: clamp(37px, 5.4vw, 65px);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 3px;
    filter: drop-shadow(0 1px 6px rgb(var(--shade-rgb) / 0.7));
  }
  /* Titiknya kecil karena desainnya begitu, tapi sasaran kliknya 24px —
     syarat minimum WCAG 2.5.8 tanpa mengubah tampilan. */
  .hero__dots button {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    padding: 0;
    display: grid;
    place-items: center;
    background: none;
  }
  .hero__dots button::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.4);
    transition: background 280ms ease, width 280ms ease, height 280ms ease;
  }
  .hero__dots button[aria-selected='true']::before {
    width: 6px;
    height: 6px;
    background: var(--ivory-1);
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: clamp(10px, 1.6vw, 20px);
    z-index: 4;
    padding: 10px 16px;
    color: oklch(1 0 0);
    filter: drop-shadow(0 1px 10px rgb(var(--shade-rgb) / 0.65));
    transition: opacity 300ms ease;
  }
  .hero__cue:hover { opacity: 0.6; color: oklch(1 0 0); }
  .hero__cue svg { animation: cue 1.6s ease-in-out infinite; }

  @media (max-width: 599px) {
    .hero__arrow { display: none; }
  }
</style>
