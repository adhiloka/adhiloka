---
import { Image } from 'astro:assets';
import { HERO_SLIDES, type HeroSlide } from '../data/pages/home';
import { getImageFor } from '../data/images';

/**
 * Hero setinggi layar, meniru hero valeindonesia.com: foto penuh diredupkan
 * (brightness 0,8) dengan gradien hitam dari kiri, judul dua tingkat di kiri
 * atas (baris pengantar 38px/500, judul 52–63px/600), titik slide vertikal di
 * tepi kiri, dan panah putih yang mengambang di tengah bawah. Slide berganti
 * dengan memudar 0,6 detik dan maju sendiri; dengan satu slide, titik dan
 * putaran otomatisnya tidak ada.
 */
interface Props {
  slides?: HeroSlide[];
  /** Nama untuk pembaca layar. */
  label?: string;
}

const { slides = HERO_SLIDES, label = 'Adhiloka' } = Astro.props;
const banyak = slides.length > 1;
const first = slides[0];

// Di beranda "Discover" membuka halaman tiap slide. Di halaman lain (hub dan
// Contact) section 1 hanya satu foto, dan Discover menggulir ke section
// berikutnya alih-alih membuka halaman baru.
const scrollCta = Astro.url.pathname !== '/';
---

<section
  class="hero"
  data-hero
  data-section-raw
  role="region"
  aria-roledescription={banyak ? 'carousel' : undefined}
  aria-label={label}
>
  <div class="hero__stage">
    {
      slides.map((slide, i) => {
        const img = getImageFor(slide.image);
        return (
          <div
            class="hero__layer"
            data-hero-slide={i}
            data-state={i === 0 ? 'current' : 'idle'}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length}: ${slide.headline}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            {img ? (
              <Image
                src={img}
                alt={slide.shot}
                width={1920}
                widths={[900, 1400, 1920, 2560]}
                sizes="100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                quality={62}
              />
            ) : (
              <div
                class="hero__plate"
                style={`background:${slide.bg};background-image:repeating-linear-gradient(122deg,transparent 0 11px,${slide.stripe} 11px 12px)`}
              />
            )}
          </div>
        );
      })
    }
  </div>

  <div class="hero__caption" data-hero-content>
    <p class="hero__intro" data-hero-intro>{first.sub ?? first.eyebrow}</p>
    <h1 class="hero__headline" data-hero-headline>{first.headline}</h1>
    {
      scrollCta ? (
        <button type="button" class="hero__cta" data-hero-cta-scroll>
          Discover
          <svg width="12" height="16" viewBox="0 0 12 16" fill="none" aria-hidden="true">
            <path d="M6 1v13M1.5 9.5 6 14l4.5-4.5" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
      ) : (
        first.href && (
          <a class="hero__cta" href={first.href} data-hero-cta>
            Discover
            <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
              <path d="M0 6h14M9.5 1.5 14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </a>
        )
      )
    }
  </div>

  {
    banyak && (
      <div class="hero__dots" role="tablist" aria-label="Choose slide">
        {slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            data-hero-dot={i}
            data-href={slide.href}
            data-intro={slide.sub ?? slide.eyebrow}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={slide.headline}
          />
        ))}
      </div>
    )
  }

  <!-- Panah mengambang (seta-navegacao di Vale): naik-turun 1rem, 2 detik. -->
  <button type="button" class="hero__cue" data-hero-cue aria-label="Scroll to next section">
    <span class="hero__cue-arrow" aria-hidden="true"></span>
  </button>
</section>

<script>
  import { initHero } from '../scripts/hero';
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--teal-dark);
    color: var(--on-image);
    touch-action: pan-y;
  }

  .hero__stage { position: absolute; inset: 0; }

  /* Pergantian slide memudar 0,6 detik, seperti carousel-fade di Vale. */
  .hero__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    z-index: 0;
    transition: opacity 600ms ease;
  }
  .hero__layer[data-state='current'] { opacity: 1; z-index: 1; }
  .hero__layer[data-state='leaving'] { opacity: 0; z-index: 1; }

  .hero__layer :global(img),
  .hero__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.8);
  }

  /* Gradien hitam dari tepi kiri ke tengah: judul putih selalu terbaca
     tanpa menggelapkan seluruh foto. */
  .hero__layer::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 50%;
    z-index: 1;
    background: linear-gradient(to right, rgb(0 0 0 / 0.65) 0%, rgb(0 0 0 / 0) 100%);
    pointer-events: none;
  }

  /* ── Judul ──────────────────────────────────────────────────────────── */
  .hero__caption {
    position: absolute;
    z-index: 4;
    top: max(21vh, calc(var(--hero-top-clear, 190px) + 24px));
    left: 10vw;
    max-width: min(40vw, 640px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: heroTextIn 700ms ease both;
  }

  .hero__intro {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(26px, 2.5vw, 38px);
    line-height: 1.25;
    color: var(--on-image);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
  }

  .hero__headline {
    margin-top: clamp(14px, 1.6vw, 24px);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--type-display);
    line-height: var(--leading-display);
    letter-spacing: var(--ls-display);
    color: var(--on-image);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
  }

  .hero__cta {
    margin-top: clamp(22px, 2.4vw, 34px);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 9px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--on-image);
    color: var(--on-image);
    font-size: var(--type-ui);
    font-weight: 500;
    transition: background 150ms ease-in-out, color 150ms ease-in-out, box-shadow 150ms ease-in-out;
  }
  .hero__cta svg { color: var(--gold); }
  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--on-image);
    color: var(--teal);
    box-shadow: 0 0 6px rgb(255 255 255 / 0.6);
  }

  /* ── Titik slide: vertikal di tepi kiri ─────────────────────────────── */
  .hero__dots {
    position: absolute;
    z-index: 4;
    left: clamp(16px, 2vw, 32px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* Titiknya 16px seperti Vale; sasaran kliknya 32px. */
  .hero__dots button {
    width: 32px;
    height: 32px;
    padding: 0;
    display: grid;
    place-items: center;
    background: none;
  }
  .hero__dots button::before {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--on-image);
    background: transparent;
    transition: background 300ms ease, border-color 300ms ease;
  }
  .hero__dots button[aria-selected='true']::before {
    background: var(--sky);
    border-color: var(--sky);
  }
  .hero__dots button:hover::before { border-color: var(--sky); }

  /* ── Panah mengambang ───────────────────────────────────────────────── */
  .hero__cue {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 1.25rem;
    margin-left: -24px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    animation: floating 2s ease-in-out infinite;
  }
  .hero__cue-arrow {
    position: relative;
    width: 1rem;
    height: 1.5rem;
  }
  .hero__cue-arrow::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    margin: auto;
    width: 2px;
    height: 1.25rem;
    border-radius: 10px;
    background: var(--on-image);
    box-shadow: 0 0 4px rgb(0 0 0 / 0.5);
  }
  .hero__cue-arrow::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    margin: auto;
    width: 0.625rem;
    height: 0.625rem;
    border-bottom: 2px solid var(--on-image);
    border-right: 2px solid var(--on-image);
    transform: rotate(45deg);
  }

  @media (max-width: 899px) {
    .hero__caption {
      top: auto;
      bottom: clamp(88px, 16vh, 140px);
      left: var(--gutter);
      right: var(--gutter);
      max-width: none;
    }
    .hero__layer::before {
      width: 100%;
      background: linear-gradient(to top, rgb(0 0 0 / 0.6) 0%, rgb(0 0 0 / 0) 70%);
    }
    .hero__dots {
      top: auto;
      bottom: clamp(88px, 16vh, 140px);
      transform: none;
      left: auto;
      right: 8px;
    }
  }
</style>
