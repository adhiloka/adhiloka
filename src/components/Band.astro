---
import { Image } from 'astro:assets';
import { getImageFor, type ImageKey } from '../data/images';
import Waves from './Waves.astro';
import type { Ground } from '../data/ground';

/**
 * Pita naskah + foto, meniru secao-imagem di valeindonesia.com: latar pita
 * berwarna (putih, emas, atau biru langit), naskah di satu sisi, foto dalam
 * bingkai bersudut 4px dengan gelombang di sudut kanan bawah di sisi lain.
 * Naskah masuk dari sisinya, foto dibuka tirai teal.
 *
 * `ground` memetakan ke warna Vale: paper = putih, sunk = emas, plate = biru
 * langit, tint = teal sangat pucat, teal = teal solid. Urutan di halaman
 * diatur `groundAt()` di data/ground.ts. Foto diberi bilah aksen 25px di sisi
 * kiri seperti foto di Vale: oranye di pita emas, emas di pita teal, teal di
 * pita lain.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  body: string;
  /** Butir pendek di bawah naskah; dipisah garis rambut. */
  points?: string[];
  cta?: string;
  href?: string;
  /** Keterangan untuk slot foto; tetap dipakai sebagai alt. */
  caption: string;
  image?: ImageKey;
  /** Titik fokus foto (`object-position`). */
  focus?: string;
  /** Foto pindah ke kiri, naskah ke kanan. */
  reverse?: boolean;
  ground?: Ground;
  /** Nama lama; pita kini selalu berbingkai. */
  inset?: boolean;
}

const {
  id,
  eyebrow,
  title,
  body,
  points,
  cta,
  href,
  caption,
  image,
  focus,
  reverse = false,
  ground = 'paper',
} = Astro.props;

const photo = getImageFor(image);
const TONES: Record<Ground, string> = {
  paper: 'white',
  sunk: 'gold',
  plate: 'sky',
  tint: 'tint',
  teal: 'teal',
};
const tone = TONES[ground];
// Emas dan biru langit memakai teks gelap; teal memakai teks putih.
const onColor = tone === 'gold' || tone === 'sky';
const onDark = tone === 'teal';
---

<section
  class:list={['band', `band--${tone}`, reverse && 'band--reverse', onColor && 'on-color', onDark && 'on-dark']}
  id={id}
  aria-labelledby={id ? `${id}-title` : undefined}
>
  <div class="frame band__grid">
    <div class="band__copy" data-reveal data-reveal-from={reverse ? 'right' : 'left'}>
      {eyebrow && <span class="eyebrow band__eyebrow">{eyebrow}</span>}
      <h2 class="band__title" id={id ? `${id}-title` : undefined}>{title}</h2>
      <p class="band__body">{body}</p>

      {
        points && (
          <ul class="band__points">
            {points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )
      }

      {cta && href && <a class={onDark ? 'btn-white' : 'btn-solid'} href={href}>{cta}</a>}
    </div>

    <div class="band__media plate" data-curtain style={focus ? `--band-focus:${focus}` : undefined}>
      {
        photo ? (
          <Image
            src={photo}
            alt={caption}
            width={1100}
            widths={[600, 900, 1100]}
            sizes="(max-width: 899px) 90vw, 45vw"
            loading="lazy"
            decoding="async"
            quality={70}
          />
        ) : (
          <span class="plate__caption">{caption}</span>
        )
      }
      <Waves kind="corner" />
    </div>
  </div>
</section>

<style>
  .band {
    padding: clamp(56px, 6vw, 96px) var(--gutter);
    background: var(--paper);
    color: var(--ink-body);
  }
  .band--gold { background: var(--gold); --wave-ground: var(--gold); --wave-accent: var(--teal); --band-bar: var(--orange); }
  .band--sky { background: var(--sky); --wave-ground: var(--sky); --band-bar: var(--teal); }
  .band--tint { background: var(--tint-teal); --wave-ground: var(--tint-teal); --band-bar: var(--teal); }
  .band--teal { background: var(--teal); color: var(--paper); --wave-ground: var(--teal); --wave-accent: var(--gold); --band-bar: var(--gold); }
  .band--white { --band-bar: var(--teal); }

  .band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .band--reverse .band__copy { order: 2; }

  .band__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(16px, 1.6vw, 22px);
    max-width: 36em;
  }

  .band__title {
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--teal);
  }
  .band__body {
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .band__points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* Butir ala Vale: panah emas kecil, bukan garis rambut. */
  .band__points li {
    position: relative;
    padding-left: 22px;
    font-size: var(--type-ui);
    line-height: 1.5;
  }
  .band__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    border-top: 2px solid var(--gold);
    border-right: 2px solid var(--gold);
    transform: rotate(45deg);
  }

  .band__copy :global(.btn-solid) { margin-top: 10px; }

  /* Di atas emas dan biru langit semua teks jadi tinta gelap: teal di atas
     emas cuma 2,5:1, abu di atas emas 3,9:1. Panah butir ikut teal. */
  .on-color .band__title,
  .on-color .band__eyebrow,
  .on-color .band__body,
  .on-color .band__points li { color: var(--ink); }
  .on-color .band__points li::before { border-color: var(--teal); }

  /* Pita teal: semua teks putih, panah butir emas. */
  .on-dark .band__title,
  .on-dark .band__eyebrow,
  .on-dark .band__body,
  .on-dark .band__points li { color: var(--paper); }
  .on-dark .band__points li::before { border-color: var(--gold); }

  .band__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 16 / 11;
  }
  /* Bilah aksen di sisi kiri foto (animacao-caixa di Vale). */
  .band__media::before {
    content: '';
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: 0;
    width: clamp(16px, 1.7vw, 25px);
    background: var(--band-bar, var(--teal));
    pointer-events: none;
  }
  .band__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--band-focus, 50% 50%);
  }
  .band__media :global(.plate__caption) {
    left: 20px;
    right: 20px;
    bottom: 16px;
  }

  @media (max-width: 899px) {
    .band__grid { grid-template-columns: 1fr; }
    .band__media { order: -1; }
    .band--reverse .band__copy { order: 0; }
  }
</style>
