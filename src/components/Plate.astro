---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Keterangan huruf kecil yang dibawa slot ini sampai foto asli tersedia. */
  caption: string;
  ratio?: string;
  image?: ImageMetadata | null;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  /** Atribut lain (mis. data-reveal) diteruskan ke elemen pembungkus. */
  [key: string]: unknown;
}

const {
  caption,
  ratio,
  image = null,
  widths = [400, 700, 1000],
  sizes = '(max-width: 899px) 100vw, 45vw',
  class: className,
  loading = 'lazy',
  ...rest
} = Astro.props;
---

<div
  class:list={['plate', className]}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
  {...rest}
>
  {
    image ? (
      <Image
        src={image}
        alt={caption}
        width={Math.max(...widths)}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        quality={74}
      />
    ) : (
      <span class="plate__caption">{caption}</span>
    )
  }
  <slot />
</div>

<style>
  .plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
