---
import { FOOTER_COLUMNS, SOCIAL, SITE } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<!-- Footer ala valeindonesia.com: blok teal pendek dengan satu baris kolom.
     Kolom pertama memuat merek, sosial, dan kontak (seperti kolom "Vale" +
     ikon sosial di Vale); sisanya satu kolom per menu utama kita, judul 18px
     dan tautan 14px. Logo duduk di kapsul putih karena gelombang hijau pada
     logo hilang di atas teal. -->
<footer class="site-footer on-dark">
  <div class="site-footer__inner">
    <div class="site-footer__cols">
      <div class="site-footer__brand">
        <Logo class="site-footer__logo" size="clamp(30px, 2.4vw, 38px)" />
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <ul class="site-footer__social" aria-label="Follow us">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href} rel="noopener noreferrer me" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="site-footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>

      {
        FOOTER_COLUMNS.map((col) => (
          <nav class="site-footer__col" aria-label={col.title}>
            <h2 class="site-footer__title">{col.title}</h2>
            <ul class="site-footer__links">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__base" data-footer-base>
      <p>&copy; {year} {SITE.legalName} | All rights reserved.</p>
      <p>{SITE.region} · Medan, North Sumatra, Indonesia · <a href="/contact/">Contact</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal);
    color: var(--paper);
  }

  /* Padding atas-bawah 32px seperti blok teal Vale (py-5 = 32px). */
  .site-footer__inner {
    max-width: var(--measure-max);
    margin-inline: auto;
    padding: 32px var(--gutter) 20px;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: minmax(200px, 1.25fr) repeat(5, minmax(0, 1fr));
    gap: 20px clamp(18px, 2vw, 32px);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  /* Kapsul putih untuk logo: tanda berwarna penuhnya tetap terbaca. */
  :global(.site-footer__logo) {
    padding: 8px 20px 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--paper);
  }
  .site-footer__tagline { font-size: 14px; line-height: 1.4; }

  .site-footer__title {
    margin-bottom: 10px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
  }

  .site-footer__links,
  .site-footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .site-footer__links a,
  .site-footer__social a,
  .site-footer__mail,
  .site-footer__base a {
    font-size: 14px;
    line-height: 1.45;
    color: var(--paper);
    overflow-wrap: anywhere;
  }
  .site-footer__links a:hover,
  .site-footer__links a:focus-visible,
  .site-footer__social a:hover,
  .site-footer__social a:focus-visible,
  .site-footer__mail:hover,
  .site-footer__base a:hover {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Sosial dalam satu baris, seperti deretan ikon sosial di Vale. */
  .site-footer__social {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .site-footer__social a { font-weight: 500; }

  .site-footer__base {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--border-on-ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    font-size: 13px;
  }

  @media (max-width: 1079px) {
    .site-footer__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 599px) {
    .site-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
