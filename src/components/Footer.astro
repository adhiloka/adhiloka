---
import { FOOTER_COLUMNS, SOCIAL, SITE } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<!-- Footer ala valeindonesia.com: blok teal penuh lebar, teks putih, kolom
     tautan, lalu baris dasar dengan hak cipta. Logo duduk di kapsul putih,
     karena gelombang hijau pada logo hilang di atas teal. -->
<footer class="site-footer on-dark">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <Logo class="site-footer__logo" size="clamp(34px, 2.6vw, 42px)" />
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>

    <div class="site-footer__cols">
      {
        FOOTER_COLUMNS.map((col) => (
          <nav class="site-footer__col" aria-label={col.title}>
            <h2 class="site-footer__title">{col.title}</h2>
            <ul class="site-footer__links">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav class="site-footer__col" aria-label="Contact and social">
        <h2 class="site-footer__title">Contact</h2>
        <ul class="site-footer__links">
          <li><a href="/contact/">Contact us</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>
        </ul>
        <ul class="site-footer__social" aria-label="Follow us">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href} rel="noopener noreferrer me" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__base" data-footer-base>
      <p class="site-footer__legal">&copy; {year} {SITE.legalName} | All rights reserved.</p>
      <p class="site-footer__region">{SITE.region} · Medan, North Sumatra, Indonesia</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal);
    color: var(--paper);
  }

  .site-footer__inner {
    max-width: var(--measure-max);
    margin-inline: auto;
    padding: clamp(48px, 5vw, 80px) var(--gutter) clamp(28px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 4vw, 56px);
  }

  .site-footer__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
  }
  /* Kapsul putih untuk logo: tanda berwarna penuhnya tetap terbaca. */
  :global(.site-footer__logo) {
    padding: 10px 26px 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
  }
  :global(.site-footer__logo):hover { color: var(--ink); }
  .site-footer__tagline {
    font-size: clamp(18px, 1.3vw, 21px);
    font-weight: 500;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(28px, 3vw, 48px);
  }

  .site-footer__title {
    margin-bottom: 18px;
    font-size: clamp(18px, 1.3vw, 21px);
    font-weight: 500;
    line-height: 1.25;
  }

  .site-footer__links,
  .site-footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer__links a,
  .site-footer__social a {
    font-size: 16px;
    line-height: 1.45;
    color: var(--paper);
    overflow-wrap: anywhere;
  }
  .site-footer__links a:hover,
  .site-footer__links a:focus-visible,
  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__social {
    margin-top: 22px;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .site-footer__social a { font-weight: 500; }

  .site-footer__base {
    padding-top: clamp(20px, 2vw, 28px);
    border-top: 1px solid var(--border-on-ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 14px;
  }
</style>
