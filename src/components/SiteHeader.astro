---
import { Image } from 'astro:assets';
import { MENU } from '../data/menu';
import { getImageFor } from '../data/images';

/* Header ala adani.com: tetap di atas, putih 70 % dengan blur, lockup di kiri
 * dan menu kapital di kanan. Mega-menu desktop terbuka saat hover (≥1027 px),
 * di bawahnya menjadi laci dari kanan dengan akordeon, persis perilaku Adani.
 * Menu utamanya tetap menu Adhiloka (NAV di site.ts).
 *
 * Isi mega-menu memakai konsep Adhiloka versi pertama (yang meniru
 * robertet.com): foto utama berjudul dengan panah di kiri, menuju halaman
 * induk, lalu kolom tautan di kanan. Dengan kolom saja panelnya banyak ruang
 * kosong, karena menu Adhiloka jauh lebih sedikit tautannya daripada Adani. */

interface Props {
  active: string;
}
const { active } = Astro.props;

const isActive = (href: string) => active === href || active.startsWith(href);
---

<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <a class="hdr__logo" href="/" aria-label="Adhiloka, home">
      <img src="/brand/adhiloka-lockup.svg" alt="Adhiloka" width="166" height="34" />
    </a>

    <button class="hdr__search-m" type="button" data-search-open aria-label="Search">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>

    <button class="hdr__burger" type="button" data-burger aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span></span><span></span><span></span><span></span>
    </button>

    <nav class="hdr__nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="hdr__list">
        {
          MENU.map((item) => (
            <li class:list={['hdr__item', { 'is-active': isActive(item.href), 'has-mega': item.columns.length > 0 }]} data-item>
              <a class:list={['hdr__link', { 'has-child': item.columns.length > 0 }]} href={item.href} data-top>
                {item.label}
              </a>
              {item.columns.length > 0 && (
                <div class="mega" data-mega>
                  <div class="mega__wrap">
                    {item.panel && (
                      <a class="mega__feature" href={item.href} tabindex="-1">
                        {getImageFor(item.panel.image) && (
                          <Image
                            class="mega__img"
                            src={getImageFor(item.panel.image)!}
                            alt=""
                            widths={[480, 800]}
                            sizes="(max-width: 1399px) 380px, 34vw"
                            quality={66}
                            loading="eager"
                            fetchpriority="low"
                            decoding="async"
                          />
                        )}
                        <span class="mega__label">
                          <span>{item.panel.title}</span>
                          <svg class="mega__arrow" viewBox="0 0 46 12" width="46" height="12" aria-hidden="true"><path d="M0 6h44M39 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                        </span>
                      </a>
                    )}
                    <div class="mega__cols">
                    {item.columns.map((col) => (
                      <div class="mega__col">
                        <a class="mega__head" href={col.head.href}>{col.head.label}</a>
                        {col.links && (
                          <ul class="mega__links">
                            {col.links.map((l) => (
                              <li><a href={l.href}>{l.label}</a></li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
        <li class="hdr__item hdr__item--lang" data-item>
          <a class="hdr__link has-child" href="#" data-top>ENG</a>
          <div class="lang" data-mega>
            <a href="/" aria-current="true">ENG</a>
            <a href="#" lang="id">IND</a>
          </div>
        </li>
        <li class="hdr__item hdr__item--search">
          <button class="hdr__icon" type="button" data-search-open aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>

<style>
  /* `header` Adani: putih 70 % + blur 10 px, dan TIDAK memutih saat hover —
     foto hero tetap tembus di balik menu. Hanya laci mobile yang padat. */
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 9991;
    background: rgb(255 255 255 / 0.7);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background 0.3s;
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    height: var(--header-h);
  }

  /* `.logo` Adani lebarnya 7 % kontainer, jadi ikut membesar dengan layar
     (31 px tinggi di 1440, 43 px di 1920). Lockup kita jauh lebih lebar dan
     tulisannya lebih kecil daripada wordmark Adani, maka tingginya dihitung
     dari rumus yang sama lalu diperbesar ±25 % agar bobot visualnya setara. */
  .hdr__logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 6px 6px 6px 0;
    margin-right: 3%;
  }
  .hdr__logo img {
    height: clamp(30px, calc((6.22vw - 6px) / 2.1), 46px);
    width: auto;
  }

  .hdr__nav { flex: 1; height: 100%; }
  .hdr__list {
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    height: 100%;
  }

  /* `nav ul li` Adani: jarak antarmenu berubah per lebar layar
     (18 → 15 → 11 → 6 → 4/5 → 3 px), ditambah padding tautan 10 px, atau
     20 px di KEDUA sisi untuk menu berpanah. */
  .hdr__item {
    display: flex;
    align-items: center;
    padding: 0 18px;
  }
  @media (max-width: 2099px) { .hdr__item { padding: 0 15px; } }
  @media (max-width: 1799px) { .hdr__item { padding: 0 11px; } }
  @media (max-width: 1679px) { .hdr__item { padding: 0 6px; } }
  @media (max-width: 1599px) { .hdr__item { padding: 0 4px; } }
  @media (max-width: 1549px) { .hdr__item { padding: 0 5px; } }
  @media (max-width: 1365px) { .hdr__item { padding: 0 3px; } }

  /* `nav ul li a`: 1,4 rem semibold kapital, panah 7 px dari garis sudut
     yang diputar, garis gradien 4 px menempel di tepi bawah header. */
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    font-size: calc(1.4 * var(--rem));
    font-weight: 530;
    letter-spacing: 0.006em;
    color: #000;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hdr__link.has-child { padding: 0 20px; }
  .hdr__link.has-child::after {
    content: '';
    position: absolute;
    right: 5px;
    top: calc(50% - 6px);
    width: 7px;
    height: 7px;
    border-top: 1px solid #000;
    border-left: 1px solid #000;
    transform: rotate(-135deg);
    transition: transform 0.2s, top 0.2s;
  }
  .hdr__link::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--grad-bar);
    transform: scale(0);
    transition: transform 0.3s ease-out;
  }
  .hdr__item.is-active > .hdr__link::before { transform: scale(1); }

  /* Pemilih bahasa Adani memakai segitiga padat 4 px, bukan panah garis. */
  @media (min-width: 1027px) {
    .hdr__item--lang .hdr__link.has-child { padding: 0 16px 0 10px; }
    .hdr__item--lang .hdr__link.has-child::after {
      right: 2px;
      top: calc(50% - 2px);
      width: 0;
      height: 0;
      border: 4px solid transparent;
      border-top-color: #000;
      border-bottom: 0;
      transform: none;
    }
  }

  .hdr__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: #000;
  }

  .hdr__search-m,
  .hdr__burger { display: none; }

  /* ── Mega-menu desktop ─────────────────────────────────────────────── */
  @media (min-width: 1027px) {
    .hdr__item:hover > .hdr__link::before,
    .hdr__item:focus-within > .hdr__link::before { transform: scale(1); }
    .hdr__item:not(.hdr__item--lang):hover > .hdr__link.has-child::after,
    .hdr__item:not(.hdr__item--lang):focus-within > .hdr__link.has-child::after {
      transform: rotate(45deg);
      top: calc(50% - 2px);
    }

    /* Bayangan hanya saat terbuka: panel tertutup setinggi 0 tetap
       melemparkan bayangannya ke foto hero. */
    .mega {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--header-h);
      background: var(--bg-menu);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, box-shadow 0.35s ease;
    }
    .hdr__item:hover > .mega,
    .hdr__item:focus-within > .mega {
      max-height: 80vh;
      box-shadow: 0 10px 20px rgb(0 0 0 / 0.08);
    }

    /* Foto utama selebar 34 % kontainer, sisanya kolom tautan. */
    .mega__wrap {
      display: grid;
      grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
      gap: 60px;
      align-items: start;
      width: var(--wrap);
      max-width: 1920px;
      margin: 0 auto;
      padding: 40px 0 50px;
    }
    .mega__cols {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 36px 48px;
    }
    .mega__col { min-width: 0; }

    /* Pelat berjudul versi pertama Adhiloka: foto 16:9, judul kapital dan
       panah di kiri bawah; hover memperbesar foto pelan dan menggeser panah. */
    .mega__feature {
      position: relative;
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #2b2f2e;
      color: #fff;
    }
    .mega__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s ease;
    }
    .mega__feature::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 65%;
      background: linear-gradient(to bottom, transparent, #000);
      opacity: 0.7;
    }
    .mega__label {
      position: absolute;
      z-index: 1;
      left: 24px;
      right: 24px;
      bottom: 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: 22px;
      font-weight: 530;
      line-height: 1.1;
      text-transform: uppercase;
    }
    .mega__label::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -10px;
      width: 60%;
      height: 3px;
      background: var(--grad-bar);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    .mega__arrow { flex: none; transition: transform 0.5s ease; }
    .mega__feature:hover .mega__img { transform: scale(1.05); }
    .mega__feature:hover .mega__arrow { transform: translateX(10px); }
    .mega__feature:hover .mega__label::after { transform: none; }

    .hdr__item--lang { position: relative; }
    .lang {
      position: absolute;
      top: 100%;
      left: 0;
      display: flex;
      flex-direction: column;
      min-width: 120px;
      max-height: 0;
      overflow: hidden;
      background: var(--bg-menu);
      transition: max-height 0.3s ease;
    }
    .hdr__item--lang:hover .lang,
    .hdr__item--lang:focus-within .lang { max-height: 200px; }
    .lang a {
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 530;
      color: #000;
    }
    .lang a[aria-current] { opacity: 0.5; }
  }

  /* Kepala kolom: 20 px, garis bawah #c1c1c1, persis `.column-head span`. */
  .mega__head {
    display: block;
    padding-bottom: 20px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
    font-size: 20px;
    font-weight: 360;
    color: #000;
    white-space: nowrap;
  }
  .mega__head:hover { text-decoration: underline; }
  .mega__links li { padding: 13.5px 0 0; }
  .mega__links a {
    font-size: 16px;
    color: #000;
    opacity: 0.6;
  }
  .mega__links a:hover { opacity: 1; text-decoration: underline; }

  @media (max-width: 1399px) and (min-width: 1027px) {
    .mega__head { font-size: 18px; white-space: normal; }
    .mega__links li { padding-top: 8px; }
    .mega__wrap { grid-template-columns: minmax(0, 32%) minmax(0, 1fr); gap: 40px; }
    .mega__cols { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 28px 32px; }
    .mega__label { font-size: 18px; left: 18px; bottom: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega__img,
    .mega__arrow { transition: none; }
    .mega__feature:hover .mega__img { transform: none; }
  }

  /* ── Laci mobile (≤1026 px) ──────────────────────────────────────────── */
  @media (max-width: 1026px) {
    .hdr.is-open { background: #fff; }
    .hdr__logo img { height: 34px; }

    .hdr__search-m {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin-left: auto;
      color: #000;
    }

    .hdr__burger {
      position: relative;
      display: block;
      width: 30px;
      height: 21px;
      margin-left: 12px;
    }
    .hdr__burger span {
      position: absolute;
      left: 10%;
      width: 80%;
      height: 2px;
      border-radius: 25px;
      background: #000;
      transition: 0.25s ease-in-out;
    }
    .hdr__burger span:nth-child(1) { top: 0; }
    .hdr__burger span:nth-child(2),
    .hdr__burger span:nth-child(3) { top: 9px; }
    .hdr__burger span:nth-child(4) { top: 18px; }
    .is-open .hdr__burger span:nth-child(1),
    .is-open .hdr__burger span:nth-child(4) { top: 9px; width: 0; left: 50%; }
    .is-open .hdr__burger span:nth-child(2) { transform: rotate(45deg); }
    .is-open .hdr__burger span:nth-child(3) { transform: rotate(-45deg); }

    .hdr__nav {
      position: fixed;
      top: var(--header-h);
      right: -100%;
      width: 100%;
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      background: #fff;
      transition: right 0.4s ease-in-out;
    }
    .is-open .hdr__nav { right: 0; }

    .hdr__list {
      display: block;
      width: 88.88%;
      height: auto;
      margin: 0 auto;
      padding: 10px 0 40px;
    }
    .hdr__item {
      display: block;
      padding: 0;
      border-bottom: 1px solid #808080;
    }
    .hdr__item--search { display: none; }
    .hdr__link {
      display: block;
      height: auto;
      padding: 20px 0;
      font-size: 18px;
    }
    /* `.hdr__link.has-child` desktop (padding 0 20px) lebih spesifik daripada
       `.hdr__link` di atas, jadi padding laci ditulis ulang lengkap di sini. */
    .hdr__link.has-child { padding: 20px 30px 20px 0; }
    .hdr__link.has-child::after {
      right: 4px;
      top: 26px;
      width: 10px;
      height: 10px;
    }
    .hdr__item.is-sub > .hdr__link.has-child::after { transform: rotate(45deg); top: 30px; }
    .hdr__link::before { display: none; }

    .mega,
    .lang,
    .mega__feature { display: none; }
    .is-sub > .mega,
    .is-sub > .lang { display: block; }
    .mega__wrap { padding: 0 0 12px 16px; }
    .mega__col { padding-bottom: 16px; }
    .mega__head { border: 0; padding-bottom: 6px; font-size: 17px; white-space: normal; }
    .mega__links li { padding: 6px 0; }
    .lang a { display: block; padding: 0 0 16px 16px; font-size: 16px; }
  }
</style>
