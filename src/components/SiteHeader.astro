---
import { Image } from 'astro:assets';
import { MENU } from '../data/menu';
import { getImageFor } from '../data/images';

/* Header ala adani.com: tetap di atas, putih 70 % dengan blur, lockup di kiri
 * dan menu kapital di kanan. Mega-menu desktop terbuka saat hover (≥1027 px),
 * di bawahnya menjadi laci dari kanan dengan akordeon, persis perilaku Adani.
 * Menu utamanya tetap menu Adhiloka (NAV di site.ts).
 *
 * Isi mega-menu memakai konsep Adhiloka versi pertama (yang meniru
 * robertet.com): foto utama berjudul dengan panah di kiri, menuju halaman
 * induk, lalu kolom tautan di kanan. Dengan kolom saja panelnya banyak ruang
 * kosong, karena menu Adhiloka jauh lebih sedikit tautannya daripada Adani.
 *
 * Kolom kanan diawali baris judul panel (ABOUT US ───), lalu tautan datar
 * tanpa sub-menu atau label grup (pemilik, 13 Nov 2026): paling banyak 3 ke
 * bawah, sisanya pindah ke kolom kanan. */

interface Props {
  active: string;
}
const { active } = Astro.props;

const isActive = (href: string) => active === href || active.startsWith(href);
const path = Astro.url.pathname;
---

<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <a class="hdr__logo" href="/" aria-label="Adhiloka, home">
      <img class="hdr__logo-light" src="/brand/adhiloka-lockup.svg" alt="Adhiloka" width="166" height="34" />
      <!-- Mode gelap: tulisan putih. lazy + display:none = baru diunduh saat dipakai. -->
      <img class="hdr__logo-dark" src="/brand/adhiloka-lockup-dark.svg" alt="Adhiloka" width="166" height="34" loading="lazy" />
    </a>

    <button class="hdr__search-m" type="button" data-search-open aria-label="Search">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>

    <button class="hdr__burger" type="button" data-burger aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span></span><span></span><span></span><span></span>
    </button>

    <nav class="hdr__nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="hdr__list">
        {
          MENU.map((item) => (
            <li class:list={['hdr__item', { 'is-active': isActive(item.href), 'has-mega': !!item.mega }]} data-item>
              <a class:list={['hdr__link', { 'has-child': !!item.mega }]} href={item.href} data-top>
                {item.label}
              </a>
              {item.mega && (
                <div class="mega" data-mega>
                  <div class="mega__wrap">
                    {item.panel && (
                      <a class="mega__feature" href={item.href} tabindex="-1">
                        {getImageFor(item.panel.image) && (
                          <Image
                            class="mega__img"
                            src={getImageFor(item.panel.image)!}
                            alt=""
                            widths={[480, 800]}
                            sizes="(max-width: 1399px) 380px, 34vw"
                            quality={66}
                            loading="eager"
                            fetchpriority="low"
                            decoding="async"
                          />
                        )}
                        <span class="mega__label">
                          <span>{item.panel.title}</span>
                          <svg class="mega__arrow" viewBox="0 0 46 12" width="46" height="12" aria-hidden="true"><path d="M0 6h44M39 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                        </span>
                      </a>
                    )}
                    <div class="mega__body">
                      <a class="mega__heading" href={item.mega.heading.href} tabindex="-1">
                        <span>{item.mega.heading.label}</span>
                      </a>
                      <ul class="mega__links">
                        {item.mega.links.map((l) => (
                          <li>
                            <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>
                              <span>{l.label}</span>
                              <svg class="mega__chev" viewBox="0 0 16 12" width="14" height="10" aria-hidden="true"><path d="M0 6h14M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
        <li class="hdr__item hdr__item--a11y" data-a11y>
          <button class="hdr__a11y" type="button" aria-expanded="false" aria-controls="a11y-panel" data-a11y-toggle>
            <!-- Ikon accessibility_new dari Material Symbols (Apache 2.0), sama dengan yang dipakai Adani. -->
            <svg class="hdr__a11y-icon" viewBox="0 0 15 17" width="15" height="17" aria-hidden="true"><path d="M7.8 3.54C7.36 3.54 6.98 3.38 6.67 3.07C6.36 2.76 6.2 2.38 6.2 1.94C6.2 1.5 6.36 1.12 6.67 0.81C6.98 0.5 7.36 0.34 7.8 0.34C8.24 0.34 8.62 0.5 8.93 0.81C9.24 1.12 9.4 1.5 9.4 1.94C9.4 2.38 9.24 2.76 8.93 3.07C8.62 3.38 8.24 3.54 7.8 3.54ZM5.4 16.34V5.94C4.6 5.87 3.79 5.77 2.96 5.64C2.13 5.51 1.35 5.34 0.6 5.14L1 3.54C2.04 3.82 3.15 4.02 4.32 4.15C5.49 4.28 6.65 4.34 7.8 4.34C8.95 4.34 10.11 4.28 11.28 4.15C12.45 4.02 13.56 3.82 14.6 3.54L15 5.14C14.25 5.34 13.47 5.51 12.64 5.64C11.81 5.77 11 5.87 10.2 5.94V16.34H8.6V11.54H7V16.34H5.4Z" fill="currentColor"></path></svg>
            <span class="hdr__a11y-text">Accessibility</span>
          </button>
          <div class="a11y" id="a11y-panel" data-a11y-panel>
            <div class="a11y__head">
              <p class="a11y__title">Accessibility Adjustments</p>
              <p class="a11y__sub">Choose the right accessibility profile for you</p>
            </div>
            <div class="a11y__row a11y__row--theme" role="group" aria-label="Colour theme">
              <button class="a11y__opt" type="button" data-theme="light" aria-pressed="true">Light Mode</button>
              <button class="a11y__opt" type="button" data-theme="dark" aria-pressed="false">Dark Mode</button>
            </div>
            <div class="a11y__row a11y__row--font" role="group" aria-label="Text size">
              <button class="a11y__opt" type="button" data-font="decrease" aria-pressed="false" aria-label="Smaller text">-A</button>
              <button class="a11y__opt" type="button" data-font="default" aria-pressed="true" aria-label="Default text size">A</button>
              <button class="a11y__opt" type="button" data-font="increase" aria-pressed="false" aria-label="Larger text">+A</button>
            </div>
            <div class="a11y__reset">
              <button class="a11y__opt" type="button" data-a11y-reset>Reset Settings</button>
            </div>
          </div>
        </li>
        {/* Pemilih bahasa ENG/IND dilepas 10 Nov 2026: belum ada rute /id/, jadi
            tautannya kosong. Gayanya (.lang) masih ada di bawah untuk nanti. */}
        <li class="hdr__item hdr__item--search">
          <button class="hdr__icon" type="button" data-search-open aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNav } from '../scripts/nav';
  import { initA11y } from '../scripts/a11y';
  initNav();
  initA11y();
</script>

<style>
  /* `header` Adani: putih 70 % + blur 10 px, dan TIDAK memutih saat hover —
     foto hero tetap tembus di balik menu. Hanya laci mobile yang padat. */
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 9991;
    background: var(--bg-header);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    backdrop-filter: saturate(1.5) blur(14px);
    /* Garis rambut di dasar header: batasnya tetap terbaca di atas section putih. */
    box-shadow: 0 1px 0 var(--hairline);
    transition: background var(--t) var(--ease-std);
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    height: var(--header-h);
  }

  /* `.logo` Adani lebarnya 7 % kontainer, jadi ikut membesar dengan layar
     (31 px tinggi di 1440, 43 px di 1920). Lockup kita jauh lebih lebar dan
     tulisannya lebih kecil daripada wordmark Adani, maka tingginya dihitung
     dari rumus yang sama lalu diperbesar ±25 % agar bobot visualnya setara. */
  .hdr__logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 6px 6px 6px 0;
    margin-right: 3%;
  }
  .hdr__logo img {
    height: clamp(30px, calc((6.22vw - 6px) / 2.1), 46px);
    width: auto;
  }

  .hdr__nav { flex: 1; height: 100%; }
  .hdr__list {
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    height: 100%;
  }

  /* `nav ul li` Adani: jarak antarmenu berubah per lebar layar
     (18 → 15 → 11 → 6 → 4/5 → 3 px), ditambah padding tautan 10 px, atau
     20 px di KEDUA sisi untuk menu berpanah. */
  .hdr__item {
    display: flex;
    align-items: center;
    padding: 0 18px;
  }
  @media (max-width: 2099px) { .hdr__item { padding: 0 15px; } }
  @media (max-width: 1799px) { .hdr__item { padding: 0 11px; } }
  @media (max-width: 1679px) { .hdr__item { padding: 0 6px; } }
  @media (max-width: 1599px) { .hdr__item { padding: 0 4px; } }
  @media (max-width: 1549px) { .hdr__item { padding: 0 5px; } }
  @media (max-width: 1365px) { .hdr__item { padding: 0 3px; } }

  /* `nav ul li a`: 1,4 rem semibold kapital, panah 7 px dari garis sudut
     yang diputar, garis gradien 4 px menempel di tepi bawah header. */
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    font-size: calc(1.4 * var(--rem) * var(--fs));
    font-weight: 530;
    letter-spacing: 0.006em;
    color: var(--ink-strong);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hdr__link.has-child { padding: 0 20px; }
  .hdr__link.has-child::after {
    content: '';
    position: absolute;
    right: 5px;
    top: calc(50% - 6px);
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink-strong);
    border-left: 1px solid var(--ink-strong);
    transform: rotate(-135deg);
    transition: transform var(--t) var(--ease-out), top var(--t) var(--ease-out);
  }
  .hdr__link::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transition: transform 0.45s var(--ease-out);
  }
  .hdr__item.is-active > .hdr__link::before { transform: none; }

  /* Pemilih bahasa Adani memakai segitiga padat 4 px, bukan panah garis. */
  @media (min-width: 1027px) {
    .hdr__item--lang .hdr__link.has-child { padding: 0 16px 0 10px; }
    .hdr__item--lang .hdr__link.has-child::after {
      right: 2px;
      top: calc(50% - 2px);
      width: 0;
      height: 0;
      border: 4px solid transparent;
      border-top-color: var(--ink-strong);
      border-bottom: 0;
      transform: none;
    }
  }

  .hdr__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--ink-strong);
    border-radius: 50%;
    transition: background-color var(--t-fast) var(--ease-std);
  }
  .hdr__icon:hover { background: var(--hairline); }

  .hdr__search-m,
  .hdr__burger { display: none; }

  .hdr__logo-dark { display: none; }
  :global(html.dark-mode) .hdr__logo-light { display: none; }
  :global(html.dark-mode) .hdr__logo-dark { display: block; }

  /* ── Accessibility Adjustments (`li.accessibility-tab` Adani) ──────────
     Desktop: ikon 15×17 + segitiga 4 px seperti pemilih bahasa; panel
     dibuka dengan klik (bukan hover), 396 px di tengah bawah ikon, padding
     40/30. Di 1027–1219 px panel rata kanan agar tidak keluar layar. */
  .hdr__item--a11y { position: relative; }
  .hdr__a11y {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 100%;
    padding: 0 16px 0 10px;
    color: var(--ink-strong);
  }
  .hdr__a11y::after {
    content: '';
    position: absolute;
    right: 2px;
    top: calc(50% - 2px);
    border: 4px solid transparent;
    border-top-color: var(--ink-strong);
    border-bottom: 0;
    transition: transform var(--t) var(--ease-out);
  }
  .hdr__a11y-icon { flex: none; }
  .hdr__a11y-text { display: none; }

  .a11y {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 1;
    width: 396px;
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    padding: 0 30px;
    background: var(--bg);
    transform: translateX(-50%);
    /* slideToggle jQuery: 400 ms "swing". */
    transition: max-height 0.4s cubic-bezier(0.45, 0, 0.55, 1), padding 0.4s cubic-bezier(0.45, 0, 0.55, 1), visibility 0s 0.4s;
  }
  .is-open > .a11y {
    max-height: 600px;
    visibility: visible;
    padding: 40px 30px;
    box-shadow: 0 1px 0 var(--hairline), 0 24px 48px -24px rgb(15 23 21 / 0.22);
    transition-delay: 0s;
  }
  @media (min-width: 1027px) and (max-width: 1219px) {
    .a11y { left: auto; right: 0; transform: none; }
  }

  .a11y__head {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }
  .a11y__title {
    font-size: calc(20px * var(--fs));
    font-weight: 530;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ink);
  }
  .a11y__sub {
    padding: 6px 0 10px;
    line-height: 1.2;
    font-size: calc(16px * var(--fs));
    color: var(--ink);
  }
  .a11y__row {
    display: flex;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .a11y__row--theme { gap: 5.1%; }
  .a11y__row--theme .a11y__opt { flex: 0 0 47%; }
  .a11y__row--font { gap: 4.1%; }
  .a11y__row--font .a11y__opt { flex: 0 0 30%; }
  .a11y__reset { display: flex; padding: 30px 0 10px; }

  /* Tombol garis 1 px bersudut 8 px. Aktif dan hover: teks dan garis
     bergradien (gradien Adani diganti gradien logo, seperti `.btn`). */
  .a11y__opt {
    position: relative;
    z-index: 0;
    padding: 12px 16px;
    border: 1px solid var(--ink);
    border-radius: 8px;
    font-size: calc(16px * var(--fs));
    font-weight: 440;
    line-height: 1.2;
    text-align: center;
    color: var(--ink);
  }
  .a11y__reset .a11y__opt { font-size: calc(14px * var(--fs)); font-weight: 360; }
  .a11y__opt::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    padding: 1px;
    border-radius: 8px;
    background: var(--grad-bar);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .a11y__opt:hover,
  .a11y__opt[aria-pressed='true'] {
    border-color: transparent;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .a11y__opt:hover::before,
  .a11y__opt[aria-pressed='true']::before { opacity: 1; }

  /* Mode gelap Adani: panel bergradien gelap, tombol aktif terisi warna
     merek dengan teks putih. */
  :global(html.dark-mode) .a11y {
    background: linear-gradient(to right, #06110e, #0a1512, #0f1711, #13160e);
  }
  :global(html.dark-mode) .a11y__head,
  :global(html.dark-mode) .a11y__row { border-color: #808080; }
  :global(html.dark-mode) .a11y__opt { border-color: var(--brand-green-light); }
  :global(html.dark-mode) .a11y__opt[aria-pressed='true'] {
    border-color: var(--brand-green);
    background: var(--brand-green);
    color: #fff;
  }
  :global(html.dark-mode) .a11y__opt[aria-pressed='true']::before { opacity: 0; }

  /* ── Mega-menu desktop ─────────────────────────────────────────────── */
  @media (min-width: 1027px) {
    .hdr__item:hover > .hdr__link::before,
    .hdr__item:focus-within > .hdr__link::before { transform: none; }
    .hdr__item:not(.hdr__item--lang):hover > .hdr__link.has-child::after,
    .hdr__item:not(.hdr__item--lang):focus-within > .hdr__link.has-child::after {
      transform: rotate(45deg);
      top: calc(50% - 2px);
    }

    /* Bayangan hanya saat terbuka: panel tertutup setinggi 0 tetap
       melemparkan bayangannya ke foto hero. */
    .mega {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--header-h);
      background: var(--bg-menu);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
    }
    .hdr__item:hover > .mega,
    .hdr__item:focus-within > .mega {
      max-height: 80vh;
      box-shadow: 0 1px 0 var(--hairline), 0 24px 48px -24px rgb(15 23 21 / 0.22);
    }
    /* Isi panel menyusul sedikit di belakang panelnya: turun 10 px sambil muncul. */
    .mega__wrap > * {
      opacity: 0;
      transform: translateY(-10px);
      transition: opacity 0.2s var(--ease-std), transform 0.2s var(--ease-std);
    }
    .hdr__item:hover > .mega .mega__wrap > *,
    .hdr__item:focus-within > .mega .mega__wrap > * {
      opacity: 1;
      transform: none;
      transition: opacity 0.45s var(--ease-std) 0.08s, transform 0.6s var(--ease-out) 0.08s;
    }
    .hdr__item:hover > .mega .mega__wrap > * + *,
    .hdr__item:focus-within > .mega .mega__wrap > * + * { transition-delay: 0.14s; }

    /* Foto utama selebar 34 % kontainer, sisanya kolom tautan. */
    .mega__wrap {
      display: grid;
      grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
      gap: 60px;
      align-items: start;
      width: var(--wrap);
      max-width: 1920px;
      margin: 0 auto;
      padding: 40px 0 50px;
    }

    /* Pelat berjudul versi pertama Adhiloka: foto 16:9, judul kapital dan
       panah di kiri bawah; hover memperbesar foto pelan dan menggeser panah. */
    .mega__feature {
      position: relative;
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #2b2f2e;
      color: #fff;
    }
    .mega__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--t-img) var(--ease-out);
    }
    .mega__feature::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 65%;
      background: var(--scrim);
      opacity: 0.75;
    }
    .mega__label {
      position: absolute;
      z-index: 1;
      left: 24px;
      right: 24px;
      bottom: 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: calc(22px * var(--fs));
      font-weight: 530;
      line-height: 1.1;
      text-transform: uppercase;
    }
    .mega__label::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -10px;
      width: 60%;
      height: 3px;
      background: var(--grad-bar);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s var(--ease-out);
    }
    .mega__arrow { flex: none; transition: transform 0.5s var(--ease-out); }
    .mega__feature:hover .mega__img { transform: scale(1.05); }
    .mega__feature:hover .mega__arrow { transform: translateX(10px); }
    .mega__feature:hover .mega__label::after { transform: none; }

    .hdr__item--lang { position: relative; }
    .lang {
      position: absolute;
      top: 100%;
      left: 0;
      display: flex;
      flex-direction: column;
      min-width: 120px;
      max-height: 0;
      overflow: hidden;
      background: var(--bg-menu);
      transition: max-height var(--t) var(--ease-out);
    }
    .hdr__item--lang:hover .lang,
    .hdr__item--lang:focus-within .lang { max-height: 200px; }
    .lang a {
      padding: 12px 20px;
      font-size: calc(14px * var(--fs));
      font-weight: 530;
      color: var(--ink-strong);
    }
    .lang a[aria-current] { opacity: 0.5; }
  }

  .mega__links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: calc(16px * var(--fs));
    color: var(--ink-strong);
    opacity: 0.62;
    transition: opacity var(--t) var(--ease-std);
  }
  .mega__links a:hover,
  .mega__links a[aria-current] { opacity: 1; }
  .mega__chev {
    flex: none;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--t) var(--ease-std), transform var(--t) var(--ease-out);
  }
  .mega__links a:hover .mega__chev,
  .mega__links a:focus-visible .mega__chev { opacity: 1; transform: none; }

  @media (min-width: 1027px) {
    /* Baris judul panel: nama menu kapital lalu garis tipis sampai tepi. */
    .mega__body { min-width: 0; }
    .mega__heading {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-bottom: 30px;
      font-size: calc(13px * var(--fs));
      font-weight: 530;
      letter-spacing: 0.18em;
      text-transform: uppercase;
