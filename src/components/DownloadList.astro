---
import type { Resource } from '../data/pages/media';

/** Baris berkas: judul, keterangan, jenis dan ukuran, dengan tanda unduh. */
interface Props {
  resources: Resource[];
}

const { resources } = Astro.props;
---

<ul class="dl">
  {
    resources.map((r, i) => (
      <li data-reveal={String(i * 50)}>
        <a href={r.href} class="dl__row">
          <span class="dl__copy">
            <span class="dl__title">{r.title}</span>
            <span class="dl__body">{r.body}</span>
          </span>
          <span class="dl__meta">
            <span class="dl__kind">{r.kind}</span>
            <span class="dl__size">{r.size}</span>
          </span>
          <span class="dl__arrow" aria-hidden="true">&#8595;</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .dl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .dl li { border-bottom: 1px solid var(--rule); }

  .dl__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 32px;
    align-items: center;
    gap: clamp(18px, 3vw, 48px);
    padding: clamp(20px, 2.2vw, 30px) 0;
    transition: color var(--dur-fast) ease;
  }

  .dl__copy { display: flex; flex-direction: column; gap: 6px; }
  .dl__title {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: var(--leading-title);
  }
  .dl__body {
    font-size: var(--type-ui);
    line-height: var(--leading-body);
    color: var(--ink-body);
    max-width: var(--measure-body);
  }

  .dl__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    font-size: var(--type-micro);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .dl__arrow {
    justify-self: end;
    font-size: 18px;
    color: var(--ink-muted);
    transition: transform var(--dur-fast) var(--ease-glide), color var(--dur-fast) ease;
  }
  .dl__row:hover .dl__arrow { transform: translateY(3px); color: var(--gold); }

  @media (max-width: 899px) {
    .dl__row { grid-template-columns: minmax(0, 1fr) 24px; gap: 14px; }
    .dl__meta {
      grid-column: 1;
      grid-row: 2;
      flex-direction: row;
      gap: 14px;
      text-align: left;
    }
    .dl__arrow { grid-row: 1; }
  }
</style>
