---
import { Image } from 'astro:assets';
import { SOCIAL } from '../data/site';
import { images } from '../data/images';

/* Footer ala adani.com: logo dan ikon sosial di kiri, dua kolom berjudul,
 * satu kolom tautan tebal, lalu bar abu #c1c1c1 berisi hak cipta dan tautan
 * legal. Latarnya foto pucat yang memudar ke kiri, seperti foto gedung pucat
 * di footer Adani; di sini tajuk pohon kebun kemenyan. Tautan tanpa halaman
 * dibiarkan kosong (`#`) sesuai permintaan. */

const COLUMNS = [
  {
    head: { label: 'About Us', href: '/about/' },
    links: [
      { label: 'Our Business', href: '/about/our-business/' },
      { label: 'Our Purpose', href: '/about/our-purpose/' },
      { label: 'Our Leadership', href: '/about/our-leadership/' },
      { label: 'Our History', href: '/about/our-history/' },
      { label: 'Our Locations', href: '/about/our-locations/' },
    ],
  },
  {
    head: { label: 'Ingredients', href: '/ingredients/' },
    links: [
      { label: 'Ingredients Catalog', href: '/ingredients/catalog/' },
      { label: 'Technology', href: '/ingredients/technology/' },
      { label: 'Fine Fragrance', href: '/perfumery/fine-fragrance/' },
      { label: 'Fragrance Innovation', href: '/perfumery/fragrance-innovation/' },
    ],
  },
];

const MAJOR = [
  { label: 'Perfumery', href: '/perfumery/' },
  { label: 'Sustainability', href: '/sustainability/' },
  { label: 'Media', href: '/media/' },
  { label: 'Careers', href: '#' },
  { label: 'Downloads', href: '/media/media-resources/' },
  { label: 'Contact Us', href: '/contact/' },
];

const LEGAL = ['Legal Disclaimer', 'Privacy Notice', 'Terms & Conditions', 'Cookie Policy'];

/* Ikon digambar ulang dengan viewBox pas ke glifnya (tanpa ruang kosong),
 * lalu ditaruh di kotak seukuran ikon Adani: tinggi 15 px, lebar 8,6 / 15 /
 * 21 / 15 / 15. */
const ICONS: Record<string, { box: string; w: number; h: number; body: string }> = {
  Facebook: {
    box: '8 4.3 8.6 16.7', w: 8.6, h: 15,
    body: '<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" fill="currentColor"/>',
  },
  Instagram: {
    box: '3.15 3.15 17.7 17.7', w: 15, h: 15,
    body: '<rect x="4" y="4" width="16" height="16" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="16.8" cy="7.2" r="1.1" fill="currentColor"/>',
  },
  YouTube: {
    box: '2.8 5.8 18.4 12.4', w: 21, h: 15,
    body: '<path d="M21 8.2c-.2-1.3-1-2.1-2.3-2.2C16.7 5.8 12 5.8 12 5.8s-4.7 0-6.7.2C4 6.1 3.2 6.9 3 8.2 2.8 9.5 2.8 12 2.8 12s0 2.5.2 3.8c.2 1.3 1 2.1 2.3 2.2 2 .2 6.7.2 6.7.2s4.7 0 6.7-.2c1.3-.1 2.1-.9 2.3-2.2.2-1.3.2-3.8.2-3.8s0-2.5-.2-3.8ZM10.2 14.8V9.2l4.9 2.8-4.9 2.8Z" fill="currentColor"/>',
  },
  LinkedIn: {
    box: '3.5 4.5 16.7 15.5', w: 15, h: 15,
    body: '<path d="M6.9 20H3.8V9.5h3.1V20ZM5.3 8.1a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6ZM20.2 20h-3.1v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20h-3.1V9.5h3v1.4c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V20Z" fill="currentColor"/>',
  },
  X: {
    box: '1.25 2.25 21.57 19.5', w: 15, h: 15,
    body: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>',
  },
};
---

<footer class="ftr">
  <div class="ftr__bg">
    <Image class="ftr__photo" src={images['agroforest-canopy']} alt="" widths={[960, 1600]} sizes="70vw" quality={60} loading="lazy" />
    <div class="wrap ftr__upper">
      <div class="ftr__brand">
        <a href="/" aria-label="Adhiloka, home">
          <img src="/brand/adhiloka-lockup.svg" alt="Adhiloka" width="176" height="36" loading="lazy" />
        </a>
        <ul class="ftr__social">
          {
            SOCIAL.filter((s) => ICONS[s.label]).map((s) => {
              const i = ICONS[s.label];
              return (
                <li>
                  <a href={s.href} rel="noopener noreferrer" target="_blank" aria-label={s.label}>
                    <svg viewBox={i.box} width={i.w} height={i.h} aria-hidden="true" set:html={i.body} />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      {
        COLUMNS.map((col) => (
          <div class="ftr__col">
            <a class="ftr__head" href={col.head.href}>{col.head.label}</a>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }

      <ul class="ftr__major">
        {MAJOR.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="ftr__policy">
    <div class="wrap ftr__policy-row">
      <p>© {new Date().getFullYear()} Adhiloka Group</p>
      <ul>
        {LEGAL.map((l) => <li><a href="#">{l}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr { color: var(--ink); }

  .ftr__bg {
    position: relative;
    overflow: hidden;
    padding: 50px 0 70px;
    background: linear-gradient(180deg, #fafafa 0%, #f1f2f1 100%);
  }
  /* Foto menempati 70 % kanan, dipucatkan dan memudar ke kiri supaya
     kolom tautan tetap di atas bidang yang nyaris putih. */
  .ftr__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 70%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0.22;
    filter: grayscale(0.35) contrast(0.9);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 55%);
    mask-image: linear-gradient(to right, transparent 0, #000 55%);
    pointer-events: none;
  }
  @media (max-width: 1026px) {
    .ftr__photo { width: 100%; opacity: 0.14; }
  }

  .ftr__upper {
    position: relative;
    display: grid;
    grid-template-columns: 24.3% 18.2% 18.2% 1fr;
    align-items: start;
  }

  .ftr__brand img { width: 176px; height: auto; }
  .ftr__brand > a { display: block; padding-bottom: 18px; }

  /* Deret ikon sosial dibingkai garis 1 px di atas dan bawah (tanpa garis
     samping), selebar isinya, seperti footer Adani: bantalan li 10/15/9/5,
     ikon X turun 2 px, ikon hitam. Garis Adani berwarna ungu logonya;
     di sini hijau tanda Adhiloka. */
  .ftr__social {
    display: inline-flex;
    align-items: flex-start;
    column-gap: 2.7px;
    padding-bottom: 2.4px;
    border-top: 1px solid var(--brand-green);
    border-bottom: 1px solid var(--brand-green);
  }
  .ftr__social li { padding: 10px 15px 9px 5px; }
  .ftr__social li:last-child { padding: 12px 4px 2px 5px; }
  .ftr__social a {
    display: grid;
    place-items: center;
    color: #000;
  }
  .ftr__social svg { display: block; }

  /* Kepala kolom 18 px medium, tautan 14 px — takaran footer Adani. */
  .ftr__head {
    display: block;
    padding-bottom: 33px;
    font-size: calc(18px * var(--fs));
    font-weight: 440;
    color: #000;
  }
  .ftr__col li + li { margin-top: 16px; }
  .ftr__col li a {
    font-size: calc(14px * var(--fs));
    color: var(--ink);
  }
  .ftr__major li + li { margin-top: 18px; }
  .ftr__major a {
    font-size: calc(18px * var(--fs));
    font-weight: 440;
    color: #000;
  }
  .ftr a:hover { text-decoration: underline; }
  .ftr__social a:hover { text-decoration: none; }

  .ftr__policy { background: var(--line); }
  .ftr__policy-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    font-size: calc(13px * var(--fs));
    color: var(--ink);
  }
  .ftr__policy ul { display: flex; gap: 28px; flex-wrap: wrap; }

  @media (max-width: 1026px) {
    .ftr__upper { grid-template-columns: 1fr 1fr; gap: 40px 20px; }
    .ftr__brand { grid-column: 1 / -1; }
    .ftr__head { padding-bottom: 20px; }
  }
  @media (max-width: 600px) {
    .ftr__upper { grid-template-columns: 1fr; }
    .ftr__policy-row { flex-direction: column; align-items: flex-start; padding-block: 16px; }
    .ftr__policy ul { gap: 10px 20px; }
  }
</style>
