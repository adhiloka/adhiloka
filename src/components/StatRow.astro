---
import type { Stat } from '../data/pages/types';

/** Deret angka, dipisah garis rambut. Angkanya serif, labelnya huruf kecil. */
interface Props {
  stats: Stat[];
  ground?: 'paper' | 'sunk';
}

const { stats, ground = 'sunk' } = Astro.props;
---

<div class:list={['stats', ground === 'sunk' && 'stats--sunk']}>
  <dl class="frame stats__inner">
    {
      stats.map((s, i) => (
        <div class="stats__item" data-reveal={String(i * 60)}>
          <dt class="stats__value">{s.value}</dt>
          <dd class="stats__label">{s.label}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .stats { background: var(--paper); }
  .stats--sunk { background: var(--paper-sunk); }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(24px, 3vw, 48px);
    margin: 0;
    padding: clamp(40px, 5vw, 76px) var(--gutter);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 16px;
    border-left: 3px solid var(--gold);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(32px, 3vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--teal);
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-body);
  }
</style>
