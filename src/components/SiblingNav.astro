---
import { NAV } from '../data/site';

/**
 * Bilah sub-navigasi di bawah kepala halaman: Overview plus semua saudara
 * dalam bagian yang sama. Diturunkan dari NAV, jadi menambah sub-halaman
 * cukup dilakukan di site.ts.
 */
interface Props {
  section: string;
  active?: string;
  /** Bilah duduk di atas foto, bukan di atas kertas: latarnya dilepas, garis
   *  dan tulisannya dibalik jadi terang, dan tingginya ditambah supaya ia
   *  terbaca sebagai kaki halaman, bukan sebagai bilah yang menempel. */
  onImage?: boolean;
}

const { section, active = Astro.url.pathname, onImage = false } = Astro.props;
const parent = NAV.find((item) => item.href === section);
const links = parent?.panel?.links ?? [];
---

{
  links.length > 0 && (
    <nav
      class:list={['subnav', onImage && 'subnav--on-image']}
      data-section-skip
      aria-label={`${parent!.label} sections`}
    >
      <div class="frame subnav__inner">
        <a href={parent!.href} aria-current={active === parent!.href ? 'page' : undefined}>
          Overview
        </a>
        {links.map((l) => (
          <a href={l.href} aria-current={active === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .subnav {
    border-bottom: 1px solid var(--border-hairline);
    background: var(--paper);
  }

  .subnav__inner {
    display: flex;
    align-items: stretch;
    gap: clamp(18px, 2.6vw, 40px);
    padding-inline: var(--gutter);
    /* Di layar sempit bilahnya digulir, bukan dibungkus jadi dua baris —
       tinggi header sudah cukup memakan layar. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav__inner::-webkit-scrollbar { display: none; }
  /* Di layar sempit tombol menu pil menempel di kiri atas; tab pertama diberi
     ruang supaya tidak tertutup saat bilah ini sampai di tepi atas. */
  @media (max-width: 899px) {
    .subnav:not(.subnav--on-image) .subnav__inner { padding-left: 86px; }
  }

  .subnav__inner a {
    flex: none;
    padding: 18px 0 15px;
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink-body);
    border-bottom: 3px solid transparent;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .subnav__inner a:hover { color: var(--teal); }
  /* Aktif: teal dengan garis emas, seperti penanda terpilih di Vale. */
  .subnav__inner a[aria-current='page'] {
    color: var(--teal);
    border-bottom-color: var(--gold);
  }

  /* ── Varian di atas foto ──────────────────────────────────────────────
     Tinggi tambahannya diletakkan sebagai jarak dalam atas-bawah, bukan
     height: dengan begitu tautannya tetap di tengah bilah dan tinggi barisnya
     tidak perlu ditebak. */
  .subnav--on-image {
    --subnav-tambahan: 75px;
    background: transparent;
    border-block: 0;
    border-top: 1px solid rgb(255 255 255 / 0.3);
    padding-block: calc(var(--subnav-tambahan) / 2);
  }
  .subnav--on-image .subnav__inner a {
    color: var(--on-image-dim);
    border-bottom-color: transparent;
  }
  .subnav--on-image .subnav__inner a:hover { color: var(--on-image); }
  .subnav--on-image .subnav__inner a[aria-current='page'] {
    color: var(--on-image);
    border-bottom-color: var(--gold);
  }
</style>
