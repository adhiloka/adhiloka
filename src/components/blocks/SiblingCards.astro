---
import CardGrid from './CardGrid.astro';
import { ABOUT_CARDS } from '../../data/pages/about';
import { PERFUMERY_CARDS } from '../../data/pages/perfumery';
import { INGREDIENTS_CARDS } from '../../data/pages/ingredients';
import { SUSTAINABILITY_CARDS } from '../../data/pages/sustainability';
import { MEDIA_CARDS } from '../../data/pages/media';

/* "Explore More" di kaki halaman anak: kartu saudara-saudaranya, tanpa
 * halaman yang sedang dibuka. */
const all = [...ABOUT_CARDS, ...PERFUMERY_CARDS, ...INGREDIENTS_CARDS, ...SUSTAINABILITY_CARDS, ...MEDIA_CARDS];
const path = Astro.url.pathname;
const section = `/${path.split('/').filter(Boolean)[0]}/`;
const cards = all.filter((c) => c.href.startsWith(section) && c.href !== path);
---

{cards.length > 0 && <CardGrid title="Explore More" cards={cards} grey />}
