---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import { LINE_CATALOG, lineItemHref, localOf, specOf, type LineItem, type LineKey } from '../../data/line-products';
import ComparePick from './ComparePick.astro';
import CompareBar from './CompareBar.astro';

/* Katalog lini di halaman lini (#catalog).
 * 28 Nov 2026 (pemilik): bentuknya sama dengan Ingredient Catalog dan tanpa
 * kode produk. Kotak cari bulat, tab kategori pilihan tunggal bergaris bawah
 * gradien, kartu berfoto 3 kolom yang seluruhnya satu tautan: nama, nama
 * ilmiah (seafood) atau nama Indonesia (plastik), baris hijau kapital (nama
 * lokal / bahan), lalu dua baris deskripsi. Plastik punya kotak "Compare" dan
 * tabel perbandingan. Tanpa hitungan, tanpa "Discover →", tanpa fade saat
 * menyaring. `?cat=` memilih tab. */
interface Props {
  line: LineKey;
}
const { line } = Astro.props;
const { categories, compare } = LINE_CATALOG[line];
const items = LINE_CATALOG[line].items as readonly LineItem[];
const norm = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
const haystack = (i: LineItem) => norm([i.name, i.local, i.latin, i.note, ...i.spec.map((s) => s[1])].join(' '));
const sub = (i: LineItem) => (line === 'seafood' ? i.latin : localOf(i));
const tag = (i: LineItem) => (line === 'seafood' ? localOf(i) : specOf(i, 'Material'));
---

<section class="sec lc" id="catalog" data-line-catalog data-compare-root={compare ? line : undefined}>
  <div class="wrap">
    <div class="lc__head">
      <h2 class="h2" data-anim="title">Catalog</h2>
      <label class="lc__search">
        <span class="sr-only">Search</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <input type="search" name="q" placeholder="Search" autocomplete="off" />
      </label>
    </div>

    <div class="lc__tabs" role="radiogroup" aria-label="Category">
      <label class="stab">
        <input type="radio" name={`cat-${line}`} value="" checked />
        <span>All</span>
      </label>
      {
        categories.map((c) => (
          <label class="stab">
            <input type="radio" name={`cat-${line}`} value={c.key} />
            <span>{c.label}</span>
          </label>
        ))
      }
    </div>

    <ul class="lc__grid">
      {
        items.map((i) => (
          <li class="lc__card" data-cat={i.category} data-text={haystack(i)}>
            <div class="lc__media cover">
              <Image quality={70} src={images[i.image]} alt={i.alt} widths={[400, 720]} sizes="(max-width: 640px) 100vw, (max-width: 1026px) 46vw, 30vw" loading="lazy" />
            </div>
            <div class="lc__body">
              <h3 class="lc__name">
                <a class="lc__link" href={lineItemHref(i)}>{i.name}</a>
              </h3>
              {sub(i) && <p class:list={['lc__sub', { 'is-latin': line === 'seafood' }]}>{sub(i)}</p>}
              {tag(i) && <p class="lc__tag">{tag(i)}</p>}
              <p class="lc__desc">{i.note}</p>
              {compare && <ComparePick id={i.slug} name={i.name} />}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="lc__empty" hidden>Nothing matches your search.</p>
  </div>

  {
    compare && (
      <CompareBar
        title="Compare packaging"
        rows={compare}
        items={items.map((i) => ({ id: i.slug, name: i.name, href: lineItemHref(i), image: i.image, sub: localOf(i), values: compare.map((r) => specOf(i, r) ?? '—') }))}
      />
    )
  }
</section>

<script>
  import { initCompare } from '../../scripts/compare';
  /* Tab kategori + kotak cari. Kartu tampil bila kategorinya cocok dan semua
     kata pencarian ada di teksnya (nama, nama Indonesia, nama ilmiah, isi
     spesifikasi). ?cat= memilih tab awal dan diperbarui tanpa memuat ulang. */
  const norm = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  document.querySelectorAll<HTMLElement>('[data-line-catalog]').forEach((root) => {
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const search = root.querySelector<HTMLInputElement>('input[type="search"]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-cat]')];
    const empty = root.querySelector<HTMLElement>('.lc__empty')!;
    const apply = () => {
      const cat = radios.find((r) => r.checked)?.value ?? '';
      const words = norm(search.value).trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach((c) => {
        const on = (!cat || c.dataset.cat === cat) && words.every((w) => c.dataset.text!.includes(w));
        c.hidden = !on;
        if (on) shown++;
      });
      empty.hidden = shown > 0;
      window.dispatchEvent(new CustomEvent('fx:refresh'));
    };
    const initial = new URLSearchParams(location.search).get('cat') ?? '';
    const start = radios.find((r) => r.value === initial);
    if (start) start.checked = true;
    apply();
    radios.forEach((r) =>
      r.addEventListener('change', () => {
        apply();
        const url = new URL(location.href);
        if (r.value) url.searchParams.set('cat', r.value);
        else url.searchParams.delete('cat');
        history.replaceState(null, '', url);
      }),
    );
    search.addEventListener('input', apply);
  });
  initCompare();
</script>

<style>
  .lc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    flex-wrap: wrap;
  }
  .lc__search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 380px);
    height: 52px;
    padding: 0 22px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink-muted);
    transition: border-color var(--t-fast) var(--ease-std);
  }
  .lc__search:hover { border-color: var(--ink-muted); }
  .lc__search:focus-within { border-color: var(--ink); }
  .lc__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: calc(16px * var(--fs));
    color: var(--ink);
    outline: 0;
  }

  .lc__tabs {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    margin-top: 32px;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .lc__tabs::-webkit-scrollbar { display: none; }
  .stab { position: relative; flex: none; cursor: pointer; }
  .stab input { position: absolute; opacity: 0; pointer-events: none; }
  .stab span {
    position: relative;
    display: block;
    padding: 10px 14px 12px;
    font-size: calc(16px * var(--fs));
    font-weight: 440;
    line-height: 1.2;
    color: var(--ink-muted);
    white-space: nowrap;
    transition: color var(--t) var(--ease-std);
  }
  .stab span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .stab:hover span,
  .stab input:checked + span { color: var(--ink); }
  .stab input:checked + span::after { transform: none; }
  .stab input:focus-visible + span { outline: 2px solid var(--brand-green-light); outline-offset: -2px; }

  /* Kartu: takaran sama dengan kartu Ingredient Catalog (.mat). */
  .lc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 2.4%;
    margin-top: 32px;
  }
  .lc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    transition: box-shadow var(--t) var(--ease-out), border-color var(--t) var(--ease-out);
  }
  .lc__card[hidden] { display: none; }
  .lc__card:hover { border-color: var(--line); box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35); }
  .lc__card:has(.lc__link:focus-visible) { outline: 2px solid var(--brand-green-light); outline-offset: 3px; }
  .lc__media { display: block; aspect-ratio: 4 / 3; }
  .lc__media :global(img) { transition: transform var(--t-img) var(--ease-out); }
  .lc__card:hover .lc__media :global(img) { transform: scale(1.05); }
  .lc__body { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 24px; }
  .lc__name {
    font-size: calc(22px * var(--fs));
    line-height: 1.15;
    font-weight: 670;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lc__link { outline: 0; }
  .lc__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .lc__sub { margin-top: 4px; font-size: calc(15px * var(--fs)); color: var(--ink-muted); }
  .lc__sub.is-latin { font-style: italic; }
  .lc__tag {
    margin-top: 12px;
    font-size: calc(13px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-green);
  }
  .lc__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin-top: 14px;
    font-size: calc(15px * var(--fs));
    line-height: 1.55;
  }
  .lc__empty { margin-top: 32px; font-size: calc(16px * var(--fs)); color: var(--ink-muted); }

  @media (max-width: 1026px) {
    .lc__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .lc__tabs { margin-inline: -5.56vw; padding-inline: 5.56vw; }
  }
  @media (max-width: 640px) {
    .lc__grid { grid-template-columns: 1fr; }
  }
</style>
