---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import { LINE_CATALOG, lineProductHref, type LineProduct } from '../../data/line-products';

/* Halaman Products lini Marine Products / Polymers.
 * 27 Nov 2026 (pemilik: jangan ditiru atau terlalu mirip katalog bahan):
 * tanpa tab penyaring dan tanpa kartu berbingkai bernaskah. Produk
 * dikelompokkan per kategori, susunan `.headWithPara` adani.com: nama dan
 * satu paragraf kategori di kiri, foto produk berjudul di kanan (gaya kartu
 * CardGrid). Tiap kategori punya jangkar (#fish, #resins) yang dituju tile
 * beranda grup dan kartu halaman lini. Tanpa hitungan. */
interface Props {
  line: LineProduct['line'];
}
const { line } = Astro.props;
const { categories, products } = LINE_CATALOG[line];
const arrow = '<path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path>';
---

<section class="sec lc">
  <div class="wrap">
    {
      categories.map((c) => (
        <div class="lc__group" id={c.key}>
          <div class="lc__head" data-anim="sub">
            <h2 class="lc__title">{c.label}</h2>
            <p class="lc__body">{c.body}</p>
          </div>
          <ul class="lc__grid" data-anim="columns">
            {products
              .filter((p) => p.category === c.key)
              .map((p) => (
                <li data-anim-item>
                  <a class="lc__card" href={lineProductHref(p)}>
                    <span class="lc__media cover shade">
                      <Image quality={70} src={images[p.image]} alt="" widths={[400, 720]} sizes="(max-width: 640px) 100vw, (max-width: 1026px) 46vw, 28vw" loading="lazy" />
                      <span class="lc__name">
                        {p.name}
                        <svg viewBox="0 0 18 12" width="17" height="11" aria-hidden="true" set:html={arrow} />
                      </span>
                    </span>
                    {p.latin && <span class:list={['lc__latin', { 'is-plain': line !== 'seafood' }]}>{p.latin}</span>}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .lc__group {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 32px 5%;
    padding-block: 56px;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 64px);
  }
  .lc__group:first-child { padding-top: 0; border-top: 0; }
  .lc__group:last-child { padding-bottom: 0; }

  .lc__title {
    font-size: calc(clamp(24px, 2.2vw, 32px) * var(--fs));
    line-height: 1.1;
    font-weight: 530;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lc__body {
    margin-top: 16px;
    font-size: calc(16px * var(--fs));
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .lc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 2.4%;
    align-content: start;
  }
  .lc__card { display: block; }
  .lc__media { display: block; aspect-ratio: 3 / 2; }
  .lc__media :global(img) { transition: transform var(--t-img) var(--ease-out); }
  .lc__card:hover .lc__media :global(img),
  .lc__card:focus-visible .lc__media :global(img) { transform: scale(1.05); }

  .lc__name {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: calc(clamp(17px, 1.25vw, 19px) * var(--fs));
    font-weight: 440;
    color: #fff;
  }
  .lc__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -7px;
    height: 2px;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .lc__card:hover .lc__name::after,
  .lc__card:focus-visible .lc__name::after { transform: none; }
  /* Panah tersembunyi sampai hover di mana pun di kartu (pemilik, 22 Nov 2026). */
  .lc__name svg {
    flex: none;
    margin-left: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--t) var(--ease-std), transform 0.5s var(--ease-out);
  }
  .lc__card:hover .lc__name svg,
  .lc__card:focus-visible .lc__name svg { opacity: 1; transform: none; }

  .lc__latin {
    display: block;
    margin-top: 12px;
    font-size: calc(15px * var(--fs));
    font-style: italic;
    color: var(--ink-muted);
  }
  .lc__latin.is-plain { font-style: normal; }

  @media (max-width: 1026px) {
    .lc__group { grid-template-columns: 1fr; padding-block: 44px; }
    .lc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .lc__grid { grid-template-columns: 1fr; }
  }
</style>
