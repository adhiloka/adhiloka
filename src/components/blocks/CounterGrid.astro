---
import type { Stat } from '../../data/pages/types';

/* "CREATING THE IMPACT OF A LIFETIME" adani.com: judul, lalu deret angka yang
 * menghitung naik, masing-masing dengan ikon garis dan label. Ikonnya
 * digambar sendiri; ikon Adani tidak dipakai. */

interface Props {
  title: string;
  stats: Stat[];
  grey?: boolean;
}
const { title, stats, grey = true } = Astro.props;

const ICONS = [
  // daun
  '<path d="M6 34C6 16 18 6 36 6c0 18-10 30-28 30" /><path d="M6 34 24 16" />',
  // orang
  '<circle cx="14" cy="12" r="5" /><circle cx="28" cy="14" r="4" /><path d="M4 34c0-6 4.5-10 10-10s10 4 10 10M24 34c0-5 2-8 5-8s7 3 7 8" />',
  // tetes
  '<path d="M20 5c7 9 11 15 11 20a11 11 0 0 1-22 0c0-5 4-11 11-20Z" /><path d="M14 26a6 6 0 0 0 6 6" />',
  // pohon
  '<path d="M20 36V20" /><path d="M20 4 9 20h6l-5 8h20l-5-8h6L20 4Z" />',
];
---

<section class:list={['sec', { 'sec--grey': grey }]}>
  <div class="wrap">
    <h2 class="h2">{title}</h2>
    <ul class="ctr">
      {
        stats.map((s, i) => (
          <li class="ctr__item" data-fx style={`--i:${i}`}>
            <svg class="ctr__icon" viewBox="0 0 40 40" width="52" height="52" aria-hidden="true" set:html={ICONS[i % ICONS.length]} />
            <span class="ctr__num" data-count={s.value}>{s.value}</span>
            <span class="ctr__label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ctr {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-top: 56px;
  }
  .ctr__item { display: flex; flex-direction: column; gap: 14px; }
  .ctr__icon {
    fill: none;
    stroke: var(--brand-green);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ctr__num {
    font-size: clamp(34px, 3.33vw, 48px);
    line-height: 1;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ctr__label { font-size: 18px; line-height: 1.3; color: var(--ink); }
</style>
