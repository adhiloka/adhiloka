---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import type { Era, EraGroup } from '../../data/pages/about';

/* Linimasa penuh ala adani.com/about-us/our-journey (`section-timeline`,
 * pageTimeline di JS Adani):
 * - bilah era menempel di bawah header sepanjang section dan menandai era
 *   yang sedang dibaca (`milestone-nav`); di layar kecil menjadi dropdown
 *   (`milestone-header`);
 * - tiap era dibuka panel berfoto berisi rentang tahun dan nama era
 *   (`milestone-intro`);
 * - di dalam era, daftar tahun di kiri menempel dan menandai tahun yang sedang
 *   dibaca, digeser supaya butir aktif selalu di atas (`year-nav`), entri
 *   tahun di kanan (`year-content`);
 * - era ditutup tautan ke era berikutnya dengan panah yang mengambang
 *   (`nextPager`, keyframes shadowFloat).
 * Gerak dan penandanya di scripts/timeline.ts. Section ini punya pin sendiri,
 * jadi tidak ikut ditumpuk (data-no-panel). */

interface Props {
  eras: EraGroup[];
  entries: Era[];
}
const { eras, entries } = Astro.props;
const yearId = (y: string) => `year-${y.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const groups = eras.map((g, i) => ({
  ...g,
  id: `era-${i + 1}`,
  label: `${g.range} ${g.name}`,
  items: entries.filter((e) => g.years.includes(e.year)),
}));
---

<section class="tl" data-no-panel data-timeline>
  <div class="tl__nav" data-tl-nav>
    <div class="wrap tl__nav-in">
      <button class="tl__current" type="button" data-tl-toggle aria-expanded="false" aria-controls="tl-eras">
        <span data-tl-current>{groups[0].label}</span>
        <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
      <ol class="tl__eras" id="tl-eras">
        {
          groups.map((g, i) => (
            <li>
              <a class:list={['tl__era-link', { 'is-active': i === 0 }]} href={`#${g.id}`} data-tl-link={g.id}>
                <span class="tl__era-range">{g.range}</span>
                <span class="tl__era-name">{g.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  {
    groups.map((g, i) => (
      <div class="tl__era" id={g.id} data-tl-era data-label={g.label}>
        <div class="tl__intro">
          <div class="tl__intro-media cover" data-parallax>
            {g.image ? <Image quality={70} src={images[g.image]} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" /> : <span class="plate" />}
          </div>
          <div class="wrap tl__intro-text">
            <span class="tl__intro-line" aria-hidden="true" />
            <h3 class="tl__intro-range" data-anim="sub">{g.range}</h3>
            <h2 class="tl__intro-name" data-anim="sub">{g.name}</h2>
          </div>
        </div>

        <div class="wrap tl__body" data-tl-body>
          <div class="tl__years-wrap" data-tl-years>
            <ul class="tl__years">
              {g.items.map((e, j) => (
                <li class:list={{ 'is-active': j === 0 }} data-tl-year={yearId(e.year)}>
                  <a href={`#${yearId(e.year)}`}>
                    <span class="tl__y">{e.year}</span>
                    <span class="tl__yt">{e.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="tl__entries">
            {g.items.map((e) => (
              <article class="tl__entry" id={yearId(e.year)} data-tl-entry>
                <p class="tl__num" data-anim="title">{e.year}</p>
                <h3 class="tl__title" data-anim="sub">{e.title}</h3>
                <p class="tl__text" data-anim="sub">{e.body}</p>
              </article>
            ))}
          </div>
        </div>

        {groups[i + 1] && (
          <div class="wrap tl__next">
            <a href={`#${groups[i + 1].id}`} data-tl-link={groups[i + 1].id}>
              <span class="tl__next-arrow" aria-hidden="true">
                <svg viewBox="0 0 12 20" width="12" height="20"><path d="M6 0v18M1 13l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
              </span>
              {groups[i + 1].name}
            </a>
          </div>
        )}
      </div>
    ))
  }
</section>

<script>
  import { initTimeline } from '../../scripts/timeline';
  // Setelah scroll-fx.ts memasang ScrollSmoother: semua skrip modul sudah
  // dijalankan sebelum DOMContentLoaded.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTimeline, { once: true });
  else initTimeline();
</script>

<style>
  .tl { position: relative; background: var(--bg); }

  /* ── Bilah era ─────────────────────────────────────────────────────── */
  .tl__nav {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    background: rgb(255 255 255 / 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  /* Di dalam ScrollSmoother sticky tidak berlaku; bilahnya di-pin skrip. */
  :global(html.has-smoother) .tl__nav { position: relative; top: auto; }
  .tl__current { display: none; }
  .tl__eras {
    display: flex;
    list-style: none;
  }
  .tl__eras li { flex: 1; }
  .tl__era-link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0 22px;
    color: var(--ink-muted);
    transition: color 0.3s;
  }
  .tl__era-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 16px;
    bottom: -1px;
    height: 4px;
    background: var(--grad-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .tl__era-link:hover,
  .tl__era-link.is-active { color: var(--ink); }
  .tl__era-link.is-active::after { transform: none; }
  .tl__era-range { font-size: calc(14px * var(--fs)); letter-spacing: 0.04em; }
  .tl__era-name {
    font-size: calc(20px * var(--fs));
    font-weight: 530;
    text-transform: uppercase;
  }

  /* ── Panel pembuka era ─────────────────────────────────────────────── */
  .tl__intro {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 70vh;
    overflow: hidden;
    background: #111;
    color: #fff;
  }
  .tl__intro-media { position: absolute; inset: 0; }
  .tl__intro-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 20%, rgb(0 0 0 / 0.8));
  }
  .tl__intro-text {
    position: relative;
    z-index: 1;
    padding-block: 80px;
  }
  .tl__intro-line {
    display: block;
    width: 80px;
    height: 4px;
    margin-bottom: 28px;
    background: var(--grad-bar);
  }
  .tl__intro-range {
    font-size: calc(clamp(20px, 1.67vw, 24px) * var(--fs));
    font-weight: 440;
    color: rgb(255 255 255 / 0.85);
  }
  .tl__intro-name {
    margin-top: 12px;
    font-size: calc(clamp(44px, 6.1vw, 88px) * var(--fs));
    line-height: 1;
    font-weight: 530;
    text-transform: uppercase;
  }

  /* ── Tahun ─────────────────────────────────────────────────────────── */
  .tl__body {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 8%;
    padding-block: 80px 40px;
  }
  .tl__years-wrap { align-self: start; overflow: hidden; }
  .tl__years {
    list-style: none;
    border-left: 1px solid var(--line);
    transition: transform 0.3s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .tl__years a {
    position: relative;
    display: block;
    padding: 14px 0 14px 28px;
    color: var(--ink-muted);
    transition: color 0.3s;
  }
  .tl__years a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 14px;
    bottom: 14px;
    width: 3px;
    background: var(--grad-bar);
    transform: scaleY(0);
    transition: transform 0.3s;
  }
  .tl__years li.is-active a { color: var(--ink); }
  .tl__years li.is-active a::before { transform: none; }
  .tl__years a:hover { color: var(--ink); }
  .tl__y { display: block; font-size: calc(22px * var(--fs)); font-weight: 530; }
  .tl__yt { display: block; margin-top: 4px; font-size: calc(15px * var(--fs)); }

  .tl__entry {
    min-height: 55vh;
    padding-bottom: 80px;
    scroll-margin-top: calc(var(--header-h) + 100px);
  }
  .tl__num {
    font-size: calc(clamp(56px, 6.1vw, 88px) * var(--fs));
    line-height: 1;
    font-weight: 530;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tl__title {
    margin-top: 24px;
    font-size: calc(clamp(22px, 1.8vw, 28px) * var(--fs));
    line-height: 1.2;
    font-weight: 530;
    color: var(--ink);
  }
  .tl__text {
    margin-top: 16px;
    max-width: 680px;
    font-size: calc(18px * var(--fs));
    line-height: 1.6;
    color: var(--ink);
  }

  /* ── Ke era berikutnya ─────────────────────────────────────────────── */
  .tl__next { padding-bottom: 80px; }
  .tl__next a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-size: calc(22px * var(--fs));
    font-weight: 530;
    text-transform: uppercase;
    color: var(--ink);
  }
  .tl__next a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .tl__next-arrow {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }
  .tl__next-arrow svg { animation: shadowFloat 1s linear infinite alternate; }
  @keyframes shadowFloat {
    from { transform: translateY(-5px); }
    to { transform: translateY(5px); }
  }

  /* ── Layar kecil: bilah era menjadi dropdown, daftar tahun disembunyikan. */
  @media (max-width: 1080px) {
    .tl__current {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 18px 0;
      font-size: calc(17px * var(--fs));
      font-weight: 530;
      text-transform: uppercase;
      color: var(--ink);
    }
    .tl__current svg { transition: transform 0.3s; }
    .tl.is-open .tl__current svg { transform: rotate(180deg); }
    .tl__eras {
      display: none;
      flex-direction: column;
      padding-bottom: 12px;
    }
    .tl.is-open .tl__eras { display: flex; }
    .tl__era-link { flex-direction: row; gap: 12px; padding: 10px 0; }
    .tl__era-link::after { display: none; }
    .tl__era-name { font-size: calc(16px * var(--fs)); }
    .tl__body { grid-template-columns: 1fr; padding-block: 48px 0; }
    .tl__years-wrap { display: none; }
    .tl__entry { min-height: 0; padding-bottom: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl__next-arrow svg { animation: none; }
  }
  :global(html.dark-mode) .tl__nav { background: rgb(0 0 0 / 0.9); }
</style>
