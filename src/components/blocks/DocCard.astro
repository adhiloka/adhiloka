---
import { Image } from 'astro:assets';
import { formatSize, type Download } from '../../data/downloads';

/* Kartu satu berkas PDF: sampul halaman pertama sebagai kertas bertumpuk
 * (tumpukan = jumlah halaman, maksimal tiga lembar terlihat), jenis dokumen,
 * judul, nomor/keterangan, ukuran, lalu Download dan View. Kertasnya terangkat
 * dan lembar di belakangnya mengipas saat kartu disorot. */
interface Props {
  doc: Download;
}
const { doc: d } = Astro.props;
const sheets = Math.min(d.pages, 3);
---

<article class="doc" data-sheets={sheets}>
  <a class="doc__paper" href={d.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <Image quality={80} src={d.thumb} alt="" widths={[200, 400]} sizes="170px" loading="lazy" />
  </a>
  <div class="doc__body">
    <p class="doc__kind">{d.kind}</p>
    <h3 class="doc__title">{d.title}</h3>
    <p class="doc__sub">{d.sub}</p>
    <p class="doc__meta"><span class="doc__badge">PDF</span>{d.pages} pages · {formatSize(d.bytes)}</p>
    <div class="doc__actions">
      <a class="btn doc__btn" href={d.href} download={d.filename}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3v10m-4.5-4.5L10 13l4.5-4.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        <span class="btn__label">Download</span>
        <span class="sr-only">{d.kind}: {d.title} (PDF, {formatSize(d.bytes)})</span>
      </a>
      <a class="doc__view" href={d.href} target="_blank" rel="noopener">
        View<span class="sr-only"> {d.title} PDF (opens in a new tab)</span>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 3h8v8M13 3 3.5 12.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .doc {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 32px;
    align-items: center;
    padding: 32px 32px 32px 28px;
    background: var(--bg);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .doc:hover {
    border-color: var(--line);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.25);
  }

  /* Kertas: sampul + hingga dua lembar di belakangnya. */
  .doc__paper {
    position: relative;
    display: block;
    aspect-ratio: 210 / 297;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .doc__paper :global(img) {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.1),
      0 10px 24px -10px rgb(0 0 0 / 0.35);
  }
  .doc__paper::before,
  .doc__paper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    border: 1px solid #e3e3e3;
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.3);
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .doc__paper::before { z-index: 1; transform: translate(5px, -5px); }
  .doc__paper::after { z-index: 0; transform: translate(10px, -10px); }
  .doc[data-sheets='2'] .doc__paper::after,
  .doc[data-sheets='1'] .doc__paper::after,
  .doc[data-sheets='1'] .doc__paper::before { display: none; }

  .doc:hover .doc__paper { transform: translateY(-6px) rotate(-2deg); }
  .doc:hover .doc__paper::before { transform: translate(7px, -4px) rotate(4deg); }
  .doc:hover .doc__paper::after { transform: translate(13px, -4px) rotate(8deg); }

  .doc__kind {
    font-size: calc(13px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .doc__title {
    margin-top: 8px;
    font-size: calc(24px * var(--fs));
    line-height: 1.2;
    font-weight: 530;
    color: var(--ink);
  }
  .doc__sub {
    margin-top: 6px;
    font-size: calc(15px * var(--fs));
    color: var(--ink-muted);
  }
  .doc__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: calc(14px * var(--fs));
    color: var(--ink-muted);
  }
  .doc__badge {
    padding: 3px 7px 2px;
    border-radius: 4px;
    background: var(--brand-green-deep);
    font-size: calc(11px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.06em;
    color: #fff;
  }
  .doc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 22px;
  }
  .doc__btn {
    padding: 14px 18px;
    font-size: calc(16px * var(--fs));
  }
  .doc__view {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: calc(16px * var(--fs));
    font-weight: 440;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .doc__view:hover { color: var(--brand-green); }

  @media (max-width: 640px) {
    .doc { grid-template-columns: 96px 1fr; gap: 20px; padding: 22px 20px; align-items: start; }
    .doc__title { font-size: calc(20px * var(--fs)); }
    .doc__actions { margin-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .doc__paper,
    .doc__paper::before,
    .doc__paper::after { transition: none; }
  }
</style>
