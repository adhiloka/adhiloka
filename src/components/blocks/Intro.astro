---
/* Blok pembuka halaman dalam: judul kapital di kiri, paragraf di kanan —
 * susunan `.headWithPara` / "Unleashing Boundless Potential" adani.com. */
interface Props {
  title: string;
  paragraphs: string[];
  grey?: boolean;
  id?: string;
}
const { title, paragraphs, grey = false, id } = Astro.props;
---

<section class:list={['sec', 'intro', { 'sec--grey': grey }]} id={id}>
  <div class="wrap intro__grid">
    <h2 class="h2 intro__title" data-fx>{title}</h2>
    <div class="prose intro__body" data-fx style="--i:1">
      {paragraphs.map((p) => <p>{p}</p>)}
      <slot />
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: 6%;
    align-items: start;
  }
  .intro__title { font-size: clamp(26px, 2.5vw, 36px); line-height: 1.1; }
  .intro__body { color: var(--ink); }
  @media (max-width: 1026px) {
    .intro__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
