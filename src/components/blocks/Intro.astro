---
/* Blok pembuka halaman dalam: judul kapital di kiri, paragraf di kanan —
 * susunan `.headWithPara` / "Unleashing Boundless Potential" adani.com.
 * `more`: naskah dilipat dua baris dengan tombol Read More, seperti
 * `introsection` halaman Businesses dan Sustainability Adani (scroll-fx.ts). */
interface Props {
  title: string;
  paragraphs: string[];
  grey?: boolean;
  id?: string;
  more?: boolean;
}
const { title, paragraphs, grey = false, id, more = false } = Astro.props;
---

<section class:list={['sec', 'intro', { 'sec--grey': grey }]} id={id}>
  <div class="wrap intro__grid">
    <h2 class="h2 intro__title" data-anim="title">{title}</h2>
    <div class="intro__body" data-anim="sub" data-more={more || undefined}>
      <div class="prose" data-more-body>
        {paragraphs.map((p) => <p>{p}</p>)}
        <slot />
      </div>
      {
        more && (
          <button class="intro__more" type="button" data-more-btn aria-expanded="false" hidden>
            <span class="btn__label">Read More</span>
            <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </button>
        )
      }
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: 6%;
    align-items: start;
  }
  .intro__title { font-size: clamp(26px, 2.5vw, 36px); line-height: 1.1; }
  .intro__body { color: var(--ink); }
  .intro__body [data-more-body] { position: relative; }
  .intro__body.is-folded [data-more-body]::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 32px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .sec--grey .intro__body.is-folded [data-more-body]::after { background: linear-gradient(transparent, var(--bg-grey)); }
  .intro__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 17px;
    font-weight: 440;
    color: var(--ink);
  }
  .intro__more .btn__label {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .intro__more:hover .btn__label {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .intro__more svg { transition: transform 0.3s; }
  .intro__more[aria-expanded='true'] svg { transform: rotate(180deg); }
  @media (max-width: 1026px) {
    .intro__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
