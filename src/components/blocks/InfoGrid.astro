---
/* Grid butir berjudul — "Our core values" adani.com. Dipakai untuk nilai,
 * rute ekstraksi, rantai sumber (bernomor) dan kanal sosial (bertautan). */

type Item = { title: string; body: string; sub?: string; n?: string; href?: string; linkLabel?: string };

interface Props {
  title?: string;
  lead?: string;
  items: Item[];
  grey?: boolean;
  id?: string;
  cols?: 2 | 3 | 4;
}
const { title, lead, items, grey = false, id, cols = 4 } = Astro.props;
---

<section class:list={['sec', 'info', { 'sec--grey': grey }]} id={id}>
  <div class="wrap">
    {title && <h2 class="h2">{title}</h2>}
    {lead && <p class="lead info__lead">{lead}</p>}
    <ul class:list={['info__grid', `info__grid--${cols}`, { 'info__grid--flush': !title && !lead }]}>
      {
        items.map((it, i) => (
          <li class="info__item" data-fx style={`--i:${i % cols}`}>
            {it.n && <span class="info__n">{it.n}</span>}
            <h3 class="info__title">{it.title}</h3>
            {it.sub && <p class="info__sub">{it.sub}</p>}
            <p class="info__body">{it.body}</p>
            {it.href && (
              <a class="info__link" href={it.href} rel={it.href.startsWith('http') ? 'noopener' : undefined} target={it.href.startsWith('http') ? '_blank' : undefined}>
                {it.linkLabel ?? 'Know More'}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <slot />
  </div>
</section>

<style>
  .info { scroll-margin-top: var(--header-h); }
  .info__lead { margin-top: 24px; max-width: 820px; }
  .info__grid {
    display: grid;
    gap: 40px 3%;
    margin-top: 48px;
  }
  .info__grid--flush { margin-top: 0; }
  .info__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .info__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .info__grid--2 { grid-template-columns: repeat(2, 1fr); }

  .info__item {
    position: relative;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .info__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2px;
    width: 56px;
    height: 4px;
    background: var(--grad-bar);
  }
  .info__n {
    display: block;
    margin-bottom: 12px;
    font-size: 40px;
    line-height: 1;
    font-weight: 600;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .info__title {
    font-size: clamp(20px, 1.53vw, 22px);
    line-height: 1.25;
    font-weight: 600;
    color: var(--ink);
  }
  .info__sub {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .info__body {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }
  .info__link {
    display: inline-block;
    margin-top: 16px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .info__link:hover { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .info__grid--4,
    .info__grid--3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .info__grid--4,
    .info__grid--3,
    .info__grid--2 { grid-template-columns: 1fr; }
  }
</style>
