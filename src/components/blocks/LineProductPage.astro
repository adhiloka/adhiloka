---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardSlider from './CardSlider.astro';
import { images } from '../../data/images';
import { businessByKey } from '../../data/businesses';
import { LINE_CATALOG, lineProductHref, categoryLabel, lineCategoryHref, type LineProduct } from '../../data/line-products';

/* Halaman satu produk lini Fisheries / Polymers.
 * 27 Nov 2026 (pemilik: jangan mirip katalog bahan, jangan terlalu rinci):
 * kepala berwarna, strip fakta, kotak samping dan section permintaan
 * dilepas. Kini satu section terbelah: foto di kiri; nama, satu kalimat,
 * tabel spesifikasi + penanganan, dan satu tombol di kanan. Lalu slider
 * produk sekategori. Nilai = nilai tipikal; catatan di bawah tabel. */
interface Props {
  p: LineProduct;
}
const { p } = Astro.props;
const biz = businessByKey(p.line);
const { base, products } = LINE_CATALOG[p.line];
const cat = categoryLabel(p.line, p.category);
const siblings = products.filter((o) => o.category === p.category && o.slug !== p.slug);
const rows: [string, string][] = [...p.spec, ...p.handling, ['Origin', 'Indonesia'], ['HS code', p.hs]];
---

<BaseLayout title={`${p.name} | ${biz.name}`} description={`${p.name}${p.latin ? ` (${p.latin})` : ''}. ${p.note}`} inner>
  <section class="sec lp">
    <div class="wrap">
      <nav class="lp__crumbs" aria-label="Breadcrumb">
        <a href={biz.href}>{biz.name}</a>
        <span aria-hidden="true">/</span>
        <a href={base}>Products</a>
        <span aria-hidden="true">/</span>
        <a href={lineCategoryHref(p.line, p.category)}>{cat}</a>
      </nav>

      <div class="lp__grid">
        <div class="lp__media cover">
          <Image quality={75} src={images[p.image]} alt={p.alt} widths={[640, 960, 1400]} sizes="(max-width: 1026px) 90vw, 48vw" loading="eager" />
        </div>

        <div class="lp__text">
          <p class="lp__cat">{cat}</p>
          <h1 class="lp__name">{p.name}</h1>
          {p.latin && <p class:list={['lp__latin', { 'is-plain': p.line !== 'seafood' }]}>{p.latin}</p>}
          <p class="lp__note">{p.note}</p>

          <dl class="spec">
            {
              rows.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="spec__note">Typical values. The specification for your order is confirmed with the quotation.</p>

          <a class="btn lp__btn" href={`/contact/?business=${p.line}&product=${p.slug}&kind=quotation`}><span class="btn__label">Request a Quotation</span></a>
        </div>
      </div>
    </div>
  </section>

  {
    siblings.length > 0 && (
      <CardSlider
        title={`More ${cat}`}
        items={siblings.map((o) => ({
          href: lineProductHref(o),
          title: o.name,
          image: o.image,
          shot: o.alt,
        }))}
        grey
      />
    )
  }
</BaseLayout>

<style>
  .lp { padding-top: calc(var(--header-h) + 40px); }

  .lp__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: calc(13px * var(--fs));
    font-weight: 440;
    color: var(--ink-muted);
  }
  .lp__crumbs a { transition: color var(--t) var(--ease-std); }
  .lp__crumbs a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .lp__grid {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 10fr);
    gap: 40px 6%;
    align-items: start;
    margin-top: 32px;
  }
  .lp__media { aspect-ratio: 4 / 3; }

  .lp__cat {
    font-size: calc(13px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-green);
  }
  .lp__name {
    margin-top: 12px;
    font-size: calc(clamp(32px, 3.4vw, 48px) * var(--fs));
    line-height: 1.05;
    font-weight: 530;
    text-transform: uppercase;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .lp__latin {
    margin-top: 10px;
    font-size: calc(18px * var(--fs));
    font-style: italic;
    color: var(--ink-muted);
  }
  .lp__latin.is-plain { font-style: normal; }
  .lp__note {
    margin-top: 20px;
    font-size: calc(17px * var(--fs));
    line-height: 1.6;
    color: var(--ink);
  }

  .spec { margin-top: 28px; border-top: 1px solid var(--line); }
  .spec > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .spec dt { font-size: calc(15px * var(--fs)); font-weight: 530; color: var(--ink); }
  .spec dd { font-size: calc(15px * var(--fs)); line-height: 1.5; color: var(--ink); font-variant-numeric: tabular-nums; }
  .spec__note { margin-top: 12px; font-size: calc(13px * var(--fs)); color: var(--ink-muted); }
  .lp__btn { margin-top: 28px; }

  @media (max-width: 1026px) {
    .lp__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .spec > div { grid-template-columns: 1fr; }
  }
</style>
