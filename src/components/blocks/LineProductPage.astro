---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessSubnav from './BusinessSubnav.astro';
import CardSlider from './CardSlider.astro';
import { images } from '../../data/images';
import { businessByKey } from '../../data/businesses';
import { LINE_CATALOG, lineProductHref, categoryLabel, lineCategoryHref, cardLine, type LineProduct } from '../../data/line-products';

/* Halaman satu produk lini Seafood / Plastics & Packaging (situs grup,
 * 26 Nov 2026). Susunannya sama dengan halaman produk bahan: kepala berwarna
 * lini, strip fakta, tabel spesifikasi, penanganan, tombol permintaan, dan
 * produk lain dari kategori yang sama. Nilai = nilai tipikal; catatan di
 * bawah tabel mengatakannya. */
interface Props {
  p: LineProduct;
}
const { p } = Astro.props;
const biz = businessByKey(p.line);
const { base, products } = LINE_CATALOG[p.line];
const cat = categoryLabel(p.line, p.category);
const siblings = products.filter((o) => o.category === p.category && o.slug !== p.slug);
const contact = (kind: string) => `/contact/?business=${p.line}&product=${p.slug}&kind=${kind}`;

const facts = [
  { label: 'Category', value: cat },
  { label: p.line === 'seafood' ? 'Scientific name' : 'Material', value: p.latin ?? '', latin: p.line === 'seafood' },
  { label: 'Origin', value: 'Indonesia' },
  { label: 'HS code', value: p.hs },
].filter((f) => f.value);
---

<BaseLayout title={`${p.name} | ${biz.name}`} description={`${p.name}${p.latin ? ` (${p.latin})` : ''}. ${p.note}`} inner>
  <section class="ph" style={`--fam: ${biz.color}`}>
    <div class="wrap">
      <nav class="ph__crumbs" aria-label="Breadcrumb">
        <a href={biz.href}>{biz.name}</a>
        <span aria-hidden="true">/</span>
        <a href={base}>Products</a>
        <span aria-hidden="true">/</span>
        <a href={lineCategoryHref(p.line, p.category)}>{cat}</a>
      </nav>
      <div class="ph__grid">
        <div class="ph__media cover">
          <Image quality={75} src={images[p.image]} alt={p.alt} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 320px" loading="eager" />
        </div>
        <div class="ph__text">
          <p class="ph__fam">{cat}</p>
          <h1 class="ph__name">{p.name}</h1>
          {p.latin && <p class:list={['ph__latin', { 'is-plain': p.line !== 'seafood' }]}>{p.latin}</p>}
          <p class="ph__note">{p.note}</p>
          <a class="ph__cta" href={contact('quotation')}>Request a quotation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pf" style={`--fam: ${biz.color}`} aria-label="Key facts">
    <dl class="wrap pf__grid">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class:list={{ 'is-latin': f.latin }}>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <BusinessSubnav />

  <section class="sec pd" id="specification">
    <div class="wrap pd__grid">
      <div class="pd__main">
        <h2 class="pd__h">Specification</h2>
        <dl class="spec">
          {
            p.spec.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="spec__note">Typical values. The specification for your order is confirmed with the quotation.</p>
      </div>
      <aside class="pd__aside">
        <div class="pd__know">
          <h2 class="pd__h">{p.line === 'seafood' ? 'Packing & storage' : 'Use & handling'}</h2>
          <dl class="spec spec--aside">
            {
              p.handling.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section class="sec sec--grey mord" id="ordering">
    <div class="wrap">
      <h2 class="h2" data-anim="title">Samples &amp; Quotations</h2>
      <p class="mord__cta">
        <a class="btn" href={contact('quotation')}><span class="btn__label">Request a Quotation</span></a>
        <a class="btn" href={contact('specification')}><span class="btn__label">Request the Specification</span></a>
        <a class="btn" href={contact('sample')}><span class="btn__label">Request a Sample</span></a>
      </p>
      <a class="mord__more" href={`${biz.href}#working-with-us`}>How ordering works</a>
    </div>
  </section>

  {
    siblings.length > 0 && (
      <CardSlider
        title={`More ${cat}`}
        viewAll={lineCategoryHref(p.line, p.category)}
        items={siblings.map((o) => ({
          href: lineProductHref(o),
          title: o.name,
          image: o.image,
          shot: o.alt,
          tag: cardLine(o),
        }))}
      />
    )
  }
</BaseLayout>

<style>
  .ph {
    padding: calc(var(--header-h) + 28px) 0 64px;
    background: var(--fam);
    color: #fff;
  }
  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: calc(13px * var(--fs));
    font-weight: 440;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__crumbs a:hover { color: #fff; }
  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 40px;
  }
  .ph__media { aspect-ratio: 1; border-radius: 4px; }
  .ph__name {
    font-size: calc(clamp(34px, 4.2vw, 60px) * var(--fs));
    line-height: 1.02;
    font-weight: 670;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .ph__fam {
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__latin {
    margin-top: 14px;
    font-size: calc(20px * var(--fs));
    font-style: italic;
    color: rgb(255 255 255 / 0.9);
  }
  .ph__latin.is-plain { font-style: normal; }
  .ph__note {
    max-width: 560px;
    margin-top: 18px;
    font-size: calc(17px * var(--fs));
    line-height: 1.55;
    color: rgb(255 255 255 / 0.92);
  }
  .ph__cta {
    display: inline-block;
    margin-top: 28px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #fff;
    font-size: calc(15px * var(--fs));
    font-weight: 530;
    color: #000;
    transition: background var(--t) var(--ease-std);
  }
  .ph__cta:hover { background: var(--brand-cream); }

  .pf {
    padding-block: 32px;
    background: color-mix(in srgb, var(--fam) 16%, var(--bg));
  }
  .pf__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .pf__grid dt { font-size: calc(17px * var(--fs)); font-weight: 530; color: var(--ink); }
  .pf__grid dd { margin-top: 6px; font-size: calc(15px * var(--fs)); line-height: 1.45; color: var(--ink); }
  .pf__grid .is-latin { font-style: italic; }

  .pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 48px 7%;
  }
  .pd__h {
    display: block;
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .spec { border-top: 1px solid var(--line); }
  .spec > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 24px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .spec dt { font-size: calc(15px * var(--fs)); font-weight: 530; color: var(--ink); }
  .spec dd { font-size: calc(15px * var(--fs)); line-height: 1.5; color: var(--ink); font-variant-numeric: tabular-nums; }
  .spec--aside > div { grid-template-columns: 1fr; }
  .spec__note { margin-top: 14px; font-size: calc(13px * var(--fs)); color: var(--ink-muted); }
  .pd__know {
    padding: 28px;
    border-radius: 12px;
    background: var(--bg-grey);
  }

  .mord__cta { display: flex; flex-wrap: wrap; gap: 14px 16px; margin: 36px 0 28px; }
  .mord__more { font-size: calc(16px * var(--fs)); font-weight: 440; text-decoration: underline; text-underline-offset: 5px; }
  .mord__more:hover { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .pd__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .ph { padding-bottom: 44px; }
    .ph__grid { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; }
    .ph__media { width: min(100%, 320px); }
    .pf__grid { grid-template-columns: 1fr 1fr; }
    .spec > div { grid-template-columns: 1fr; }
  }
</style>
