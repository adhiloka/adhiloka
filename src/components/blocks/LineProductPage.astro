---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { images } from '../../data/images';
import { businessByKey } from '../../data/businesses';
import { lineItemHref, lineProductHref, categoryLabel, type LineItem, type LineProduct } from '../../data/line-products';

/* Halaman satu kode produk Fisheries / Polymers (27 Nov 2026), susunannya
 * sama dengan halaman produk Ingredient Catalog: kepala berwarna lini dengan
 * kode, strip fakta, Specification + kotak penyimpanan/kemasan, Samples &
 * Quotations, daftar kode lain dari item yang sama. Tanpa HS code dan tanpa
 * kalimat "Typical values…" (komentar pemilik 27 Nov 2026). */
interface Props {
  item: LineItem;
  product: LineProduct;
}
const { item: m, product: p } = Astro.props;
const biz = businessByKey(m.line);
const cat = categoryLabel(m.line, m.category);
const siblings = m.products.filter((o) => o.code !== p.code);
const contact = (kind: string) => `/contact/?business=${m.line}&product=${p.code}&kind=${kind}`;
const facts = [
  { label: 'Product code', value: p.code },
  { label: m.line === 'seafood' ? 'Form' : 'Material', value: p.type },
  { label: 'Item', value: `${m.name} (${m.local})` },
  { label: 'Origin', value: 'Indonesia' },
];
---

<BaseLayout title={`${p.name} | ${biz.name}`} description={`${p.name}, product code ${p.code}. ${m.note}`} inner>
  <section class="ph" style={`--fam: ${biz.color}`}>
    <div class="wrap">
      <nav class="ph__crumbs" aria-label="Breadcrumb">
        <a href={biz.href}>{biz.name}</a>
        <span aria-hidden="true">/</span>
        <a href={lineItemHref(m)}>{m.name}</a>
      </nav>
      <div class="ph__grid">
        <div class="ph__media cover">
          <Image quality={75} src={images[m.image]} alt={m.alt} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 320px" loading="eager" />
        </div>
        <div class="ph__text">
          <p class="ph__fam">{p.code} · {cat}</p>
          <h1 class="ph__name">{p.name}</h1>
          <p class="ph__note">{m.note}</p>
          <a class="ph__cta" href={contact('quotation')}>Request a quotation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pf" style={`--fam: ${biz.color}`} aria-label="Key facts">
    <dl class="wrap pf__grid">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sec pd" id="specification">
    <div class="wrap pd__grid">
      <div class="pd__main">
        <h2 class="pd__h">Specification</h2>
        <dl class="spec">
          {
            p.spec.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <aside class="pd__aside">
        <div class="pd__know">
          <h2 class="pd__h">Storage &amp; packing</h2>
          <dl class="spec spec--aside">
            {
              m.handling.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section class="sec sec--grey mord" id="ordering">
    <div class="wrap">
      <h2 class="h2" data-anim="title">Samples &amp; Quotations</h2>
      <p class="mord__cta">
        <a class="btn" href={contact('quotation')}><span class="btn__label">Request a Quotation</span></a>
        <a class="btn" href={contact('sample')}><span class="btn__label">Request a Sample</span></a>
        <a class="btn" href={contact('specification')}><span class="btn__label">Request the Specification</span></a>
      </p>
    </div>
  </section>

  {
    siblings.length > 0 && (
      <section class="sec prl" id="more">
        <div class="wrap">
          <h2 class="h2" data-anim="title">More {m.name}</h2>
          <ul class="prl__list">
            {siblings.map((o) => (
              <li>
                <a class="prl__row" href={lineProductHref(m, o)}>
                  <span class="prl__code">{o.code}</span>
                  <span class="prl__name">{o.name}</span>
                  <span class="prl__type">{o.spec.find(([k]) => k === 'Local name')?.[1] ?? o.type}</span>
                  <span class="prl__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Daftar kode lain: sama dengan Products di halaman item. */
  .prl__list { margin-top: 28px; border-top: 1px solid var(--line); }
  .prl__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) minmax(0, 220px) 24px;
    gap: 6px 24px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: calc(16px * var(--fs));
    color: var(--ink);
    transition: color var(--t) var(--ease-std);
  }
  .prl__row:hover { color: var(--brand-green); }
  .prl__code { font-weight: 530; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
  .prl__name { font-weight: 530; }
  .prl__type { font-size: calc(14px * var(--fs)); color: var(--ink-muted); }
  .prl__arrow { justify-self: end; opacity: 0; transform: translateX(-6px); transition: opacity var(--t) var(--ease-std), transform var(--t) var(--ease-std); }
  .prl__row:hover .prl__arrow,
  .prl__row:focus-visible .prl__arrow { opacity: 1; transform: none; }
  @media (max-width: 767px) {
    .prl__row { grid-template-columns: 72px minmax(0, 1fr) 20px; }
    .prl__type { grid-column: 2; grid-row: 2; }
    .prl__arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
  .ph {
    padding: calc(var(--header-h) + 28px) 0 64px;
    background: var(--fam);
    color: #fff;
  }
  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: calc(13px * var(--fs));
    font-weight: 440;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__crumbs a:hover { color: #fff; }
  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 40px;
  }
  .ph__media { aspect-ratio: 1; border-radius: 4px; }
  .ph__name {
    font-size: calc(clamp(34px, 4.2vw, 60px) * var(--fs));
    line-height: 1.02;
    font-weight: 670;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .ph__fam {
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .ph__latin {
    margin-top: 14px;
    font-size: calc(20px * var(--fs));
    font-style: italic;
    color: rgb(255 255 255 / 0.9);
  }
  .ph__latin.is-plain { font-style: normal; }
  .ph__note {
    max-width: 560px;
    margin-top: 18px;
    font-size: calc(17px * var(--fs));
    line-height: 1.55;
    color: rgb(255 255 255 / 0.92);
  }
  .ph__cta {
    display: inline-block;
    margin-top: 28px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #fff;
    font-size: calc(15px * var(--fs));
    font-weight: 530;
    color: #000;
    transition: background var(--t) var(--ease-std);
  }
  .ph__cta:hover { background: var(--brand-cream); }

  .pf {
    padding-block: 32px;
    background: color-mix(in srgb, var(--fam) 16%, var(--bg));
  }
  .pf__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .pf__grid dt { font-size: calc(17px * var(--fs)); font-weight: 530; color: var(--ink); }
  .pf__grid dd { margin-top: 6px; font-size: calc(15px * var(--fs)); line-height: 1.45; color: var(--ink); }
  .pf__grid .is-latin { font-style: italic; }

  .pd__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 48px 7%;
  }
  .pd__h {
    display: block;
    margin-bottom: 14px;
    font-size: calc(14px * var(--fs));
    font-weight: 530;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .spec { border-top: 1px solid var(--line); }
  .spec > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 24px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .spec dt { font-size: calc(15px * var(--fs)); font-weight: 530; color: var(--ink); }
  .spec dd { font-size: calc(15px * var(--fs)); line-height: 1.5; color: var(--ink); font-variant-numeric: tabular-nums; }
  .spec--aside > div { grid-template-columns: 1fr; }
  .pd__know {
    padding: 28px;
    border-radius: 12px;
    background: var(--bg-grey);
  }

  .mord__cta { display: flex; flex-wrap: wrap; gap: 14px 16px; margin: 36px 0 28px; }

  @media (max-width: 1026px) {
    .pd__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .ph { padding-bottom: 44px; }
    .ph__grid { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; }
    .ph__media { width: min(100%, 320px); }
    .pf__grid { grid-template-columns: 1fr 1fr; }
    .spec > div { grid-template-columns: 1fr; }
  }
</style>
