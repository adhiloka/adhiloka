---
import { Image } from 'astro:assets';
import { images, type ImageKey } from '../../data/images';
import { NAV, NAV_LINKS } from '../../data/site';

/* Banner halaman dalam ala `#spotlightBanner` adani.com (mis. /about-us):
 * foto selayar dengan bayangan hitam 0,85 dari bawah, judul 44 px di kiri
 * bawah dan remah roti menempel di dasar banner. Seluruh banner bergerak
 * 0,8× kecepatan gulir (data-speed Adani) sehingga section berikutnya
 * meluncur menutupinya. Remah dirakit dari NAV, jadi label halaman tidak
 * ditulis dua kali.
 *
 * `half`: banner setengah layar tanpa judul (`halfbanner press-release-banner`
 * artikel berita Adani); judulnya menjadi h1 di badan artikel. */

interface Props {
  title: string;
  image?: ImageKey;
  alt?: string;
  /** Kalimat di bawah judul (lede halaman). */
  line?: string;
  half?: boolean;
}
const { title, image, alt = '', line, half = false } = Astro.props;

const path = Astro.url.pathname;
const label = (href: string) => NAV_LINKS.find((l) => l.href === href)?.label;
const section = NAV.find((n) => path.startsWith(n.href) && n.href !== '/');
const crumbs = [{ label: 'Home', href: '/' }];
if (section && path !== section.href) crumbs.push({ label: section.label, href: section.href });
if (section && path !== section.href) {
  // Halaman anak; artikel berita menambah "News" sebagai jenjang antara.
  const parts = path.split('/').filter(Boolean);
  const mid = `/${parts.slice(0, 2).join('/')}/`;
  if (parts.length > 2 && label(mid)) crumbs.push({ label: label(mid)!, href: mid });
}
---

<section class:list={['banner', { 'banner--half': half }]} data-speed="0.8">
  <div class="banner__media">
    {
      image ? (
        <Image quality={70} src={images[image]} alt={alt} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      ) : (
        <span class="plate" />
      )
    }
  </div>
  {
    !half && (
      <div class="wrap banner__text">
        <h1 class="banner__title">{title}</h1>
        {line && <p class="banner__line">{line}</p>}
      </div>
    )
  }
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href="/" aria-label="Home">
          <svg viewBox="0 0 16 15" width="15" height="14" aria-hidden="true"><path d="M1 7.2 8 1.5l7 5.7M3 5.6V14h3.8V9.6h2.4V14H13V5.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
        </a>
      </li>
      {crumbs.slice(1).map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      <li aria-current="page">{title}</li>
    </ol>
  </nav>
</section>

<style>
  .banner {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: #111;
    color: #fff;
  }
  .banner__media {
    position: absolute;
    inset: 0;
  }
  .banner__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 0, #000 100%);
    opacity: 0.85;
  }

  /* `.text-wraper.bottomPos`: judul 110 px dari dasar, di atas remah. */
  .banner__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 110px;
    z-index: 1;
  }

  /* `.breadcrumb-wrapper`: menempel di dasar banner, padding 32 px; pemisah
     garis 3×1 px #c1c1c1, tautan 12 px bergaris bawah, ikon rumah 15 px. */
  .crumbs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding-block: 32px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    font-size: calc(12px * var(--fs));
    line-height: 1.2;
    color: var(--line);
  }
  .crumbs li {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .crumbs li:not(:last-child) { padding-right: 19px; }
  .crumbs li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 8px;
    top: 50%;
    width: 3px;
    height: 1px;
    background: var(--line);
  }
  .crumbs a {
    display: inline-flex;
    color: var(--line);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s;
  }
  .crumbs a:hover { color: #fff; }
  .crumbs li:first-child a { text-decoration: none; }
  .crumbs [aria-current] { color: #fff; }

  .banner__title {
    max-width: 900px;
    font-size: calc(clamp(32px, 3.06vw, 44px) * var(--fs));
    line-height: 1;
    font-weight: 530;
    color: #fff;
  }
  .banner__line {
    margin-top: 20px;
    max-width: 760px;
    font-size: calc(clamp(17px, 1.39vw, 20px) * var(--fs));
    line-height: 1.4;
    color: rgb(255 255 255 / 0.92);
  }

  .banner--half {
    height: 60vh;
    min-height: 380px;
  }

  @media (max-width: 1026px) {
    .banner { height: 72vh; }
    .banner--half { height: 45vh; min-height: 300px; }
    .banner__text { bottom: 84px; }
    .crumbs { padding-block: 24px; }
  }
</style>
