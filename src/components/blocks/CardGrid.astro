---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import type { LinkCard } from '../../data/pages/types';

/* Grid kartu tautan ala halaman daftar bisnis adani.com: foto dengan judul di
 * kiri bawahnya (garis putih + panah saat hover), naskah pendek dan
 * "Know More" di bawah foto. */

interface Props {
  title?: string;
  cards: LinkCard[];
  grey?: boolean;
  viewAll?: string;
}
const { title, cards, grey = false, viewAll } = Astro.props;
const cols = cards.length % 3 === 0 || cards.length > 4 ? 3 : 2;
---

<section class:list={['sec', { 'sec--grey': grey }]}>
  <div class="wrap">
    {
      title && (
        <div class="head-row">
          <h2 class="h2">{title}</h2>
          {viewAll && <a class="btn" href={viewAll}><span class="btn__label">View All</span></a>}
        </div>
      )
    }
    <ul class:list={['cards', `cards--${cols}`, { 'cards--flush': !title }]}>
      {
        cards.map((c, i) => (
          <li data-fx style={`--i:${i % 3}`}>
            <a class="card" href={c.href}>
              <span class="card__media cover shade">
                {c.image ? <Image quality={70} src={images[c.image]} alt="" widths={[480, 800, 1100]} sizes={cols === 3 ? '(max-width: 767px) 100vw, 30vw' : '(max-width: 767px) 100vw, 45vw'} loading="lazy" /> : <span class="plate">{c.caption}</span>}
                <span class="card__title">
                  {c.title}
                  <svg viewBox="0 0 18 12" width="17" height="11" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                </span>
              </span>
              <span class="card__body">{c.body}</span>
              <span class="card__more">{c.cta ?? 'Know More'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 40px 2.4%;
    margin-top: 48px;
  }
  .cards--flush { margin-top: 0; }
  .cards--3 { grid-template-columns: repeat(3, 1fr); }
  .cards--2 { grid-template-columns: repeat(2, 1fr); }

  .card { display: flex; flex-direction: column; height: 100%; }
  .card__media { display: block; aspect-ratio: 16 / 10; }
  .cards--2 .card__media { aspect-ratio: 16 / 9; }
  .card__media :global(img) { transition: transform 1s ease; }
  .card:hover .card__media :global(img) { transform: scale(1.08); }

  .card__title {
    position: absolute;
    z-index: 1;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(20px, 1.67vw, 24px);
    font-weight: 440;
    color: #fff;
  }
  .card__title svg { opacity: 0; transition: opacity 0.3s; }
  .card:hover .card__title svg { opacity: 1; }
  .card__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    height: 2px;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }
  .card:hover .card__title::after { transform: none; }

  .card__body {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
  }
  .card__more {
    margin-top: auto;
    padding-top: 16px;
    font-size: 16px;
    font-weight: 440;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .card:hover .card__more { color: var(--brand-green); }

  @media (max-width: 1026px) {
    .cards--3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .cards--3,
    .cards--2 { grid-template-columns: 1fr; }
  }
</style>
