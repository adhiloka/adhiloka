---
/**
 * Blok ajakan antar bagian, dalam bahasa visual valeindonesia.com: satu
 * kalimat teal besar, lalu tautan aksi teal berpanah emas. Dulu jeda editorial
 * berornamen (lebah, lalu tanda logo); ornamennya dicabut karena Vale tidak
 * memakai hiasan semacam itu.
 *
 * Aturan yang dipegang blok ini: satu bagian punya satu ajakan, dan ajakan itu
 * menuju versi yang lebih dalam dari apa yang baru saja dilihat. Tanpa `href`,
 * tautannya tidak dirender dan blok ini jadi label bagian.
 *
 * Gerak: kalimat naik dari bawah (gaya .animar Vale), tautannya menyusul.
 */
interface Props {
  /** Kalimat utuh dengan titik di ujungnya. */
  line?: string;
  /** Label kecil sebagai ganti kalimat, untuk pembuka bagian. */
  eyebrow?: string;
  /** Tanpa ini, tautannya tidak muncul sama sekali. */
  href?: string;
  cta?: string;
  /** Nama lama; ornamen tidak lagi dirender. */
  mark?: boolean;
  /** Nama lama; Mukta tidak punya italic, kalimat selalu tegak. */
  italic?: boolean;
  /** Jarak kalimat–tautan dipersempit. */
  tight?: boolean;
  class?: string;
}

const { line, eyebrow, href, cta = 'Discover more', tight = false, class: className } = Astro.props;
---

<div class:list={['interlude', tight && 'is-tight', className]} data-interlude>
  {eyebrow && <span class="eyebrow interlude__eyebrow">{eyebrow}</span>}
  {line && <p class="interlude__line">{line}</p>}
  {href && <a class="interlude__cta action-link" href={href}>{cta}</a>}
</div>

<style>
  .interlude {
    /* width:100% wajib: tanpa itu `margin-inline: auto` dari .frame
       membatalkan peregangan saat blok ini jadi anak flex. */
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(18px, 2vw, 28px);
  }
  .interlude.is-tight { gap: clamp(10px, 1.2vw, 16px); }

  .interlude__eyebrow,
  .interlude__line,
  .interlude__cta {
    opacity: 0;
    transform: translateY(40px);
    transition:
      transform 750ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 300ms,
      opacity 550ms linear 300ms;
  }
  .interlude__cta { transition-delay: 550ms, 550ms; }
  .interlude.is-revealed :is(.interlude__eyebrow, .interlude__line, .interlude__cta) {
    opacity: 1;
    transform: none;
  }

  .interlude__line {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 500;
    line-height: var(--leading-title);
    color: var(--teal);
    max-width: 22em;
    text-wrap: balance;
  }

  .interlude__cta { font-size: clamp(17px, 1.2vw, 20px); }

  @media (prefers-reduced-motion: reduce) {
    .interlude__eyebrow,
    .interlude__line,
    .interlude__cta {
      opacity: 1;
      transform: none;
    }
  }
</style>
