---
import { NAV } from '../data/site';

/**
 * Jejak dua tingkat: bagian induk, lalu halaman ini. Induknya dicari dari NAV
 * lewat `section`, jadi tidak ada label yang perlu ditulis dua kali.
 */
interface Props {
  section: string;
  current: string;
}

const { section, current } = Astro.props;
const parent = NAV.find((item) => item.href === section);
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Adhiloka</a></li>
    {
      parent && (
        <li>
          <a href={parent.href}>{parent.label}</a>
        </li>
      )
    }
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--type-micro);
    font-weight: 400;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Pemisahnya dibuat dari CSS, bukan diketik ke markup: pembaca layar tidak
     perlu mendengar "garis miring" di antara tiap tingkat. */
  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    opacity: 0.5;
  }

  .crumbs a { transition: color var(--dur-fast) ease; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs [aria-current='page'] { color: var(--ink); }
</style>
